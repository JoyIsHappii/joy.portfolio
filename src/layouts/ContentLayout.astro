---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import NavBar from "../components/NavBar.astro";
import "aos/dist/aos.css";


interface Props {
  title?: string;
  active?: "home" | "projects" | "about";
}
const { title = "Joy — Portfolio", active } = Astro.props as Props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <ClientRouter />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Baskervville:ital,wght@0,400..700;1,400..700&family=Cutive+Mono&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body class="main-bg min-h-screen flex flex-col items-center justify-center px-0 md:px-20">
    <!--
      Content pages (About, Projects) are long-form and scroll — unlike the
      illustrated homepage "room" scene, they should not be centered or sit
      on top of a dimmed decorative background image.
    -->
    <div class="w-full min-h-screen flex flex-col items-stretch">
     
      <NavBar active={active} />
      <div class="w-full flex-1">
        <slot />
      </div>
    </div>
  </body>
</html>

<script type="module">
  import AOS from "aos";

  document.addEventListener("astro:page-load", () => {
    AOS.init({
      duration: 800,
      once: true,
    });
  });
</script>
