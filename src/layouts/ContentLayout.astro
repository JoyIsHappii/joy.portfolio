---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import NavBar from "../components/NavBar.astro";
import "aos/dist/aos.css";


interface Props {
  title?: string;
  active?: "home" | "projects" | "about";
}
const { title = "Joy — Portfolio", active } = Astro.props as Props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <ClientRouter />

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Serif:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300..700&display=swap" rel="stylesheet">

    <title>{title}</title>
  </head>
  <body class="main-bg min-h-screen flex flex-col items-center justify-center px-20">
    <div class="w-full min-h-screen flex flex-col items-stretch">
     
      <NavBar active={active} />
      <div class="w-full flex-1">
        <slot />
      </div>
    </div>
  </body>
</html>

<script type="module">
  import AOS from "aos";

  document.addEventListener("astro:page-load", () => {
    AOS.init({
      duration: 800,
      once: true,
    });
  });
</script>
