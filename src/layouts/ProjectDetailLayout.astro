---
import "../styles/global.css";
import NavBar from "../components/NavBar.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  active?: "home" | "projects" | "about";
}
const { title = "Project — Joy", active = "projects" } = Astro.props as Props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <ClientRouter />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300..700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-ivory">
    <div
      class="mx-auto flex min-h-screen w-full max-w-[1600px] flex-col px-4 sm:px-6 lg:px-10 xl:px-16"
    >
      <NavBar active={active} />
      <div class="w-full flex-1 pb-20">
        <slot />
      </div>
    </div>
  </body>
</html>
