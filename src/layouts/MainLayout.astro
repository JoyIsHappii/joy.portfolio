---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import "aos/dist/aos.css";

const { title = "Portfolio" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <ClientRouter />

    <link
      href="https://unpkg.com/aos@2.3.1/dist/aos.css"
      rel="stylesheet"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Baskervville:ital,wght@0,400..700;1,400..700&family=Cutive+Mono&family=Inter:ital,opsz,wght@0,14..32,100..900;1,400..700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>

  <body>
    <main class="main-bg min-h-screen flex flex-col items-center justify-center">
      <slot />
    </main>
  </body>
</html>

<script>
  import AOS from "aos";

  document.addEventListener("astro:page-load", () => {
    AOS.init({
      duration: 800,
      once: true,
    });
  });
</script>