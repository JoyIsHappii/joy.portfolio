---
import Button from "../components/Button.astro";
import ImageResume from "../assets/resume.webp";
import PortraitImage from "../assets/joy.png";
---

<section
  id="about-me"
  class="group w-full border-y border-brown-dark/10 bg-brown-light/10 px-4
    py-4 sm:px-6 md:px-12 lg:px-16
    hover:border-brown-dark/20
  hover:bg-brown-light/20 transition-all duration-300 ease-in-out"
>
  <div
    class="mx-auto flex max-w-6xl flex-col items-center gap-10
           md:flex-row md:items-center md:gap-14 lg:gap-20"
  >
    <!-- Resume Preview -->
    <div class="w-full md:w-[55%]">
      <div class="mx-auto w-full max-w-[560px] overflow-hidden rounded-xl">
        <img
          src={ImageResume.src}
          alt="Preview of Joy's interactive resume"
          class="h-full
        w-full
        object-contain
        transition-transform
        duration-300
        ease-in-out
        group-hover:scale-[1.03]"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <!-- Content -->
    <div
      class="flex w-full max-w-md flex-col items-center text-center
             md:w-[45%] md:items-start md:text-left"
    >
      <!-- Label -->
      <div class="flex items-center gap-3">
        <img
          src={PortraitImage.src}
          alt="Portrait of Joy"
          class="h-11 w-11 rounded-full object-cover"
        />

        <p
          class="text-sm font-semibold uppercase tracking-[0.18em]
                 text-dark-brown sm:text-base"
        >
          About Me
        </p>
      </div>

      <!-- Heading -->
      <!-- <h2
        class="mt-5 text-3xl leading-tight text-dark-brown
               sm:text-4xl md:text-[2.6rem]"
      >
        More than a resume
      </h2> -->

      <!-- Description -->
      <!-- <p
        class="mt-4 max-w-sm text-sm leading-7 text-brown-dark/75
               sm:text-base"
      >
        I started in architecture, moved into UX/UI design, and am now exploring
        the world of web development. Take a look at my interactive resume to
        see the journey.
      </p> -->

      <!-- CTA -->
      <!-- <Button
        href="https://interactive-resume-joy.vercel.app"
        target="_blank"
        rel="noopener noreferrer"
        variant="primary"
        size="md"
        class="mt-7"
      >
        Explore My Story 
      </Button> -->
    </div>
  </div>
</section>
