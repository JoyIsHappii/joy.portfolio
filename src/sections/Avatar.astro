<style>
  .avatar-img {
    image-rendering: pixelated;
    animation: avatar-bob 0.8s steps(1, end) infinite;
  }

  .avatar-walker {
    animation: avatar-walk 14s steps(56, end) infinite;
  }

  .avatar-bubble {
    animation: bubble-float 2s steps(2, jump-none) infinite alternate;
  }

  .avatar-heart {
    left: 55%;
    top: 45%;
    opacity: 0;
  }

  /* On hover she stops walking, hops, and a heart floats up */
  .avatar-card:hover .avatar-walker {
    animation-play-state: paused;
  }

  .avatar-card:hover .avatar-img {
    animation: avatar-hop 0.5s steps(1, end) infinite;
  }

  .avatar-card:hover .avatar-heart {
    animation: heart-rise 1s steps(5, end) infinite;
  }

  .avatar-card:focus-visible {
    outline: 2px solid var(--color-brown-dark);
    outline-offset: 4px;
  }

  /* Walk right, then back, always facing forward (left side only, the cat sleeps on the right) */
  @keyframes avatar-walk {
    0%,
    100% {
      transform: translateX(-60px);
    }
    50% {
      transform: translateX(0);
    }
  }

  /* The cat breathing in its sleep (same as the interactive resume) */
  .cat-breathe {
    animation: cat-breathe 3s steps(1) infinite;
    transform-box: fill-box;
    transform-origin: bottom;
  }

  @keyframes cat-breathe {
    0%,
    100% {
      transform: scaleY(1);
    }
    50% {
      transform: scaleY(1.06);
    }
  }

  @keyframes avatar-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-3px);
    }
  }

  @keyframes avatar-hop {
    0%,
    100% {
      transform: translateY(0);
    }
    25% {
      transform: translateY(-8px);
    }
    50% {
      transform: translateY(-12px);
    }
    75% {
      transform: translateY(-6px);
    }
  }

  @keyframes bubble-float {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-3px);
    }
  }

  @keyframes heart-rise {
    from {
      opacity: 1;
      transform: translateY(0);
    }
    to {
      opacity: 0;
      transform: translateY(-36px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .avatar-img,
    .avatar-walker,
    .avatar-bubble,
    .cat-breathe,
    .avatar-card:hover .avatar-img,
    .avatar-card:hover .avatar-heart {
      animation: none;
    }
  }

  @keyframes catBreathe {
    0%,
    100% {
      transform: scaleY(1);
    }
    50% {
      transform: scaleY(1.06);
    }
  }
  .cat-breathe {
    animation: catBreathe 3s steps(1) infinite;
    transform-box: fill-box;
    transform-origin: bottom;
  }
</style>
