---
// Pixel avatar under the project filter (large screens only).
// She walks side to side (no flipping), says hi, and links to the interactive resume.
// steps() keeps the motion choppy like a pixel game.
import PixelAvatar from "../assets/avatar-pixel.png";

// The sleeping calico cat from the interactive resume (same pixel map and colours).
// One letter per pixel; "." is see-through.
// prettier-ignore
const CAT = [
  "..............O...O...",
  ".............OGO.OGO..",
  "......OOOOOOOOGGOGGGO.",
  "....OOWWWWWWWGGGGGGGGO",
  "...OWWWWBBWWWWWGOGGOGO",
  "..OWWWWBBBWWWWWGGGGGPO",
  ".OWWWWWWWWWWWWWWWWWWO.",
  "OGGOWWWWWWWWWWWWWWWO..",
  "OGGOOOOOOOOOOOOOOOO...",
  ".OO...................",
];
const CAT_COLORS: Record<string, string> = {
  O: "#3b2a2a", // outline
  W: "#fffaf0", // white
  G: "#f08a4b", // orange
  B: "#6b4a3a", // brown patch
  P: "#f5a3b5", // pink nose
};
// Merge runs of the same colour on each row into one rectangle
const catRects = CAT.flatMap((row, y) => {
  const rects: { x: number; y: number; w: number; fill: string }[] = [];
  let start = 0;
  for (let i = 1; i <= row.length; i++) {
    if (i < row.length && row[i] === row[start]) continue;
    const fill = CAT_COLORS[row[start]];
    if (fill) rects.push({ x: start, y, w: i - start, fill });
    start = i;
  }
  return rects;
});
---

<a
  href="https://interactive-resume-joy.vercel.app"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Hi! Click to see Joy's story in her interactive resume (opens in a new tab)"
  class="avatar-card relative mt-6 hidden lg:mt-auto w-full flex-col items-center overflow-hidden pt-16 lg:flex border-b-2 border-[#6b4a3a]"
>
  <!-- Speech bubble -->
  <span class="absolute inset-x-0 top-2 flex justify-center">
    <span class="avatar-bubble relative border border-brown-dark/25 bg-white px-3 py-1.5 text-center text-sm font-medium leading-snug text-brown-dark">
      Hi! Click to explore my journey ➹
      <span
        class="absolute -bottom-[5px] left-1/2 h-2.5 w-2.5 -translate-x-1/2 rotate-45 border-b border-r border-brown-dark/25 bg-white"
        aria-hidden="true"
      ></span>
    </span>
  </span>

  <span class="avatar-heart absolute text-lg text-pink" aria-hidden="true">
    ♥
  </span>

  <!-- Walker moves side to side; the image inside bobs -->
  <span class="avatar-walker block">
    <img
      src={PixelAvatar.src}
      alt=""
      width="500"
      height="500"
      class="avatar-img block h-32 w-32 [@media(max-height:860px)]:h-24 [@media(max-height:860px)]:w-24"
    />
  </span>

  <!-- Sleeping cat in the corner -->
  <svg
    viewBox="0 0 22 10"
    width="66"
    height="30"
    shape-rendering="crispEdges"
    class="absolute bottom-1 right-2 z-20"
    aria-hidden="true"
  >
    <g class="cat-breathe">
      {catRects.map((r) => (
        <rect x={r.x} y={r.y} width={r.w} height="1" fill={r.fill} />
      ))}
    </g>
  </svg>
  <g transform="translate(248 96)">
    <g class="cat-breathe">
      <rect x="14" y="0" width="1" height="1" fill="#3b2a2a"></rect>
      <rect x="18" y="0" width="1" height="1" fill="#3b2a2a"></rect>
      <rect x="13" y="1" width="1" height="1" fill="#3b2a2a"></rect>
      <rect x="14" y="1" width="1" height="1" fill="#f08a4b"></rect>
      <rect x="15" y="1" width="1" height="1" fill="#3b2a2a"></rect>
      <rect x="17" y="1" width="1" height="1" fill="#3b2a2a"></rect>
      <rect x="18" y="1" width="1" height="1" fill="#f08a4b"></rect>
      <rect x="19" y="1" width="1" height="1" fill="#3b2a2a"></rect>
      <rect x="6" y="2" width="8" height="1" fill="#3b2a2a"></rect>
      <rect x="14" y="2" width="2" height="1" fill="#f08a4b"></rect>
      <rect x="16" y="2" width="1" height="1" fill="#3b2a2a"></rect>
      <rect x="17" y="2" width="3" height="1" fill="#f08a4b"></rect>
