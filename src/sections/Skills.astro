---
// Import skill icons
import Ai from "../assets/skills/ai.svg";
import Figma from "../assets/skills/figma.svg";
import Html from "../assets/skills/html.svg";
import Css from "../assets/skills/css.svg";
import Js from "../assets/skills/js.svg";
import AstroIcon from "../assets/skills/astro.svg";
import Tailwind from "../assets/skills/tailwind.svg";
import Canva from "../assets/skills/canva.svg";
import GitHub from "../assets/skills/github.svg";
import PSD from "../assets/skills/psd.svg";
import SCSS from "../assets/skills/scss.svg";

interface Props {
  class?: string;
}

const {
  class: className = "",
} = Astro.props as Props;

const icons = [
  { icon: Ai, name: "Adobe Illustrator" },
  { icon: Figma, name: "Figma" },
  { icon: Html, name: "HTML" },
  { icon: Css, name: "CSS" },
  { icon: Js, name: "JavaScript" },
  { icon: AstroIcon, name: "Astro" },
  { icon: Tailwind, name: "Tailwind CSS" },
  { icon: Canva, name: "Canva" },
  { icon: GitHub, name: "GitHub" },
  { icon: PSD, name: "Adobe Photoshop" },
  { icon: SCSS, name: "SCSS" },
];
---

<!-- Skills marquee -->
<section
  aria-label="Design and development skills"
  class:list={[
    `
      marquee-container
      w-full
      overflow-hidden
      py-6
    `,
    className,
  ]}
>
  <div class="slide-skills flex w-max">
    <!-- First set -->
    <div
      class="
        flex
        shrink-0
        items-center
        gap-8
        pr-8
      "
    >
      {
        icons.map(({ icon: Icon, name }) => (
          <div
            class="
              flex
              h-14
              w-14
              shrink-0
              items-center
              justify-center
            "
            title={name}
          >
            <Icon
              aria-label={name}
              class="
                h-11
                w-11
                object-contain
              "
            />
          </div>
        ))
      }
    </div>

    <!-- Duplicate set for the infinite loop -->
    <div
      aria-hidden="true"
      class="
        flex
        shrink-0
        items-center
        gap-8
        pr-8
      "
    >
      {
        icons.map(({ icon: Icon }) => (
          <div
            class="
              flex
              h-14
              w-14
              shrink-0
              items-center
              justify-center
            "
          >
            <Icon
              class="
                h-11
                w-11
                object-contain
              "
            />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .slide-skills {
    animation: skills-marquee 24s linear infinite;
    will-change: transform;
  }

  .marquee-container:hover .slide-skills {
    animation-play-state: paused;
  }

  @keyframes skills-marquee {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .slide-skills {
      animation: none;
    }

    .marquee-container {
      overflow-x: auto;
    }
  }
</style>