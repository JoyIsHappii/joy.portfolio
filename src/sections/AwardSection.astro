---
import Button from "../components/Button.astro";
import AwardImage from "../assets/award-image.svg";
import Tag from "../components/Tag.astro";
---

<!-- Award Project Section -->
<section
  class="flex flex-col lg:flex-row items-center max-w-[1280px]
  justify-center gap-12 md:px-12 w-full
  bg-black/80 backdrop-blur-[4px] border
   border-white/40 rounded-[40px] py-12 lg:py-16"
>
  <div class="w-full flex items-center justify-center order-2 lg:order-1">
    <img
      src={AwardImage.src}
      alt="Award Project"
      class="w-full h-full object-contain"
    />
  </div>

  <div class="flex flex-col full gap-4 order-1 lg:order-2">
    <p
      class="text-sm md:text-lg lg:text-xl
        font-normal
        text-white
        bg-black
        px-4
        py-2
        rounded-lg
        w-fit"
    >
      ⭐ AWARDED PROJECT
    </p>

    <h1
      class="text-4xl md:text-5xl lg:text-6xl
        font-normal
        tracking-tight
        text-white"
    >
      7VAN Website
    </h1>
    <Tag category="UX/UI Design" class="mt-2" />

    <p class="text-lg text-white font-normal mt-4">
      A community platform built to empower connections and protect lives —
      designed end-to-end from brand identity to a booking flow members actually
      enjoy using.
    </p>
    <Button variant="primary" href="/projects/7van" class="w-fit mt-2"
      >Explore →</Button
    >
  </div>
</section>
