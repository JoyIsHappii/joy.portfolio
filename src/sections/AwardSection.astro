---
import Button from "../components/Button.astro";
import AwardImage from "../assets/award-image.svg";
import Tag from "../components/Tag.astro";

type ProjectCategory =
  "UX Design" | "UI Design" | "Web Development" | "Project Design";

const categories: ProjectCategory[] = ["UX Design", "UI Design"];
---

<!-- Award Project Section -->
<section
  data-project-item
  data-category={categories.join(",")}
  class="group
    flex
    w-full
    flex-col
    items-center
    justify-center
    gap-12
    border
    border-brown-dark/20
    bg-transparent
    px-4
    py-4
    backdrop-blur-[4px]
    transition-all
    duration-300
    ease-in-out
    hover:scale-[1.02]
    hover:border-brown-dark/20
hover:bg-brown-medium/50 md:px-12
    lg:flex-row
    lg:py-8"
>
  <!-- Award Image -->
  <div
    class="order-2
      flex
      w-full
      items-center
      justify-center
      lg:order-1"
  >
    <img
      src={AwardImage.src}
      alt="7VAN Best UI/UX Project Award"
      class="h-full
        w-full
        object-contain
        transition-transform
        duration-300
        ease-in-out
        group-hover:scale-[1.03]"
    />
  </div>

  <!-- Award Content -->
  <div
    class="order-1
      flex
      w-full
      flex-col
      gap-4
      lg:order-2"
  >
    <h2
      class="w-full
        text-start
        text-2xl
        font-normal
        tracking-tight
        text-brown-dark
        transition-colors
        duration-300
        ease-in-out
        md:text-4xl
        lg:text-5xl"
    >
      Best UI/UX Project Award
    </h2>

    <!-- Categories -->
    <div class="flex flex-wrap gap-2">
      {categories.map((category) => <Tag category={category} />)}
    </div>

    <!-- Description -->
    <p
      class="text-lg
        font-normal
        text-brown-dark
        transition-colors
        duration-300
        ease-in-out"
    >
      <b>7VAN</b> is a website created for the owner of a Brazilian Jiu-Jitsu academy
      in Vancouver.

      <br />

      The project received the <b>Best UI/UX Project Award</b>, selected by the
      client and industry professionals.
    </p>

    <!-- Buttons -->
    <div class="flex flex-row flex-wrap gap-4">
      <Button variant="primary" href="/projects/7van" class="mt-2 w-fit">
        Explore 7VAN
      </Button>

      <Button
        variant="secondary"
        href="https://www.linkedin.com/in/joykosol/overlay/Honor/1611570364/treasury/?profileId=ACoAADSR_EYB15BA-sikDGbsuVcKbwE3hPBNMYc"
        class="mt-2 w-fit"
      >
        View Certificate
      </Button>
    </div>
  </div>
</section>
