---
import Button from "../components/Button.astro";
import AwardImage from "../assets/award-image.svg";
import Tag from "../components/Tag.astro";
---

<!-- Award Project Section -->
<section
  class="flex flex-col lg:flex-row items-center max-w-[1280px]
  justify-center gap-12 md:px-12 w-full
  bg-black/70 backdrop-blur-[4px] border
   border-brown-dark/40 rounded-[40px] py-12 lg:py-16"
>
  <div class="w-full flex items-center justify-center order-2 lg:order-1">
    <img
      src={AwardImage.src}
      alt="Award Project"
      class="w-full h-full object-contain"
    />
  </div>

  <div class="w-full flex flex-col gap-4 order-1 lg:order-2">
    <p
      class="text-sm md:text-lg lg:text-xl
        font-normal
        text-white
        bg-black
        px-4
        py-2
        rounded-lg
        w-fit"
    >
      ⭐ Awarded-Winning Project
    </p>

    <h1
      class="text-4xl md:text-5xl lg:text-6xl
        font-normal
        tracking-tight
        text-white
        ibm-plex-serif-medium-italic
        text-start
        w-full"
    >
      Best UI/UX Project Award
    </h1>
    <!-- <Tag category="UX/UI Design" class="mt-2" /> -->

    <p class="text-lg text-white font-normal">
      <b>7VAN</b> is a website created for the client, the owner of a Brazilian Jiu-Jitsu academy
      in Vancouver. 
      <br>
      The project received the <b>Best UI/UX Project Award</b>,
      selected by the client and industry professionals.
    </p>

    <div class="flex flex-row gap-4">
      <Button variant="primary" href="/projects/7van" class="w-fit mt-2 "
        >Explore</Button
      >
      <Button
        variant="secondary"
        href="https://www.linkedin.com/in/joykosol/overlay/Honor/1611570364/treasury/?profileId=ACoAADSR_EYB15BA-sikDGbsuVcKbwE3hPBNMYc"
        class="w-fit mt-2">View certificate</Button
      >
    </div>
  </div>
</section>
