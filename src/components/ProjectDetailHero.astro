---

import Tag from "./Tag.astro";
import Button from "./Button.astro";

interface ProjectDetailHeroProps {
  title: string;
  description: string;
  imageSrc: string;
  imageAlt: string;
  category: "all" | "UX/UI Design" | "Web Development" | "Project Design";
  projectLink: string;
  class?: string;
}

const { title, description, imageSrc, imageAlt, category, projectLink, class: className } = Astro.props as ProjectDetailHeroProps;


---

<div class="flex flex-row gap-4 w-full {className}"
data-aos="fade-up"
data-aos-duration="2000"
data-aos-delay="200"
>
  <img src={imageSrc} alt={imageAlt} class="w-full h-auto" />
  <div class="p-4 flex flex-col gap-2">
    <h3 class="text-2xl font-semibold">{title}</h3>
    <Tag category={category} />
    <p class="text-gray-dark">{description}</p>
    <Button href={projectLink} variant="primary" size="md" class="mt-4">View Project</Button>
  </div>
</div>  