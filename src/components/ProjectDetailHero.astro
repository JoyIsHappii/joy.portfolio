---
import Tag, {
  type ProjectCategory,
} from "./Tag.astro";
import Button from "./Button.astro";

interface ProjectDetailHeroProps {
  title: string;
  eyebrow?: string;
  description: string;
  imageSrc: string;
  imageAlt: string;
  categories: ProjectCategory[];
  desktopLink?: string;
  mobileLink?: string;
  prototypeLink?: string;
  class?: string;
  role?: string;
}

const {
  title,
  eyebrow = "Selected Case Study",
  description,
  imageSrc,
  imageAlt,
  categories,
  desktopLink,
  mobileLink,
  prototypeLink,
  role,
  class: className = "",
} = Astro.props as ProjectDetailHeroProps;
---

<div
  class:list={[
    `
      grid
      w-full
      grid-cols-1
      gap-8
      
      md:grid-cols-12
      pb-8
      
   
    `,
    className,
  ]}
>
  <!-- Project information -->
  <div
    class="
      order-2
      flex
      flex-col
      items-start
      md:order-1
      md:col-span-6
    "
  >
    <p
      class="
        text-xs
        font-semibold
        uppercase
        tracking-[0.18em]
        text-green-dark
      "
    >
      {eyebrow}
    </p>
       <div class="mt-6 flex flex-wrap gap-2">
      {
        categories.map((category) => (
          <Tag category={category} />
        ))
      }
    </div>

    <h1
      class="
        mt-3
        max-w-xl
        text-5xl
        font-normal
        leading-[0.95]
        tracking-[-0.04em]
        text-brown-dark
        sm:text-6xl
        lg:text-7xl
      "
    >
      {title}
    </h1>

    {
      role && (
        <p
          class="
            mt-5
            text-sm
            font-semibold
            text-brown-dark
            bg-green-light/50
            px-3
            py-1
            rounded-lg
            sm:text-base
          "
        >
         <b>{role}</b>
        </p>
      )
    }

    <p
      class="
        mt-5
        max-w-xl
        text-sm
        leading-7
        text-brown-dark/75
        sm:text-base
      "
    >
      {description}
    </p>

 <div class="mt-5 flex flex-row flex-wrap gap-4">

  {desktopLink && (
        <Button
          href={desktopLink}
          variant="primary"
          size="md"
          class="mt-7"
        >
          Desktop prototype
        </Button>
      )
      }

      {mobileLink && (
        <Button
          href={mobileLink}
          variant="secondary"
          size="md"
          class="mt-7"
        >
          Mobile prototype
        </Button>
      )
      }
      {prototypeLink && (
        <Button
          href={prototypeLink}
          variant="primary"
          size="md"
          class="mt-7"
        >
          View prototype
        </Button>
      )
      }
      </div>
  </div>

  <!-- Project image -->
  <div
    class="
      order-1
      flex
      h-[240px]
      items-center
      justify-center
      overflow-hidden
      bg-green-light/50
      p-5
      sm:h-[280px]
      sm:p-7
      md:order-2
      md:col-span-6
      md:h-[360px]
      lg:h-[400px]
      lg:p-9
      
    "
  >
    <img
      src={imageSrc}
      alt={imageAlt}
      class="
        h-full
        w-full
        object-contain
        scale-120
      "
    />
  </div>
</div>