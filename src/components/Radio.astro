---
import RadioArtwork from "../assets/room-elements/radio.svg";

// Opens the site-wide Spotify player (SpotifyPlayer.astro) centered over the radio.
const { class: className = "" } = Astro.props;
---

<button
  type="button"
  class:list={[
    "radio-player cursor-pointer rounded-lg transition-transform duration-200 hover:scale-105 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brown-dark",
    className,
  ]}
  aria-label="Show Spotify player"
  aria-expanded="false"
  aria-controls="spotify-player"
  data-music-toggle
  data-music-trigger
  data-music-placement="over"
>
  <img
    src={RadioArtwork.src}
    alt=""
    class="music-artwork h-full w-full object-contain"
  />
</button>
