---
interface ProjectOverviewProps {
  duration: string;
  role: string;
  responsibilities: string[];
  challenges: string[];
  solutions: string[];
}

const { duration, role, responsibilities, challenges, solutions } = Astro.props as ProjectOverviewProps;


---
<div class="grid grid-cols-12"
  data-aos="fade-up"
  data-aos-duration="2000"
  data-aos-delay="200"
>
<h2 class="text-2xl font-semibold mb-4 col-span-12">Project Overview</h2>
  <div class="col-span-4">
    <p><strong>Duration:</strong> {duration}</p>
    <p><strong>Role:</strong> {role}</p>
    <p><strong>Responsibilities:</strong></p>
    <ul class="list-disc list-inside">
      {responsibilities.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </div>
  <div class="col-span-4">
    <p><strong>Challenges:</strong></p>
    <ul class="list-disc list-inside">
      {challenges.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </div>
  <div class="col-span-4">
    <p><strong>Solutions:</strong></p>
    <ul class="list-disc list-inside">
      {solutions.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </div>
</div>