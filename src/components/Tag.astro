---
interface TagProps {
  category: "all" | "UX/UI Design" | "Web Development" | "Project Design";
  class?: string;
}

const {
  category,
  class: className = "",
} = Astro.props as TagProps;

const categoryColors = {
  "UX/UI Design": "bg-blue-100 text-blue-800",
  "Web Development": "bg-green-100 text-green-800",
  "Project Design": "bg-purple-100 text-purple-800",
  all: "bg-gray-200 text-gray-800",
};

const colorClass = categoryColors[category];
---

<span
  class:list={[
    "inline-flex items-center w-fit px-4 py-2 rounded-full text-sm font-medium",
    colorClass,
    className,
  ]}
>
  {category}
</span>