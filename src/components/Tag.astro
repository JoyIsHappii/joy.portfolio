---
export type ProjectCategory =
  | "UX Design"
  | "UI Design"
  | "Web Development"
  | "Project Design";

interface TagProps {
  category: ProjectCategory;
  class?: string;
}

const {
  category,
  class: className = "",
} = Astro.props as TagProps;

const categoryColors: Record<ProjectCategory, string> = {
  "UX Design": "bg-blue-100 text-blue-800",
  "UI Design": "bg-yellow-100 text-yellow-800",
  "Web Development": "bg-green-100 text-green-800",
  "Project Design": "bg-purple-100 text-purple-800",
};

const colorClass = categoryColors[category];
---

<span
  class:list={[
    "inline-flex w-fit items-center rounded-lg px-2 py-2 text-xs font-medium",
    colorClass,
    className,
  ]}
>
  {category}
</span>