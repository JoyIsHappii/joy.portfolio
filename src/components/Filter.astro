---
type Category = "all" | "UX/UI Design" | "Web Development" | "Project Design";

interface FilterProps { selectedCategory?: Category; }
const { selectedCategory = "all" } = Astro.props as FilterProps;

const categories: { value: Category; label: string }[] = [
{value: "all", label: "All"},
{value: "UX/UI Design", label: "UX/UI Design"},
{value: "Web Development", label: "Web Development"},
{value: "Project Design", label: "Project Design"},
];
const categoryClasses: Record<Category, string> = {
  all: "bg-gray-200 text-gray-800 rounded-full px-4 py-2 hover:bg-gray-300 hover:text-gray-900",
  "UX/UI Design": "bg-blue-100 text-blue-800 rounded-full px-4 py-2 hover:bg-blue-200 hover:text-blue-900",
  "Web Development": "bg-green-100 text-green-800 rounded-full px-4 py-2 hover:bg-green-200 hover:text-green-900",
  "Project Design": "bg-purple-100 text-purple-800 rounded-full px-4 py-2 hover:bg-purple-200 hover:text-purple-900",
};
---

<div
  data-project-filter
  data-selected-category={selectedCategory}
  class="w-full flex flex-row items-center justify-center gap-4 flex-wrap"
>
  {categories.map((category) => (
    <button
      type="button"
      data-filter-category={category.value}
      aria-pressed={category.value === selectedCategory}
      class={`${categoryClasses[category.value]}`}
    >
      {category.label}
    </button>
  ))}
</div>

<script>
  function setupProjectFilter() {
    const filterRoot = document.querySelector<HTMLElement>("[data-project-filter]");
    if (!filterRoot || filterRoot.dataset.ready === "true") return;
    filterRoot.dataset.ready = "true";

    const buttons = Array.from(filterRoot.querySelectorAll<HTMLButtonElement>("[data-filter-category]"));
    const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-project-card]"));

    const selectCategory = (category: string) => {
      buttons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.filterCategory === category)));
      cards.forEach((card) => {
        const show = category === "all" || card.dataset.category === category;
        card.hidden = !show;
      });
    };

    buttons.forEach((button) => button.addEventListener("click", () => selectCategory(button.dataset.filterCategory ?? "all")));
    selectCategory(filterRoot.dataset.selectedCategory ?? "all");
  }

  setupProjectFilter();
  document.addEventListener("astro:page-load", setupProjectFilter);
</script>
