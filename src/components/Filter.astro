---
type Category =
  | "all"
  | "UX/UI Design"
  | "Web Development"
  | "Project Design";

interface FilterProps {
  selectedCategory?: Category;
}

const { selectedCategory = "all" } = Astro.props as FilterProps;

const categories: Category[] = [
  "all",
  "UX/UI Design",
  "Web Development",
  "Project Design",
];

const categoryColors: Record<Category, string> = {
  "UX/UI Design": "bg-blue-100 text-blue-800",
  "Web Development": "bg-green-100 text-green-800",
  "Project Design": "bg-purple-100 text-purple-800",
  all: "bg-gray-200 text-gray-800",
};

const inactiveClasses =
  "bg-white text-gray-600 hover:bg-gray-100";

const baseClasses =
  "inline-flex items-center w-fit px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 cursor-pointer";
---

<div
  class="flex flex-row flex-wrap gap-2"
  data-project-filter
  data-selected-category={selectedCategory}
>
  {
    categories.map((category) => {
      const isSelected = selectedCategory === category;

      return (
        <button
          type="button"
          data-filter-category={category}
          aria-pressed={isSelected}
          data-active-classes={categoryColors[category]}
          class:list={[
            baseClasses,
            isSelected
              ? categoryColors[category]
              : inactiveClasses,
          ]}
        >
          {category === "all" ? "All" : category}
        </button>
      );
    })
  }
</div>

<script>
  function setupProjectFilter() {
    const filterRoot =
      document.querySelector<HTMLElement>("[data-project-filter]");

    if (!filterRoot) return;

    const buttons = Array.from(
      filterRoot.querySelectorAll<HTMLButtonElement>(
        "[data-filter-category]"
      )
    );

    const cards = Array.from(
      document.querySelectorAll<HTMLElement>(
        "[data-project-card]"
      )
    );

    const colorClasses = [
      "bg-blue-100",
      "text-blue-800",
      "bg-green-100",
      "text-green-800",
      "bg-purple-100",
      "text-purple-800",
      "bg-gray-200",
      "text-gray-800",
    ];

    const setActiveCategory = (category: string) => {
      buttons.forEach((button) => {
        const isActive =
          button.dataset.filterCategory === category;

        button.setAttribute(
          "aria-pressed",
          String(isActive)
        );

        // Remove all possible category colors
        button.classList.remove(...colorClasses);

        if (isActive) {
          const activeClasses =
            button.dataset.activeClasses?.split(" ") ?? [];

          button.classList.remove(
            "bg-white",
            "text-gray-600",
            "hover:bg-gray-100"
          );

          button.classList.add(...activeClasses);
        } else {
          button.classList.add(
            "bg-white",
            "text-gray-600",
            "hover:bg-gray-100"
          );
        }
      });

      cards.forEach((card) => {
        const cardCategory =
          card.dataset.category;

        const shouldShow =
          category === "all" ||
          cardCategory === category;

        card.classList.toggle(
          "hidden",
          !shouldShow
        );
      });
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        setActiveCategory(
          button.dataset.filterCategory ?? "all"
        );
      });
    });

    setActiveCategory(
      filterRoot.dataset.selectedCategory ?? "all"
    );
  }

  setupProjectFilter();

  document.addEventListener(
    "astro:page-load",
    setupProjectFilter
  );
</script>