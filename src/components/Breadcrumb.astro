---

interface BreadcrumbProps {
  items: { label: string; href: string }[];
}


const { items } = Astro.props as BreadcrumbProps;
---

<a
  href={items[0].href}
  class="text-gray-dark hover:text-gray-dark font-medium text-sm"
>
  {items[0].label}
</a>
{items.slice(1).map((item, index) => (
  <span key={index} class="text-gray-dark font-medium text-sm">
    &nbsp;/&nbsp;
    <a href={item.href} class="text-gray-dark hover:text-gray-dark font-medium text-sm">
      {item.label}
    </a>
  </span>
))}