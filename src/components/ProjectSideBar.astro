---
// Case-study sidebar used by every project detail page: one style, one scroll script.
// Pass `items` for custom sections; by default it shows the six design-process steps.
interface NavItem {
  number: string;
  label: string;
  href: string; // "#section-id"
}

interface Props {
  title?: string;
  items?: NavItem[];
}

const designProcess: NavItem[] = [
  { number: "01", label: "Empathize", href: "#empathize" },
  { number: "02", label: "Define", href: "#define" },
  { number: "03", label: "Ideate", href: "#ideate" },
  { number: "04", label: "Prototype", href: "#prototype" },
  { number: "05", label: "Test", href: "#test" },
  { number: "06", label: "Final design", href: "#final-design" },
];

const { title = "Design process", items = designProcess } = Astro.props as Props;
---

<aside data-case-study-navigation class="sticky top-28 flex w-full flex-col">
  <h3 class="mb-4 text-sm font-semibold uppercase tracking-[0.18em] text-green-dark">
    {title}
  </h3>

  <nav aria-label="Case study sections">
    <ol class="border-y border-brown-dark/15">
      {items.map((item, index) => (
        <li>
          <a
            href={item.href}
            data-case-study-link
            data-section-id={item.href.replace("#", "")}
            aria-current={index === 0 ? "location" : undefined}
            class="group grid grid-cols-[32px_1fr] gap-3 border-b border-brown-dark/15 px-3 py-4 text-sm text-brown-dark/70 transition-colors duration-300 ease-out last:border-b-0 hover:bg-black hover:text-white aria-[current=location]:bg-brown-light aria-[current=location]:font-semibold aria-[current=location]:text-white"
          >
            <span class="font-semibold text-green-dark transition-colors duration-300 ease-out group-hover:text-green-light group-aria-[current=location]:text-white">
              {item.number}
            </span>
            <span>{item.label}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
</aside>

<script>
  function setupCaseStudyNavigation() {
    const navigation = document.querySelector<HTMLElement>(
      "[data-case-study-navigation]",
    );

    if (!navigation || navigation.dataset.ready === "true") {
      return;
    }

    navigation.dataset.ready = "true";

    const links = Array.from(
      navigation.querySelectorAll<HTMLAnchorElement>("[data-case-study-link]"),
    );

    const sections = links
      .map((link) => {
        const sectionId = link.dataset.sectionId;

        if (!sectionId) {
          return null;
        }

        return document.getElementById(sectionId);
      })
      .filter((section): section is HTMLElement => section !== null);

    function selectSection(sectionId: string) {
      links.forEach((link) => {
        const isActive = link.dataset.sectionId === sectionId;

        if (isActive) {
          link.setAttribute("aria-current", "location");
        } else {
          link.removeAttribute("aria-current");
        }
      });
    }

    // Immediately update the active item when clicked
    links.forEach((link) => {
      link.addEventListener("click", () => {
        const sectionId = link.dataset.sectionId;

        if (sectionId) {
          selectSection(sectionId);
        }
      });
    });

    // Update the active item while scrolling: the active section is the last
    // one whose top has passed 30% of the screen height (never skips a step).
    function updateFromScroll() {
      const line = window.innerHeight * 0.3;
      let active = sections[0];
      for (const section of sections) {
        if (section.getBoundingClientRect().top <= line) active = section;
      }
      // At the very bottom, highlight the last step
      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
        active = sections[sections.length - 1];
      }
      if (active) selectSection(active.id);
    }

    // Cheap: only reads a few section positions, so it can run on every scroll
    const onScroll = updateFromScroll;
    window.addEventListener("scroll", onScroll, { passive: true });
    // Stop listening when navigating to another page
    document.addEventListener(
      "astro:before-swap",
      () => window.removeEventListener("scroll", onScroll),
      { once: true },
    );
    updateFromScroll();

    // Select the section from the URL when loading
    const hash = window.location.hash.replace("#", "");

    if (hash && sections.some((section) => section.id === hash)) {
      selectSection(hash);
    }
  }

  setupCaseStudyNavigation();

  document.addEventListener("astro:page-load", setupCaseStudyNavigation);
</script>
