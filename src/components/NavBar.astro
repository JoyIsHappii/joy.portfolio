---
import "../styles/global.css";
import Plane from "../assets/room-elements/plane.svg";
import Joy from "../assets/joy.png";
import MusicPlayer from "./MusicPlayer.astro";

interface Props {
  active?: "home" | "projects" | "about" | "resume";
  surface?: "white" | "ivory";
  // Show the music player in place of the contact button and avatar
  music?: boolean;
}

const { active, surface = "white", music = false } = Astro.props as Props;

const navItems = [
  { name: "Home", href: "/", key: "home" },
  { name: "Projects", href: "/projects", key: "projects" },
  { name: "About Me", href: "/about", key: "about" },
  // { name: "Resume", href: "https://1drv.ms/b/c/bc6fb2b45e307ae3/IQBVp7ss7KHWT7aYn43V475LAXSVTU2UBHL-Oz9fIZm0gUg?e=eWlDIA", key: "resume", target: "_blank", rel: "noopener noreferrer" },
];
---

<nav
  class:list={[
    `
    sticky
    top-0
    z-50
    flex
    w-full
    flex-wrap
    gap-4
    items-center
    justify-between
    border-b
    border-brown-dark/10
   py-4
    px-4
    sm:px-6
    md:px-12
    lg:px-16
    transition-all
    duration-300
    ease-in-out
    `,
    surface === "ivory" ? "bg-ivory" : "bg-white",
  ]}
>
  <ul class="flex flex-wrap gap-4 sm:gap-8 md:gap-10">
    {
      navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              `
                border-b-2
                pb-1
                text-sm
                tracking-wide
                text-brown-dark
                transition-colors
                sm:text-base
              `,
              active === item.key
                ? "border-brown-dark font-semibold"
                : "border-transparent hover:border-brown-dark/40",
            ]}
          >
            {item.name}
          </a>
        </li>
      ))
    }
  </ul>


    <div class="ml-auto">
      <MusicPlayer />
    </div>

</nav>