---
import "../styles/global.css";
import Plane from "../assets/room-elements/plane.svg";
import Joy from "../assets/joy.png";

interface Props {
  active?: "home" | "projects" | "about";
}

const { active } = Astro.props as Props;

const navItems = [
  { name: "Home", href: "/", key: "home" },
  { name: "Projects", href: "/projects", key: "projects" },
  { name: "About Me", href: "https://interactive-resume-joy.vercel.app", key: "about" },
];
---

<nav
  class="
    sticky
    top-0
    z-50
    flex
    w-full
    flex-wrap
    gap-4
    items-center
    justify-between
    border-b
    border-brown-dark/10
    bg-white

    py-5
    backdrop-blur-md
    md:py-6
  "
>
  <ul class="flex flex-wrap gap-4 sm:gap-8 md:gap-10">
    {
      navItems.map((item) => (
        <li>
          <a
            href={item.href}
            target={item.key === "about" ? "_blank" : undefined}
            rel={item.key === "about" ? "noopener noreferrer" : undefined}
            class:list={[
              `
                border-b-2
                pb-1
                text-sm
                tracking-wide
                text-brown-dark
                transition-colors
                sm:text-base
              `,
              active === item.key
                ? "border-brown-dark font-semibold"
                : "border-transparent hover:border-brown-dark/40",
            ]}
          >
            {item.name}
          </a>
        </li>
      ))
    }
  </ul>

  <div class="ml-auto flex flex-row items-center gap-2">
    <a
      href="mailto:joy.is.happii@gmail.com"
      class="
        flex
        flex-row
        items-center
        gap-2
        rounded-full
        bg-brown-dark
        px-4
        py-2
        text-sm
        font-semibold
        tracking-wide
        text-white
        transition-all
        ease-in-out
        hover:bg-black
      "
    >
      Say hi

      <Plane class="h-6 w-6 sm:h-8 sm:w-8" />
    </a>

    <img
      src={Joy.src}
      alt="Joy"
      class="
        h-12
        w-12
        rounded-full
        object-cover
      "
    />
  </div>
</nav>