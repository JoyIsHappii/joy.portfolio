---
import "../styles/global.css";

interface Props {
  variant?: "primary" | "secondary" | "disabled" | "danger";
  size?: "md" | "lg";
  type?: "button" | "submit" | "reset";
  href?: string;
  id?: string;
  class?: string;
  disabled?: boolean;
}

const {
  variant = "primary",
  size = "md",
  type = "button",
  href,
  id,
  class: className = "",
  disabled = false,
} = Astro.props as Props;

const sizes: Record<string, string> = {
  md: "px-6 py-2.5 text-base shadow-sm",
  lg: "px-8 py-3 text-xl shadow-[0_4px_8px_rgba(0,0,0,0.4),inset_0_2px_4px_rgba(255,255,255,0.15),inset_0_-2px_4px_rgba(0,0,0,0.5)]",
};

const base =
  "inline-flex items-center justify-center gap-1 rounded-full font-medium tracking-wide transition-all duration-200";

const variants: Record<string, string> = {
  primary:
    "border border-white/20 bg-brown-dark text-white hover:border-brown-dark hover:bg-black dark:border-white dark:bg-white dark:text-black dark:hover:border-brown-dark dark:hover:bg-brown-dark dark:hover:text-white",

  secondary:
    "border border-brown-dark/20 bg-cream/70 text-brown-dark hover:border-black hover:bg-cream hover:text-black dark:border-white/30 dark:bg-black dark:text-white dark:hover:border-brown-dark dark:hover:bg-brown-dark/30",

  disabled:
    "cursor-not-allowed border border-black/10 bg-black/5 text-black/30 dark:border-white/10 dark:bg-white/10 dark:text-white/30",

  danger:
    "border border-brown-dark bg-brown-dark text-white hover:border-black hover:bg-black dark:hover:border-white dark:hover:bg-white dark:hover:text-black",
};

const disabledStyle = "pointer-events-none opacity-60";

const classes = `
  ${base}
  ${sizes[size]}
  ${variants[variant]}
  ${disabled ? disabledStyle : ""}
  ${className}
`;
---

{
  href ? (
    <a id={id} href={disabled ? undefined : href} class={classes}>
      <slot />
    </a>
  ) : (
    <button id={id} type={type} class={classes} disabled={disabled}>
      <slot />
    </button>
  )
}
