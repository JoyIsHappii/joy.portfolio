---
import "../styles/global.css";

interface Props {
  variant?: "primary" | "secondary" | "disabled" | "danger";
  size?: "md" | "lg";
  type?: "button" | "submit" | "reset";
  href?: string;
  id?: string;
  class?: string;
  disabled?: boolean;
  target?: string;
  rel?: string;
  warmupLink?: string;
}

const {
  variant = "primary",
  size = "md",
  type = "button",
  href,
  id,
  class: className = "",
  disabled = false,
  target,
  rel,
  warmupLink,
} = Astro.props as Props;

const sizes: Record<string, string> = {
  sm: "px-4 py-2 text-sm ",
  md: "px-6 py-2.5 text-base ",
  lg: "px-8 py-3 text-xl ",
};

const base =
  "inline-flex items-center justify-center gap-1 rounded-full font-medium tracking-wide transition-all duration-200";

const variants: Record<string, string> = {
  primary:
    "border border-white/20 bg-brown-dark text-white hover:border-brown-dark hover:bg-black dark:border-white dark:bg-white dark:text-black dark:hover:border-brown-dark dark:hover:bg-brown-dark dark:hover:text-white",

  secondary:
    "border border-brown-dark/20 bg-[#FEF7F4]/70 text-brown-dark hover:border-black hover:bg-white hover:text-black dark:border-white/30 dark:bg-black dark:text-white dark:hover:border-brown-dark dark:hover:bg-brown-dark/30",

  disabled:
    "cursor-not-allowed border border-black/10 bg-black/5 text-black/30 dark:border-white/10 dark:bg-white/10 dark:text-white/30",

  danger:
    "border border-brown-dark bg-brown-dark text-white hover:border-black hover:bg-black dark:hover:border-white dark:hover:bg-white dark:hover:text-black",
};

const disabledStyle = "pointer-events-none opacity-60";

const classes = `
  ${base}
  ${sizes[size]}
  ${variants[variant]}
  ${disabled ? disabledStyle : ""}
  ${className}
  ${target ? `target="_blank"` : ""}
`;
---

{
  href ? (
    <a
      id={id}
      href={disabled ? undefined : href}
      class={classes}
      target={target}
      data-warmup-link={warmupLink}
    >
      <slot />
    </a>
  ) : (
    <button id={id} type={type} class={classes} disabled={disabled}>
      <slot />
    </button>
  )
}
