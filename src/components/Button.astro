---
import "../styles/global.css";

interface Props {
  variant?: "primary" | "neutral" | "subtle" | "disabled" | "danger";
  size?: "md" | "lg";
  type?: "button" | "submit" | "reset";
  href?: string;
  id?: string;
  class?: string;
  disabled?: boolean;
}

const {
  variant = "primary",
  size = "md",
  type = "button",
  href,
  id,
  class: className = "",
  disabled = false,
} = Astro.props as Props;

const sizes: Record<string, string> = {
  md: "px-6 py-2.5 text-base shadow-sm",
  lg: "px-8 py-3 text-xl shadow-[0_4px_8px_rgba(0,0,0,0.4),inset_0_2px_4px_rgba(255,255,255,0.15),inset_0_-2px_4px_rgba(0,0,0,0.5)]",
};

const base =
  "inline-flex items-center justify-center gap-1 rounded-full font-medium tracking-wide transition-all duration-200";

const variants: Record<string, string> = {
  primary: "bg-brown-dark text-white hover:bg-black",
  neutral: "bg-white text-black border border-black/15 hover:bg-black/5",
  subtle: "bg-transparent text-brown-dark border-2 border-brown-dark hover:bg-black/5 backdrop-blur-[6px]",
  disabled: "bg-gray-medium/20 text-gray-medium border border-gray-medium/20",
  danger: "bg-red-500 text-white hover:bg-red-700",
};

const disabledStyle = "pointer-events-none opacity-60";

const classes = `
  ${base}
  ${sizes[size]}
  ${variants[variant]}
  ${disabled ? disabledStyle : ""}
  ${className}
`;
---

{
  href ? (
    <a id={id} href={disabled ? undefined : href} class={classes}>
      <slot />
    </a>
  ) : (
    <button id={id} type={type} class={classes} disabled={disabled}>
      <slot />
    </button>
  )
}
