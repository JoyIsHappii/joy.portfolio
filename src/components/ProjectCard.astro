---
import Tag from "../components/Tag.astro";
import Button from "../components/Button.astro";
import Tech from "../components/Tech.astro";

type ProjectCategory =
  | "UX/UI Design"
  | "Web Development"
  | "Project Management";

interface ProjectCardProps {
  title: string;
  description: string;
  imageSrc: string;
  imageAlt: string;
  categories?: ProjectCategory[];
  projectLink?: string;
  warmupLink?: string;
  modalId?: string;
  tech?: string[];
}

const {
  title,
  description,
  imageSrc,
  imageAlt,
  categories = [],
  projectLink,
  warmupLink,
  modalId,
  tech = [],
} = Astro.props as ProjectCardProps;

const opensModal = Boolean(modalId);
---

<article
  data-project-item
  data-category={categories.join(",")}
  class="
    group
    flex
    h-full
    w-full
    flex-col
    justify-between
    overflow-hidden
    border
    border-brown-dark/20
    bg-transparent
    backdrop-blur-[6px]
    transition-all
    duration-300
    ease-in-out
    hover:scale-[1.02]
    hover:border-brown-dark/20
    hover:bg-brown-medium/50
  "
>
  <!-- Project image -->
  {
    opensModal ? (
      <button
        type="button"
        data-modal-open={modalId}
        aria-haspopup="dialog"
        aria-controls={modalId}
        class="
          block
          w-full
          cursor-pointer
          overflow-hidden
          text-left
        "
      >
        <img
          src={imageSrc}
          alt={imageAlt}
          loading="lazy"
          decoding="async"
          class="
            aspect-[4/3]
            h-full
            w-full
            object-cover
            transition-transform
            duration-300
            ease-in-out
            group-hover:scale-[1.05]
          "
        />
      </button>
    ) : (
      <a
        href={projectLink}
        class="block overflow-hidden"
        aria-label={`View ${title} project`}
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          src={imageSrc}
          alt={imageAlt}
          loading="lazy"
          decoding="async"
          class="
            aspect-[4/3]
            h-full
            w-full
            object-cover
            transition-transform
            duration-300
            ease-in-out
            group-hover:scale-[1.05]
          "
        />
      </a>
    )
  }

  <!-- Project information -->
  <div class="flex flex-1 flex-col p-4 items-start justify-start gap-0">
    <h3
      class="
        text-left
        text-[34px]
        font-normal
        leading-none
        tracking-tight
        text-brown-dark
        transition-colors
        duration-300
      "
    >
      {title}
    </h3>

    <div class="mt-2 flex flex-wrap gap-2">
      {
        categories.map((category) => (
          <Tag category={category} />
        ))
      }
    </div>


    <p
      class="
        mt-4
        font-mono
        text-[15px]
        leading-[1.2]
        tracking-[0.08em]
        text-brown-dark/75
        transition-colors
        duration-300
      "
    >
      {description}
    </p>
        <div class="mt-2 flex flex-wrap gap-2">
      {
        tech.map((tech) => (
          <Tech tech={tech} />
        ))
      }
    </div>
  </div>
  

  <!-- Card action -->
  <div
    class="
      bg-black/10
      p-4
      pt-0
      transition-colors
      duration-300
      ease-in-out
      group-hover:bg-transparent
      flex
      w-full
      items-center
      justify-start
      gap-2
      md:justify-start
    "
  >
  
    {
      opensModal ? (
        <button
          type="button"
          data-modal-open={modalId}
          aria-haspopup="dialog"
          aria-controls={modalId}
          class="
           mt-4 px-6 py-2.5 text-base inline-flex items-center justify-center gap-1 rounded-full font-medium tracking-wide transition-all duration-200
          border border-white/20 bg-brown-dark text-white hover:border-brown-dark hover:bg-black dark:border-white dark:bg-white dark:text-black dark:hover:border-brown-dark dark:hover:bg-brown-dark dark:hover:text-white
            "
        >
          View Project
        </button>
      ) : (
        <Button
          href={projectLink}
          variant="primary"
          size="md"
          class="mt-4"
          warmupLink={warmupLink}
          target="_blank"
        >
          View Project
        </Button>
      )
    }
  </div>
</article>

<script>
  document.addEventListener("click", (event) => {
    const target = event.target;

    if (!(target instanceof Element)) {
      return;
    }

    const link = target.closest<HTMLAnchorElement>("[data-warmup-link]");
    const warmupLink = link?.dataset.warmupLink;

    if (warmupLink) {
      void fetch(warmupLink, { mode: "no-cors", keepalive: true }).catch(() => {});
    }
  });
</script>
