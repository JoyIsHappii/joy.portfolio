---
import Tag from "../components/Tag.astro";
import Button from "../components/Button.astro";

type ProjectCategory =
  | "UX Design"
  | "UI Design"
  | "Web Development"
  | "Project Design";

interface ProjectCardProps {
  title: string;
  description: string;
  imageSrc: string;
  imageAlt: string;
  categories?: ProjectCategory[];
  projectLink: string;
}

const {
  title,
  description,
  imageSrc,
  imageAlt,
  categories = [],
  projectLink,
} = Astro.props as ProjectCardProps;
---

<article
  data-project-item
  data-category={categories.join(",")}
  class="
    group
    flex
    w-full
    h-full
    flex-col
    justify-between
    overflow-hidden
    border
    border-brown-dark/20
    bg-transparent
    backdrop-blur-[6px]
    transition-all
    duration-300
    ease-in-out
    hover:scale-[1.02]
    hover:border-brown-dark/20
    hover:bg-brown-medium/50
  "
>
  <a href={projectLink} class="block overflow-hidden">
    <img
      src={imageSrc}
      alt={imageAlt}
      class="
        h-full
        w-full
        object-cover
        transition-transform
        duration-300
        ease-in-out
        group-hover:scale-[1.05]
      "
    />
  </a>

  <div class="flex flex-col p-4">
    <h3
      class="
        text-left
        text-[34px]
        font-normal
        leading-none
        tracking-tight
        text-brown-dark
        transition-colors
        duration-300
      "
    >
      {title}
    </h3>

    <div class="mt-2 flex flex-wrap gap-2">
      {
        categories.map((category) => (
          <Tag category={category} />
        ))
      }
    </div>

    <p
      class="
        mt-4
        font-mono
        text-[15px]
        leading-[1.2]
        tracking-[0.08em]
        transition-colors
        duration-300
      "
    >
      {description}
    </p>
  </div>

  <div
    class="
      bg-black/10
      p-4
      pt-0
      transition-colors
      duration-300
      ease-in-out
      group-hover:bg-transparent
    "
  >
    <Button
      href={projectLink}
      variant="primary"
      size="md"
      class="mt-4"
    >
      View Project
    </Button>
  </div>
</article>