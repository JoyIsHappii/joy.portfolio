---
import Tag from "../components/Tag.astro";
import Button from "../components/Button.astro";

interface ProjectCardProps {
  title: string;
  description: string;
  imageSrc: string;
  imageAlt: string;
  category: "all" | "UX/UI Design" | "Web Development" | "Project Design";
  projectLink: string;
}

const {
  title,
  description,
  imageSrc,
  imageAlt,
  category,
  projectLink,
} = Astro.props as ProjectCardProps;
---

<article
  data-project-card
  data-category={category}
  class="
    w-full
    rounded-[22px]
    bg-[#E6E9D0]/65
    backdrop-blur-[24px]
    border
    border-white/40
    overflow-hidden
    flex
    flex-col
    justify-between
  "
>
  <!-- IMAGE -->
  <a href={projectLink} class="block overflow-hidden">
    <img
      src={imageSrc}
      alt={imageAlt}
      class="w-full h-[220px] object-cover"
    />
  </a>

  <!-- CONTENT -->
  <div class="p-4 flex flex-col">
    <h3
      class="
        mt-4
        text-[34px]
        leading-none
        font-normal
        tracking-tight
        text-black
      "
    >
      {title}
    </h3>

    <Tag category={category} class="mt-2" />

    <p
      class="
        mt-4
        max-w-72.5
        text-[15px]
        leading-[1.2]
        tracking-[0.08em]
        font-mono
        text-[#333333]
      "
    >
      {description}
    </p>
  </div>

  <div class="p-4 pt-0">
    <Button
      href={projectLink}
      variant="primary"
      size="md"
      class="mt-4"
    >
      View Project
    </Button>
  </div>
</article>