---
import Tag from "../components/Tag.astro";
import Button from "../components/Button.astro";

interface ProjectCardProps {
  title: string;
  description: string;
  imageSrc: string;
  imageAlt: string;
  category: "all" | "UX/UI Design" | "Web Development" | "Project Design";
  projectLink: string;
}

const {
  title,
  description,
  imageSrc,
  imageAlt,
  category,
  projectLink,
} = Astro.props as ProjectCardProps;


const bgColors = {
  "UX/UI Design": "bg-blue-100",
  "Web Development": "bg-green-100",
  "Project Design": "bg-purple-100",
  all: "bg-gray-200",
};
---

<article
  data-project-card
  data-category={category}
  class="
    w-full
    rounded-[22px]
    border
    overflow-hidden
    flex
    flex-col
    justify-between
    hover:scale-[1.02]
    transition-transform
    duration-300
    ease-in-out
    bg-transparent
   border-white/60
    backdrop-blur-[6px]
    shadow-lg
    shadow-black/20
    group

    hover:bg-black/80
    hover:border-black/20

  "
>
  <!-- IMAGE -->
  <a href={projectLink} class="block overflow-hidden">
    <img
      src={imageSrc}
      alt={imageAlt}
      class="w-full h-full object-cover bg-black/20 group-hover:scale-[1.05] transition-transform duration-300 ease-in-out"
    />
  </a>

  <!-- CONTENT -->
  <div class="p-4 flex flex-col">
    <h3
      class="
        text-[34px]
        leading-none
        font-normal
        tracking-tight
        text-black
        hover:text-white
        group-hover:text-white
      "
    >
      {title}
    </h3>

    <Tag category={category} class="mt-2" />

    <p
      class="
        mt-4
        max-w-72.5
        text-[15px]
        leading-[1.2]
        tracking-[0.08em]
        font-mono
        text-black
        group-hover:text-white
      "
    >
      {description}
    </p>
  </div>

  <div class="p-4 pt-0 group-hover:bg-black/80 bg-black/10 transition-colors duration-300 ease-in-out">
    <Button
      href={projectLink}
      variant="primary"
      size="md"
      class="mt-4"
    >
      View Project
    </Button>
  </div>
</article>