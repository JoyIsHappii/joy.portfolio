---
import "../styles/global.css";

import Monitor from "../assets/room-elements/monitor.svg";
import Camera from "../assets/room-elements/camera.svg";
import Trophy from "../assets/room-elements/trophy.svg";
import Backpack from "../assets/room-elements/backpack.svg";
import Portrait from "../assets/room-elements/portrait.svg";
import Table from "../assets/room-elements/table.svg";
import Plane from "../assets/room-elements/plane.svg";

import Radio from "../components/Radio.astro";
import Layout from "../layouts/MainLayout.astro";
---


<Layout title="Portfolio" active="home">

  <!-- VIDEO TRANSITION -->
  <div
    id="project-transition"
    class="fixed inset-0 z-[99999] hidden"
  >
    <video
      id="project-transition-video"
      class="w-full h-full object-cover"
      muted
      playsinline
      preload="auto"
    >
      <source
        src="/videos/page-transition.mp4"
        type="video/mp4"
      />
    </video>
  </div>


  <!-- YOUR ROOM -->
  <div class="relative w-[1280px] h-[721px]">
    <Radio class="absolute left-[0px] top-[0px] w-[1280px] z-0" />

    <!-- Table -->
    <Table
      class="absolute left-[116px] top-[570px] w-[1100px] z-0"
    />


    <!-- Plane -->
    <a
      href="https://www.linkedin.com/in/joykosol/" target="_blank" rel="noopener noreferrer"
      class=" absolute left-[100px] top-[100px] w-[200px] z-20 desk-item"
    >
      <Plane class="w-full" />
      
    </a>


    <!-- BACKPACK → PROJECTS -->
    <a
      href="/projects"
      class=" absolute left-[146px] top-[210px] w-[334px] z-20 desk-item"
    >
      <Backpack class="w-full hover-label" />
    </a>


    <!-- MONITOR → PROJECTS -->
<!-- MONITOR / WORKSPACE GUIDE -->
<div
  class="absolute left-[397px] top-[190px] w-[485px] z-20"
>
  <Monitor class="w-full" />

  <div
    class="absolute inset-0 flex items-start justify-center w-[80%] h-[80%] m-auto"
  >
    <!-- First message -->
    <div
      id="first-message"
      class="flex flex-col items-start justify-center pt-10 px-10 gap-4 text-start text-white"
    >
      <p
        class="text-lg font-normal"
        data-aos="zoom-in-up"
        data-aos-duration="2000"
      >
        Hello 👋 Welcome to my workspace 🎄
      </p>
        <p
        class="text-lg font-normal"
        data-aos="fade-up"
        data-aos-duration="2000"
        data-aos-delay="1000"
      >
        Everything here tells a story about me, my work, and my hobbies.
      </p>
            <p
        class="text-lg font-normal"
        data-aos="fade-up"
        data-aos-duration="2000"
        data-aos-delay="1500"
      >
        Click on the items to explore and learn more about me!
      </p>

      <button
        id="open-help"
        type="button"
        class="cursor-pointer mt-4 underline underline-offset-4 transition hover:text-[#E9DCC9]"
        aria-controls="second-message"
        aria-expanded="false"
        data-aos="zoom-in"
        data-aos-duration="2000"
        data-aos-delay="2500"
      >
        Hint?
      </button>
    </div>

    <!-- Help message -->
    <div
      id="second-message"
      class="flex flex-col items-start justify-center pt-10 px-10 text-start text-white"
      hidden
    >
      <p class="mb-3 text-base">
        Here’s how to explore:
      </p>

      <ul class="space-y-2 text-sm text-left">
        <li>🎒 Backpack — View my projects</li>
        <li>⭐ Trophy — View my awarded project</li>
        <li>📷 Camera — See my hobbies</li>
        <li>🖼️ Portrait — Learn more about me</li>
        <li>✈️ Plane — Connect with me on LinkedIn</li>
      </ul>

      <button
        id="close-help"
        type="button"
        class="cursor-pointer mt-4 underline underline-offset-4 transition hover:text-[#E9DCC9]"
      >
        ← Go back
      </button>
    </div>
  </div>
</div>


    <!-- Camera -->
    <a
      href="https://www.instagram.com/joy.is.happii/"
      class="absolute left-[800px] top-[510px] w-[161px] z-30 desk-item"
    >
      <Camera class="w-full" />
    </a>


    <!-- Trophy -->
    <a
      href="/projects/7van"
      class="absolute left-[908px] top-[295px] w-[197px] z-10 desk-item"
      id="trophy-link"
    >
      <Trophy class="w-full" />
    </a>


    <!-- Portrait -->
    <a
      href="/about"
      class="absolute left-[901px] top-[67px] w-[196px] z-30 desk-item"
    >
      <Portrait class="w-full" />
    </a>

  </div>

</Layout>


<script>
  function setupMonitorHelp() {
    const firstMessage =
      document.querySelector<HTMLElement>("#first-message");

    const secondMessage =
      document.querySelector<HTMLElement>("#second-message");

    const openButton =
      document.querySelector<HTMLButtonElement>("#open-help");

    const closeButton =
      document.querySelector<HTMLButtonElement>("#close-help");

    if (
      !firstMessage ||
      !secondMessage ||
      !openButton ||
      !closeButton
    ) {
      return;
    }

    // Prevent duplicate listeners after Astro page transitions.
    if (openButton.dataset.initialized === "true") {
      return;
    }

    openButton.dataset.initialized = "true";

    function showHelp() {
      firstMessage.hidden = true;
      secondMessage.hidden = false;

      openButton.setAttribute("aria-expanded", "true");

      // Move keyboard focus to the back button.
      closeButton.focus();
    }

    function hideHelp() {
      secondMessage.hidden = true;
      firstMessage.hidden = false;

      openButton.setAttribute("aria-expanded", "false");

      // Return keyboard focus to the help button.
      openButton.focus();
    }

    openButton.addEventListener("click", showHelp);
    closeButton.addEventListener("click", hideHelp);
  }

  setupMonitorHelp();

  // Required when using Astro ClientRouter/view transitions.
  document.addEventListener(
    "astro:page-load",
    setupMonitorHelp
  );
</script>

<style>
  .desk-item {
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    transform-origin: bottom center;
    cursor: pointer;
  }

  .desk-item:hover {
    transform: scale(1.10);
    shadow: 0px 10px 20px rgba(0, 0, 0, 0.2);
  }
</style>
