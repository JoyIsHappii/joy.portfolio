---
import ContentLayout from "../../layouts/ContentLayout.astro";
import Skills from "../../sections/Skills.astro";
import Portrait from "../../assets/joy.png";
import AwardImage from "../../assets/award-image.webp";
import Button from "../../components/Button.astro";

const experience = [
  {
    value: "5+",
    label: "years in Project Management",
    note: "Architecture, coordination, and real-world problem solving. ",
  },
  {
    value: "1+",
    label: "year studying web design",
    note: "Research, prototyping, visual systems, and usability. Web development fundamentals.",
  },
  {
    value: "10",
    label: "months of internship",
    note: "Collaborating on practical digital design work and learning from experienced professionals.",
  },
];

const journey = [
  {
    chapter: "01",
    title: "Architecture",
    description:
      "Bachelor's and Master's degrees built my foundation in systems thinking, spatial design, and presenting ideas clearly.",
  },
  {
    chapter: "02",
    title: "Project Management",
    description:
      "Five years of professional experience taught me to balance user needs, business goals, deadlines, and cross-team communication.",
  },
  {
    chapter: "03",
    title: "UI/UX design",
    description:
      "I moved into digital products to create experiences that are useful, intuitive, and visually meaningful.",
  },
  {
    chapter: "04",
    title: "Web development",
    description:
      "Learning front-end development helps me design with technical constraints in mind and collaborate more effectively with developers.",
  },
];
---

<ContentLayout title="About Me — Joy" active="about">
  <main class="w-full pb-20">
    <section
      class="grid
    w-full
    overflow-hidden
    border-b
    border-brown-dark/15
    py-8
    md:grid-cols-12
    md:items-center
    md:gap-0
    md:py-12
    lg:gap-0"
    >
      <!-- About content -->
      <div
        class="order-2
      flex
      flex-col
      items-start
      pt-6
      md:order-1
      md:col-span-7
      md:pt-0"
      >
        <p
          class="text-xs
        font-semibold
        uppercase
        tracking-[0.18em]
        text-[#596044]"
        >
          UX/UI Designer · Vancouver
        </p>

        <h1
          class="mt-3
        max-w-2xl
        text-4xl
        font-normal
        leading-[1.05]
        tracking-tight
        text-brown-dark
        sm:text-5xl
        lg:text-6xl"
        >
          I connect thoughtful design with practical execution.
        </h1>

        <p
          class="mt-5
        max-w-xl
        text-sm
        leading-7
        text-brown-dark/90
        sm:text-base"
        >
          Hi, I’m Joy—an architect turned UI/UX designer and web developer. I
          bring five years of project-design experience into digital products,
          combining structured thinking, visual storytelling, and empathy for
          users.
        </p>

        <div class="mt-6 flex flex-wrap gap-3">
          <Button href="https://drive.google.com/file/d/1TkGK3HhMop59cd6o-VvZbf6_4B8kxMrp/view?usp=share_link" variant="primary">View Resume </Button>

          <Button
            href="https://www.linkedin.com/in/joykosol/"
            variant="secondary"
          >
            Let’s connect
          </Button>
        </div>
      </div>

      <!-- Portrait -->
      <div
        class="order-1
      flex
      items-center
      justify-center
      overflow-hidden
      p-5
      md:order-2
      md:col-span-5"


      >
        <img
          src={Portrait.src}
          alt="Joy Kosol"
        />
      </div>
    </section>

    <section
      class="grid gap-px border-x border-b border-brown-dark/15 bg-brown-dark/15 md:grid-cols-3"
    >
      {
        experience.map((item) => (
          <article class="bg-cream p-7 sm:p-9">
            <strong class="text-5xl font-semibold text-brown-dark">
              {item.value}
            </strong>
            <h2 class="mt-3 text-xl">{item.label}</h2>
            <p class="mt-3 text-sm text-brown-dark/90">{item.note}</p>
          </article>
        ))
      }
    </section>

    <section class="py-16 sm:py-24">
      <div class="grid gap-10 lg:grid-cols-[0.75fr_1.25fr] lg:gap-20">
        <div>
          <p
            class="text-sm font-semibold uppercase tracking-[0.18em] text-[#596044]"
          >
            My story
          </p>
          <h2 class="mt-4 text-4xl sm:text-5xl">
            A design path shaped by curiosity
          </h2>
          <p class="mt-6 text-brown-dark/90">
            Each chapter added a new perspective—from understanding physical
            spaces to shaping digital experiences and learning how they are
            built.
          </p>
        </div>
        <ol class="border-t border-brown-dark/15">
          {
            journey.map((item) => (
              <li class="grid gap-3 border-b border-brown-dark/15 py-7 sm:grid-cols-[60px_180px_1fr] sm:gap-5">
                <span class="text-sm font-semibold text-rose">
                  {item.chapter}
                </span>
                <h3 class="text-xl">{item.title}</h3>
                <p class="text-sm text-brown-dark/90">{item.description}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section
      class="overflow-hidden border-y border-brown-dark/15 bg-ivory py-12"
    >
      <div class="px-6 sm:px-10">
        <p
          class="text-center text-sm font-semibold uppercase tracking-[0.18em] text-[#596044]"
        >
          Tools I use to bring ideas to life
        </p>
      </div>
      <Skills class="mt-8" />
    </section>

    <section class="grid gap-10 py-16 sm:py-24 lg:grid-cols-2 lg:items-center">
      <div
        class="flex items-center justify-center bg-green-light/60 p-8 sm:p-12"
      >
        <img
          src={AwardImage.src}
          alt="7VAN Best UI/UX Project Award"
          class="h-auto w-full max-w-xl"
        />
      </div>
      <div class="lg:px-10">
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-[#596044]"
        >
          A proud moment
        </p>
        <h2 class="mt-4 text-4xl sm:text-5xl">Best UI/UX Project Award</h2>
        <p class="mt-6 text-lg leading-relaxed">
          My 7VAN academy project was selected by the real client and industry
          professionals. The recognition reflects what I value most: listening
          carefully, solving the right problem, and making the final experience
          feel clear and welcoming.
        </p>
        <Button href="/projects/7van" variant="primary" class="mt-8"
          >Read the 7VAN case study</Button
        >
      </div>
    </section>

    <section
      class="flex flex-col items-start justify-between gap-7 bg-brown-dark px-6 py-12 sm:px-10 md:flex-row md:items-center lg:px-14"
    >
      <div>
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-green-light"
        >
          What's next?
        </p><h2 class="mt-3 text-3xl !text-white sm:text-4xl">
          Let's create something meaningful together.
        </h2>
      </div>

    </section>
  </main>
</ContentLayout>
