---
import ContentLayout from "../../layouts/ContentLayout.astro";
import Button from "../../components/Button.astro";
import Tech from "../../components/Tech.astro";

import Footer from "../../components/Footer.astro";
import Modal from "../../components/Modal.astro";
import JoyCharacter from "../../assets/Chibi Ice Cream Lick Loop.gif";
// import JoyCharacter from "../../assets/joy.png";

import CertificateImage from "../../assets/certificate.jpeg";

import Ai from "../../assets/skills/ai.svg";
import Figma from "../../assets/skills/figma.svg";
import Psd from "../../assets/skills/psd.svg";
import Canva from "../../assets/skills/canva.svg";
import Html from "../../assets/skills/html.svg";
import Css from "../../assets/skills/css.svg";
import Scss from "../../assets/skills/scss.svg";
import Js from "../../assets/skills/js.svg";
import AstroIcon from "../../assets/skills/astro.svg";
import Tailwind from "../../assets/skills/tailwind.svg";
import GitHub from "../../assets/skills/github.svg";
import FigJamIcon from "../../assets/skills/figjam.svg";
import FramerIcon from "../../assets/skills/framer.svg";
import TypeScriptIcon from "../../assets/skills/typescript.svg";
import ReactIcon from "../../assets/skills/react.svg";
import NextIcon from "../../assets/skills/nextjs.jpeg";
import GsapIcon from "../../assets/skills/gsap.png";
import IMovieIcon from "../../assets/skills/imovie.jpg";
import ChatGPTIcon from "../../assets/skills/chatgpt.webp";
import ClaudeIcon from "../../assets/skills/claude.png";
import ViteIcon from "../../assets/skills/vite.svg";
import NodeIcon from "../../assets/skills/nodejs.svg";
import ExpressIcon from "../../assets/skills/express.svg";
import PostgresIcon from "../../assets/skills/postgresql.svg";
import GitIcon from "../../assets/skills/git.svg";
import VSCodeIcon from "../../assets/skills/vscode.svg";
import NetlifyIcon from "../../assets/skills/netlify.svg";
import VercelIcon from "../../assets/skills/vercel.svg";
import RenderIcon from "../../assets/skills/render.svg";
import WebflowIcon from "../../assets/skills/webflow.svg";
import WordPressIcon from "../../assets/skills/wordpress.svg";
import ShopifyIcon from "../../assets/skills/shopify.svg";
import AutoCADIcon from "../../assets/skills/autocad.svg";
import RevitIcon from "../../assets/skills/revit.svg";
import SketchUpIcon from "../../assets/skills/sketchup.svg";

// Same colours as the Projects filter dots
const dots = {
  ux: "bg-blue-500",
  web: "bg-green-500",
  pm: "bg-purple-500",
  arch: "bg-pink",
  tools: "bg-gray-500",
};

type Category = "UX/UI Design" | "Web Development" | "Project Management";

// Oldest first, so the page reads as one story
const journey: {
  number: string;
  period: string;
  title: string;
  place: string;
  detail: string;
  turningPoint?: { title: string; text: string; href: string };
  badge: string;
}[] = [
  {
    number: "01",
    period: "2012–2018",
    title: "Architecture",
    place: "Chulalongkorn University",
    detail:
      "Built a foundation in spatial design and human needs, with Second Class Honors and a Master’s in project management.",
    badge: "bg-pink/15 text-pink",
  },
  {
    number: "02",
    period: "2018–2023",
    title: "Project Management",
    place: "King Chulalongkorn Memorial Hospital",
    detail:
      "Led hospital design projects across medical, designer, and construction teams, improving environments for patients and healthcare staff.",
    turningPoint: {
      title: "COVID-19 ICU Monitoring",
      text: "A project that inspired my transition into digital design.",
      href: "/projects/covid-project",
    },
    badge: "bg-purple-100 text-purple-800",
  },
  {
    number: "03",
    period: "2023–2025",
    title: "UI/UX Design",
    place: "CICCC & Iter Innovandi",
    detail:
      "Learned user research and interaction design, and won the Best UI/UX Project Award for 7VAN.",
    badge: "bg-blue-100 text-blue-800",
  },
  {
    number: "04",
    period: "2026–Present",
    title: "Web Development",
    place: "CICCC, Vancouver",
    detail:
      "Learning to code so I can design things that are practical to build and work better with developers.",
    badge: "bg-green-100 text-green-800",
  },
];

// Tools without an icon show their initials until an icon is added:
// put the SVG in src/assets/skills/, import it above, and set `icon`.
// SVG logos are components; PNG/JPEG/WebP logos are image files
type ToolItem = { name: string; icon?: typeof Figma | ImageMetadata };

// Dot colours follow the Projects filter: blue = UX/UI, green = web development,
// grey = general tools, pink = architecture
const toolGroups: { title: string; dot: string; tools: ToolItem[] }[] = [
  {
    title: "Design",
    dot: dots.ux,
    tools: [
      { icon: Figma, name: "Figma" },
      { icon: FigJamIcon, name: "FigJam" },
      { icon: Ai, name: "Illustrator" },
      { icon: Psd, name: "Photoshop" },
      { icon: Canva, name: "Canva" },
      { icon: IMovieIcon, name: "iMovie" },
    ],
  },
  {
    title: "Frontend",
    dot: dots.web,
    tools: [
      { icon: Html, name: "HTML" },
      { icon: Css, name: "CSS" },
      { icon: Scss, name: "SCSS" },
      { icon: Js, name: "JavaScript" },
      { icon: TypeScriptIcon, name: "TypeScript" },
      { icon: Tailwind, name: "Tailwind CSS" },
      { icon: GsapIcon, name: "GSAP" },
      { icon: AstroIcon, name: "Astro" },
      { icon: ReactIcon, name: "React" },
      { icon: NextIcon, name: "Next.js" },
    ],
  },
  {
    title: "Backend",
    dot: dots.web,
    tools: [
      { icon: NodeIcon, name: "Node.js" },
      { icon: ExpressIcon, name: "Express" },
      { icon: PostgresIcon, name: "PostgreSQL" },
    ],
  },
  {
    title: "Dev tools & hosting",
    dot: dots.tools,
    tools: [
      { icon: GitIcon, name: "Git" },
      { icon: GitHub, name: "GitHub" },
      { icon: VSCodeIcon, name: "VS Code" },
      { icon: ViteIcon, name: "Vite" },
      { icon: NetlifyIcon, name: "Netlify" },
      { icon: VercelIcon, name: "Vercel" },
      { icon: RenderIcon, name: "Render" },
    ],
  },
  {
    title: "No-code & CMS",
    dot: dots.tools,
    tools: [
      { icon: FramerIcon, name: "Framer" },
      { icon: WebflowIcon, name: "Webflow" },
      // { icon: WordPressIcon, name: "WordPress" },
      // { icon: ShopifyIcon, name: "Shopify" },
    ],
  },
  {
    title: "AI tools",
    dot: dots.tools,
    tools: [
      { icon: ChatGPTIcon, name: "ChatGPT" },
      { icon: ClaudeIcon, name: "Claude" },
    ],
  },
  {
    title: "Architecture",
    dot: dots.arch,
    tools: [
      { icon: AutoCADIcon, name: "AutoCAD" },
      { icon: RevitIcon, name: "Revit" },
      { icon: SketchUpIcon, name: "SketchUp" },
    ],
  },
];

// "VS Code" -> "VC", "Next.js" -> "N"
const initials = (name: string) =>
  name
    .replace(/\.js$/, "")
    .split(/[\s.]+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((word) => word[0])
    .join("")
    .toUpperCase();

const practices: { title: string; category: Category; items: string[] }[] = [
  {
    title: "UX Research",
    category: "UX/UI Design",
    items: [
      "User Research",
      "Journey Mapping",
      "User Flows",
      "Usability Testing",
    ],
  },
  {
    title: "UI & Systems",
    category: "UX/UI Design",
    items: [
      "Wireframing",
      "Prototyping",
      "Design Systems",
      "Responsive Design",
    ],
  },
  {
    title: "Web Development",
    category: "Web Development",
    items: [
      "Responsive Layouts",
      "REST APIs",
      "Accessibility",
      "Team Workflows",
    ],
  },
  {
    title: "Project Design",
    category: "Project Management",
    items: [
      "Requirements",
      "Stakeholders",
      "Schedules & Budgets",
      "Documentation",
    ],
  },
];

const approach = [
  {
    title: "Listen first",
    detail: "I start by understanding the people who will use what I make.",
    badge: "bg-blue-100 text-blue-800",
  },
  {
    title: "Make complex things clear",
    detail: "I turn messy information into flows anyone can follow.",
    badge: "bg-purple-100 text-purple-800",
  },
  {
    title: "Bridge design and build",
    detail:
      "Working with engineers, and now writing code, helps me design things that can be built.",
    badge: "bg-green-100 text-green-800",
  },
];

// Short label shown in each row's badge
const issuerBadge: Record<string, string> = {
  "Interaction Design Foundation": "IxDF",
  "Architect Council of Thailand": "ACT",
};

const certifications: {
  name: string;
  by: string;
  date: string;
  url?: string;
}[] = [
  {
    name: "Human-Computer Interaction: The Foundations of UX Design",
    by: "Interaction Design Foundation",
    date: "2025",
    url: "https://ixdf.org/members/joy-kosol/certificate/course/6f78e485-4c58-4431-a855-e36b5ee46c43",
  },
  {
    name: "Interaction Design for Usability",
    by: "Interaction Design Foundation",
    date: "2025",
    url: "https://ixdf.org/members/joy-kosol/certificate/course/9ea4fb64-8ef1-4103-b62e-51346d8df5f6",
  },
  {
    name: "Mobile UI Design",
    by: "Interaction Design Foundation",
    date: "2025",
    url: "https://ixdf.org/members/joy-kosol/certificate/course/94283856-fb60-48e0-b0b5-dfda53e2893d",
  },
  {
    name: "Gamification: How to Create Engaging User Experiences",
    by: "Interaction Design Foundation",
    date: "2025",
    url: "https://ixdf.org/members/joy-kosol/certificate/course/95776efd-3134-4e78-a530-31816f45d3d1?certificateType=course",
  },
  {
    name: "Licensed Associate Architect",
    by: "Architect Council of Thailand",
    date: "2018",
  },
];

const categoryDot: Record<Category, string> = {
  "UX/UI Design": dots.ux,
  "Web Development": dots.web,
  "Project Management": dots.pm,
};

// Type and colour taken from the Projects page
const sectionHeading =
  "text-2xl font-normal tracking-tight text-brown-dark md:text-4xl";
const sectionSubtitle = "mt-2 text-lg font-normal text-brown-dark/75";
const mono =
  "font-mono text-[15px] leading-[1.3] tracking-[0.08em] text-brown-dark/75";
const panel =
  "group border border-brown-dark/20 bg-brown-medium/30 transition-all duration-300 ease-in-out hover:bg-brown-medium/70";
---

<ContentLayout title="About Me — Joy Kosol" active="about">
  <main class="mx-auto flex w-full max-w-6xl flex-col px-4 pt-4 pb-20 text-brown-dark md:px-0 md:pt-6">
    <!-- Intro -->
    <section
      class="border-b border-brown-dark/20 pb-14 pt-6 md:pb-20"
      aria-labelledby="about-heading"
    >
      <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(280px,360px)] lg:gap-20">
        <div class="order-2 flex flex-col lg:order-1">
          <p class="!text-sm font-semibold uppercase tracking-[0.18em] text-green-dark">
            UX/UI &amp; Project Designer
          </p>
          <h1
            id="about-heading"
            class="mt-4 text-4xl tracking-tight text-brown-dark md:text-5xl lg:text-6xl"
          >
            Hi, I'm Joy Kosol.
          </h1>
          <blockquote class="mt-6 max-w-xl border-l-4 border-green-dark/50 py-1 pl-5">
            <p class="!text-2xl !leading-snug !font-normal text-brown-dark/85 sm:!text-[1.75rem]">
              “From buildings to screens, good design starts with real human
              needs.”
            </p>
          </blockquote>
          <p class="mt-5 max-w-xl !leading-[1.8] text-brown-dark">
            I started in <b>architecture</b> and spent five years leading
            hospital design projects in Bangkok. Today, I focus on{" "}
            <b>UX/UI and project design</b>, and I'm learning web development to
            understand how designs are built.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <Button
              href="/Joy-Kosol_Resume.pdf"
              variant="primary"
              target="_blank"
            >
              Resume
            </Button>
            <Button
              href="https://www.linkedin.com/in/joykosol/"
              variant="secondary"
              target="_blank"
            >
              LinkedIn
            </Button>
          </div>
        </div>

        <figure class="order-1 mx-auto w-full max-w-[300px] lg:order-2 lg:max-w-none">
          <div class="bg-brown-medium/30 p-4 sm:p-5">
            <!-- Pink portrait frame -->
            <div class="relative aspect-square overflow-hidden rounded-xl bg-[#FAB8BC]">
              <!-- Animated character -->
              <div class="joy-character absolute inset-0 flex justify-center items-end">
                <img
                  src={JoyCharacter.src}
                  alt="Illustrated portrait of Joy Kosol"
                  class="joy-character-image"
                />
              </div>
            </div>

            <figcaption class="mt-4 flex items-center justify-between gap-3">
              <span class="font-medium text-brown-dark">Joy Kosol</span>
              <span class="text-xs text-brown-dark/60">Vancouver, BC</span>
            </figcaption>
          </div>
        </figure>
      </div>
    </section>

    <!-- Interactive resume, playable right on the page -->
    <section
      id="interactive-resume"
      class="scroll-mt-32 pt-12 lg:pt-16"
      aria-labelledby="resume-heading"
    >
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div>
          <h2 id="resume-heading" class={sectionHeading}>
            Interactive Resume
          </h2>
          <p class={sectionSubtitle}>
            A pixel-art interactive version of my resume, playable right on the
            page.
          </p>
        </div>
        <a
          href="https://interactive-resume-joy.vercel.app/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex w-fit shrink-0 items-center gap-2 rounded-full border border-brown-dark/20 bg-[#FEF7F4]/70 px-5 py-2.5 font-medium text-brown-dark transition hover:border-black hover:bg-white"
        >
          View full site <span aria-hidden="true"></span>
        </a>
      </div>
      <div class="mt-6 border border-brown-dark/20 bg-brown-medium/30 p-2 sm:p-3">
        <iframe
          src="https://interactive-resume-joy.vercel.app"
          title="Joy's interactive pixel-art resume"
          data-interactive-resume-frame
          loading="lazy"
          class="block h-[min(700px,calc(100dvh-8rem))] w-full bg-black"
        ></iframe>
      </div>
    </section>

    <div class="grid gap-10 py-12 lg:grid-cols-[256px_minmax(0,1fr)] lg:gap-14 lg:py-16">
      <!-- Section menu, styled like the Projects filter -->
      <aside class="hidden lg:block">
        <div class="sticky top-[calc(50px+4rem)]">
          <h2 class="mb-4 text-2xl font-normal tracking-tight text-brown-dark">
            About Me
          </h2>
          <nav
            aria-label="About page sections"
            data-about-navigation
            class="flex flex-col"
          >
            {[
              {
                id: "journey",
                label: "My Journey",
                dot: "before:bg-purple-500",
              },
              {
                id: "approach",
                label: "How I Work",
                dot: "before:bg-gray-500",
              },
              {
                id: "skills",
                label: "Skills & Tools",
                dot: "before:bg-blue-500",
              },
              {
                id: "certifications",
                label: "Awards & Certifications",
                dot: "before:bg-pink",
              },
            ].map((item, index) => (
              <a
                href={`#${item.id}`}
                data-about-link
                data-section-id={item.id}
                aria-current={index === 0 ? "location" : undefined}
                class:list={[
                  "relative flex w-full items-center gap-3 border-b border-brown-dark/20 bg-transparent px-4 py-2 text-left text-brown-dark transition-all duration-200 ease-in-out last:border-b-0",
                  "before:block before:h-2.5 before:w-2.5 before:shrink-0 before:rounded-full before:transition-colors before:duration-200 before:content-['']",
                  "hover:bg-brown-medium/45",
                  "aria-[current=location]:bg-brown-dark aria-[current=location]:font-semibold aria-[current=location]:text-white aria-[current=location]:before:bg-white",
                  item.dot,
                ]}
              >
                {item.label}
              </a>
            ))}
          </nav>
        </div>
      </aside>

      <div class="min-w-0 space-y-16 lg:space-y-24">
        <!-- Journey -->
        <section
          id="journey"
          class="grid scroll-mt-32 gap-10 border border-brown-dark/20 p-6 sm:p-10 md:grid-cols-[0.8fr_1.4fr] md:gap-14 lg:p-12"
          aria-labelledby="journey-heading"
        >
          <div class="md:sticky md:top-32 md:self-start">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-green-dark">
              My Journey
            </p>
            <h2 id="journey-heading" class={`${sectionHeading} mt-3`}>
              From spaces to digital experiences.
            </h2>
            <p class="mt-4 max-w-xs text-brown-dark/75">
              Different disciplines, one passion: designing better experiences
              for people.
            </p>
          </div>

          <ol class="relative flex flex-col gap-10 before:absolute before:top-4 before:bottom-4 before:left-[17px] before:w-px before:bg-brown-dark/20">
            {journey.map((item) => (
              <li class="relative grid grid-cols-[36px_1fr] gap-x-4">
                <!-- Solid white base so the timeline line never shows through the tinted circle -->
                <span
                  class="relative z-10 h-9 w-9 overflow-hidden rounded-full bg-white ring-4 ring-white"
                  aria-hidden="true"
                >
                  <span
                    class:list={[
                      "flex h-full w-full items-center justify-center text-xs font-semibold",
                      item.badge,
                    ]}
                  >
                    {item.number}
                  </span>
                </span>
                <div class="min-w-0">
                  <h3 class="text-2xl font-normal tracking-tight text-brown-dark">
                    {item.title}
                  </h3>
                  <p class="mt-1 text-sm text-brown-light">
                    {item.period} · {item.place}
                  </p>
                  <p class="mt-3 max-w-md text-brown-dark/75">{item.detail}</p>

                  {item.turningPoint && (
                    <a
                      href={item.turningPoint.href}
                      class="group mt-5 block max-w-md border border-brown-dark/15 bg-brown-medium/20 p-5 transition-colors duration-300 hover:bg-brown-medium/40"
                    >
                      <span class="block text-xs font-semibold uppercase tracking-[0.15em] text-green-dark">
                        Career turning point
                      </span>
                      <span class="mt-2 block text-xl text-brown-dark">
                        {item.turningPoint.title}
                      </span>
                      <span class="mt-1 block text-sm text-brown-dark/70">
                        {item.turningPoint.text}
                      </span>
                      <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-brown-dark underline decoration-brown-dark/30 underline-offset-4 transition-colors group-hover:decoration-brown-dark">
                        Explore project{" "}
                        <span
                          aria-hidden="true"
                          class="transition-transform duration-200 group-hover:translate-x-0.5"
                        >
                          ➹
                        </span>
                      </span>
                    </a>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </section>

        <!-- How I work -->
        <section
          id="approach"
          class="scroll-mt-32"
          aria-labelledby="approach-heading"
        >
          <h2 id="approach-heading" class={sectionHeading}>
            How I Work
          </h2>
          <p class={sectionSubtitle}>
            What I bring from buildings, hospitals and screens.
          </p>

          <ol class="mt-8 grid gap-8 border-t border-brown-dark/20 pt-8 md:grid-cols-3 md:gap-10">
            {approach.map((item, index) => (
              <li>
                <span
                  class:list={[
                    "inline-flex h-9 w-9 items-center justify-center rounded-full text-sm font-semibold",
                    item.badge,
                  ]}
                >
                  {String(index + 1).padStart(2, "0")}
                </span>
                <h3 class="mt-4 text-2xl font-normal tracking-tight text-brown-dark">
                  {item.title}
                </h3>
                <p class="mt-2 text-brown-dark/75">{item.detail}</p>
              </li>
            ))}
          </ol>
        </section>

        <!-- Skills -->
        <section
          id="skills"
          class="scroll-mt-32"
          aria-labelledby="skills-heading"
        >
          <h2 id="skills-heading" class={sectionHeading}>
            Skills & Tools
          </h2>
          <p class={sectionSubtitle}>A mix of design and code.</p>

          <div class="mt-8 divide-y divide-brown-dark/15 border-y border-brown-dark/15">
            {toolGroups.map((group) => (
              <div class="grid gap-4 py-6 md:grid-cols-[180px_1fr] md:gap-8">
                <h3 class="flex items-center gap-3 text-lg font-normal text-brown-dark md:h-16">
                  <span
                    class:list={[
                      "h-2.5 w-2.5 shrink-0 rounded-full",
                      group.dot,
                    ]}
                    aria-hidden="true"
                  />
                  {group.title}
                </h3>
                <ul class="flex flex-wrap gap-x-3 gap-y-4">
                  {group.tools.map(({ icon: Icon, name }) => (
                    <li
                      class="group flex w-[72px] flex-col items-center gap-2"
                      title={name}
                    >
                      <span class="flex h-16 w-16 items-center justify-center rounded-xl bg-brown-medium/30 transition duration-200 group-hover:-translate-y-1 group-hover:bg-brown-medium/70">
                        {Icon && typeof Icon === "function" ? (
                          <Icon
                            aria-hidden="true"
                            class="h-9 w-9 overflow-hidden rounded-lg object-contain"
                          />
                        ) : Icon ? (
                          <img
                            src={Icon.src}
                            alt=""
                            aria-hidden="true"
                            class="h-9 w-9 rounded-lg object-contain"
                            loading="lazy"
                          />
                        ) : (
                          <span
                            aria-hidden="true"
                            class="text-lg font-semibold text-brown-light/80"
                          >
                            {initials(name)}
                          </span>
                        )}
                      </span>
                      <span class="text-center text-xs leading-tight font-medium text-brown-dark/75">
                        {name}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>

          <dl class="mt-12 grid gap-x-10 gap-y-6 border-t border-brown-dark/20 pt-8 sm:grid-cols-2">
            {practices.map((practice) => (
              <div>
                <dt class="flex items-center gap-3 text-lg font-normal text-brown-dark">
                  <span
                    class:list={[
                      "h-2.5 w-2.5 shrink-0 rounded-full",
                      categoryDot[practice.category],
                    ]}
                    aria-hidden="true"
                  />
                  {practice.title}
                </dt>
                <dd class="mt-2 flex flex-wrap gap-2 pl-[22px]">
                  {practice.items.map((item) => (
                    <Tech tech={item} />
                  ))}
                </dd>
              </div>
            ))}
          </dl>
        </section>

        <!-- Awards & certifications -->
        <section
          id="certifications"
          class="scroll-mt-32"
          aria-labelledby="cert-heading"
        >
          <h2 id="cert-heading" class={sectionHeading}>
            Awards & Certifications
          </h2>
          <p class={sectionSubtitle}>
            Always learning! Recognition for my work and achievements.
          </p>

          <!-- 7VAN award, featured -->
