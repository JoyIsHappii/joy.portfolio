---
import ProjectDetailLayout from "../../layouts/ProjectDetailLayout.astro";
import Sidebar from "../../components/ProjectSideBar.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ProjectDetailHero from "../../components/ProjectDetailHero.astro";
import ProjectOverview from "../../components/ProjectOverview.astro";

import IcuCover from "../../assets/hero/icu-cover.svg";
import ContextImage from "../../assets/covid/context-users.webp";
import SystemImage from "../../assets/covid/system-relationship.webp";
import ModeImage from "../../assets/covid/mode-selection.webp";
import AutoImage from "../../assets/covid/auto-cycle.webp";
import ManualImage from "../../assets/covid/manual-fallback.webp";
import ProcessImage from "../../assets/covid/design-approach.webp";

const navItems = [
  { number: "01", label: "Project context", href: "#context" },
  { number: "02", label: "The challenge", href: "#challenge" },
  { number: "03", label: "My contribution", href: "#contribution" },
  { number: "04", label: "Design approach", href: "#approach" },
  { number: "05", label: "Key decisions", href: "#decisions" },
  { number: "06", label: "Project outcome", href: "#outcome" },
  { number: "07", label: "Reflection", href: "#reflection" },
];

const userNeeds = [
  {
    title: "Understand room conditions",
    description:
      "See key environmental readings, including temperature, humidity, and room pressure, in a way that is easier to interpret.",
  },
  {
    title: "Monitor from outside the room",
    description:
      "Review the room and equipment status without needing to enter the isolation area just to check the monitoring information.",
  },
  {
    title: "Understand the operating state",
    description:
      "Recognize whether the system is in AUTO, OFF, or MANUAL mode and understand that each mode has a different purpose.",
  },
];

const contributionAreas = [
  {
    number: "01",
    title: "Project design",
    subtitle: "Turn the brief into a coordinated system concept",
    points: [
      "Connected the room layout, staff activities, and environmental-system requirements.",
      "Organized information from clinical and technical stakeholders into a shared project view.",
      "Helped translate project requirements into design references and clear documentation.",
    ],
  },
  {
    number: "02",
    title: "UX and information design",
    subtitle: "Make complex information easier to understand",
    points: [
      "Considered the monitoring experience from the nursing team's point of view.",
      "Worked with nurses and the project team to understand what staff needed to review, including room conditions and equipment status.",
      "Organized the team's requirements into a clear relationship between staff, monitoring information, controls, equipment, and the room.",
    ],
  },
  {
    number: "03",
    title: "Project management",
    subtitle: "Keep people, decisions, and delivery aligned",
    points: [
      "Worked across clinical and technical disciplines to clarify requirements.",
      "Used workflows and visual documentation to communicate decisions.",
      "Coordinated design-related work through the construction and commissioning period.",
    ],
  },
];

const designDecisions = [
  {
    number: "01",
    title: "Start with the staff experience",
    description:
      "Rather than explaining the system only through its equipment, I organized the relationship around what staff needed to observe and understand: the monitoring view, the control state, the supporting equipment, and the room environment.",
    image: SystemImage,
    imageAlt:
      "Staff-centred relationship diagram connecting staff observation, the monitoring interface, system controls, equipment, and the isolation room.",
    caption: "A staff-centred view of the system relationship",
    // Trims the empty space above and below the artwork
    imageClass: "aspect-[1774/560] object-cover object-center",
  },
  {
    number: "02",
    title: "Make each operating mode distinct",
    description:
      "AUTO, OFF, and MANUAL represent different operating states. I kept them visually separate in the workflow documentation so the team could discuss each state without treating them as interchangeable.",
    image: ModeImage,
    imageAlt: "Three distinct operating states: AUTO, OFF, and MANUAL.",
    caption: "Three operating states, clearly distinguished",
  },
  {
    number: "03",
    title: "Show the normal operating cycle",
    description:
      "I represented AUTO as an ongoing cycle of selecting the mode, reviewing status, system operation, and continued monitoring. This gave the team a shared high-level view of the normal operating experience.",
    image: AutoImage,
    imageAlt:
      "Simplified AUTO operating cycle showing selection, status review, system operation, monitoring, and continuation.",
    caption: "A simplified view of the AUTO operating cycle",
  },
  {
    number: "04",
    title: "Make the fallback limitations clear",
    description:
      "MANUAL was documented as a separate fallback path with different capabilities from AUTO. Making that distinction visible helped avoid presenting the two modes as equivalent.",
    image: ManualImage,
    imageAlt:
      "MANUAL fallback workflow with a note that its functions differ from AUTO.",
    caption: "A separate MANUAL path, with its limitation made visible",
  },
];
---

<ProjectDetailLayout title="COVID-19 Isolation Room — Joy" active="projects">
  <main class="w-full">
    <div class="py-5 sm:py-7">
      <Breadcrumb
        items={[
          { label: "Projects", href: "/projects/" },
          {
            label: "COVID-19 Isolation Room",
            href: "/projects/covid-project/",
          },
        ]}
      />
    </div>

    <ProjectDetailHero
      eyebrow="Healthcare · Project design case study"
      title="COVID-19 Isolation Room"
      description="A new negative-pressure isolation-room project at King Chulalongkorn Memorial Hospital. I connected clinical needs, technical requirements, staff workflows, and project coordination to help turn a complex brief into a clear, shared design direction."
      imageSrc={IcuCover.src}
      imageScale="scale-100"
      imageAlt="Illustrated cutaway of a hospital isolation room with a monitoring interface and environmental system elements"
      categories={["UX/UI Design", "Project Management"]}
      role="Project Design Manager"
    />

    <div id="overview" class="scroll-mt-8">
      <ProjectOverview
        durationLabel="Project timeline"
        duration="75 days · construction to commissioning"
        role="Project Design Manager"
        responsibilities={[
          "Translated clinical and technical needs into project requirements",
          "Structured room, system, and staff workflows",
          "Coordinated design information and communication across teams",
        ]}
        challenges={[
          "Delivering a new isolation-room environment within an urgent timeline",
          "Connecting clinical needs with specialist technical requirements",
          "Making complex system information understandable to non-technical users",
        ]}
        solutions={[
          "A staff-centred view of the room and monitoring system",
          "Clear documentation of AUTO, OFF, and MANUAL operating states",
          "Shared workflows and visual references to support team coordination",
        ]}
      />
    </div>

    <section class="grid gap-10 py-14 sm:py-20 lg:grid-cols-[240px_1fr] lg:gap-16">
      <aside class="hidden lg:block">
        <Sidebar title="Case study" items={navItems} />
      </aside>

      <div class="min-w-0 space-y-20 sm:space-y-28">
        <!-- 01 / PROJECT CONTEXT -->
        <section id="context" class="scroll-mt-8">
          <header class="max-w-4xl">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-green-dark">
              01 · Project context
            </p>
            <h2 class="mt-4 text-4xl text-brown-dark sm:text-6xl">
              Designing beyond the room itself
            </h2>
            <p class="mt-6 max-w-3xl text-lg leading-relaxed text-brown-dark/75">
              During the COVID-19 response, King Chulalongkorn Memorial Hospital
              needed a new negative-pressure isolation-room environment. The
              project involved more than the physical space: staff routines,
              environmental conditions, monitoring information, equipment, and
              operating procedures all had to work together.
            </p>
            <p class="mt-4 max-w-3xl leading-relaxed text-brown-dark/70">
              My role sat between the people using the space and the teams
              responsible for designing and delivering it. I helped organize
              those different perspectives into a shared understanding of the
              project.
            </p>
          </header>

          <figure class="mt-10 overflow-hidden border border-brown-dark/15 bg-ivory">
            <img
              src={ContextImage.src}
              alt="Illustration of the isolation suite, with an ante room, a five-bed isolation room, a doffing room, and a monitoring station outside the room"
              class="h-auto w-full"
              loading="lazy"
            />
            <figcaption class="flex flex-col gap-1 border-t border-brown-dark/10 px-5 py-4 text-sm text-brown-dark/60 sm:flex-row sm:items-center sm:justify-between">
              <span>
                Project context · how the spaces relate to staff activities
              </span>
              <span>Conceptual illustration created for this case study</span>
            </figcaption>
          </figure>
        </section>

        <!-- 02 / CHALLENGE -->
        <section
          id="challenge"
          class="scroll-mt-8 border-t border-brown-dark/15 pt-12"
        >
          <header class="max-w-4xl">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-green-dark">
              02 · The challenge
            </p>
            <h2 class="mt-4 text-4xl text-brown-dark sm:text-6xl">
              Complex systems. Clear decisions for staff.
            </h2>
            <p class="mt-6 max-w-3xl text-lg leading-relaxed text-brown-dark/75">
              The project brought together clinical workflows and specialist
              building systems. Nurses needed to understand the room's condition
              and the system's operating state, while technical teams needed
              accurate requirements and coordinated information to deliver the
              environment.
            </p>
          </header>

          <h3 class="mt-10 text-2xl text-brown-dark">The staff perspective</h3>
          <div class="mt-5 grid gap-4 md:grid-cols-3">
            {userNeeds.map((need, index) => (
              <article class="border border-brown-dark/15 bg-ivory p-6 sm:p-7">
                <p class="text-xs font-semibold uppercase tracking-[0.15em] text-green-dark">
                  Need 0{index + 1}
                </p>
                <h4 class="mt-3 text-xl leading-snug text-brown-dark">
                  {need.title}
                </h4>
                <p class="mt-3 text-sm leading-relaxed text-brown-dark/70">
                  {need.description}
                </p>
              </article>
            ))}
          </div>

          <div class="mt-8 border-l-4 border-green-dark bg-green-light/30 p-6 sm:p-8">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-green-dark">
              Design challenge
            </p>
            <p class="mt-3 text-xl leading-relaxed text-brown-dark sm:text-2xl">
              How might we connect technical requirements and room operations
              into information and workflows that staff can understand, while
              keeping the project team aligned?
            </p>
          </div>
        </section>

        <!-- 03 / CONTRIBUTION -->
        <section
          id="contribution"
          class="scroll-mt-8 border-t border-brown-dark/15 pt-12"
        >
          <header class="max-w-4xl">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-green-dark">
              03 · My contribution
            </p>
            <h2 class="mt-4 text-4xl text-brown-dark sm:text-6xl">
              Three disciplines, one connected project
            </h2>
            <p class="mt-6 max-w-3xl text-lg leading-relaxed text-brown-dark/75">
              As Project Design Manager, I worked across project design,
              user-centred information planning, and coordination. My
              contribution was to clarify what the project needed, make the
              relationships easier to understand, and help the different teams
              work from consistent information.
            </p>
          </header>

          <div class="mt-10 space-y-5">
            {contributionAreas.map((area) => (
              <article class="grid gap-6 border border-brown-dark/15 bg-ivory p-6 sm:p-8 lg:grid-cols-[0.8fr_1.2fr] lg:gap-10">
                <div>
                  <p class="text-sm font-semibold text-green-dark">
                    {area.number} / {area.title}
                  </p>
                  <h3 class="mt-3 text-2xl leading-snug text-brown-dark">
                    {area.subtitle}
                  </h3>
                </div>
                <ul class="space-y-3 text-sm leading-relaxed text-brown-dark/75 sm:text-base">
                  {area.points.map((point) => (
                    <li class="flex gap-3">
                      <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-green-dark"></span>
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
              </article>
            ))}
          </div>

          <p class="mt-6 text-sm leading-relaxed text-brown-dark/60">
            The engineering team was responsible for the technical design,
            system programming, and implementation. My role focused on project
            design, requirements, workflows, information structure, and
            coordination.
          </p>
        </section>

        <!-- 04 / APPROACH -->
        <section
          id="approach"
          class="scroll-mt-8 border-t border-brown-dark/15 pt-12"
        >
          <header class="max-w-4xl">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-green-dark">
              04 · Design approach
            </p>
            <h2 class="mt-4 text-4xl text-brown-dark sm:text-6xl">
              From understanding to coordination
            </h2>
            <p class="mt-6 max-w-3xl text-lg leading-relaxed text-brown-dark/75">
              I moved from the overall project context toward the details staff
              and technical teams needed to discuss. This helped connect the
              physical environment, operational workflows, and monitoring
              information instead of treating them as separate pieces.
            </p>
          </header>

          <figure class="mt-10 overflow-hidden border border-brown-dark/15 bg-ivory">
            <img
              src={ProcessImage.src}
              alt="Four-part project design approach: understand the context, structure requirements, map workflows, and coordinate with the team"
              class="aspect-[1586/520] w-full object-cover object-center"
              loading="lazy"
            />
            <figcaption class="border-t border-brown-dark/10 px-5 py-3 text-sm text-brown-dark/60">
              Understand → Structure → Map → Coordinate
            </figcaption>
          </figure>

          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            <article class="border-t-2 border-green-dark/50 pt-5">
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-green-dark">
                Understand and structure
              </p>
              <h3 class="mt-2 text-xl text-brown-dark">
                Bring different requirements together
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-brown-dark/70">
                Gather the project context and organize clinical, spatial, and
                technical information into clear themes.
              </p>
            </article>
            <article class="border-t-2 border-green-dark/50 pt-5">
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-green-dark">
                Map and coordinate
              </p>
              <h3 class="mt-2 text-xl text-brown-dark">
                Make relationships visible
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-brown-dark/70">
                Use diagrams and workflow documentation to communicate how
                people, spaces, equipment, and system states relate.
              </p>
            </article>
          </div>
        </section>

        <!-- 05 / DECISIONS -->
        <section
          id="decisions"
          class="scroll-mt-8 border-t border-brown-dark/15 pt-12"
        >
          <header class="max-w-4xl">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-green-dark">
              05 · Key design decisions
            </p>
            <h2 class="mt-4 text-4xl text-brown-dark sm:text-6xl">
              Make the system easier to understand
            </h2>
            <p class="mt-6 max-w-3xl text-lg leading-relaxed text-brown-dark/75">
              I used a user-centred lens to organize the system information.
              These decisions shaped the way the project was explained and
              documented for discussion across the team.
            </p>
          </header>

          <div class="mt-10 space-y-14">
            {designDecisions.map((decision) => (
              <article>
                <p class="text-xs font-semibold uppercase tracking-[0.16em] text-green-dark">
                  Decision {decision.number}
                </p>
                <h3 class="mt-2 text-2xl text-brown-dark sm:text-3xl">
                  {decision.title}
                </h3>
                <p class="mt-3 max-w-3xl leading-relaxed text-brown-dark/70">
                  {decision.description}
                </p>
                <figure class="mt-5 overflow-hidden border border-brown-dark/15 bg-ivory">
                  <img
                    src={decision.image.src}
                    alt={decision.imageAlt}
                    class:list={["w-full", decision.imageClass ?? "h-auto"]}
                    loading="lazy"
                  />
                  <figcaption class="border-t border-brown-dark/10 px-5 py-3 text-sm text-brown-dark/60">
                    {decision.caption}
                  </figcaption>
                </figure>
              </article>
            ))}
          </div>

          <p class="mt-8 text-sm leading-relaxed text-brown-dark/55">
            These diagrams are portfolio-level explanations of the project. They
            are not intended to replace the hospital's technical documentation
            or operating procedures.
          </p>
        </section>

        <!-- 06 / OUTCOME -->
        <section
          id="outcome"
          class="scroll-mt-8 border-t border-brown-dark/15 pt-12"
        >
          <header class="max-w-4xl">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-green-dark">
              06 · Project outcome
            </p>
            <h2 class="mt-4 text-4xl text-brown-dark sm:text-6xl">
              A delivered environment, supported by clearer information
            </h2>
            <p class="mt-6 max-w-3xl text-lg leading-relaxed text-brown-dark/75">
              The project progressed from design and construction through
              commissioning. My contribution helped connect the room
              requirements, staff-facing monitoring needs, operating-mode
              documentation, and team coordination into a shared project
              reference.
            </p>
          </header>

          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            <article class="border border-brown-dark/15 bg-ivory p-6 sm:p-7">
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-green-dark">
                Project delivery
              </p>
              <h3 class="mt-3 text-2xl text-brown-dark">
                75-day project timeline
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-brown-dark/70">
                The project moved from construction to commissioning within the
                documented project period.
              </p>
            </article>
            <article class="border border-brown-dark/15 bg-ivory p-6 sm:p-7">
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-green-dark">
                Operational reference
              </p>
              <h3 class="mt-3 text-2xl text-brown-dark">
                A monitoring view for staff
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-brown-dark/70">
                The delivered interface brought room readings, room locations,
                equipment status, and system mode into one monitoring view.
              </p>
            </article>
          </div>

          <h3 class="mt-12 text-2xl text-brown-dark">
            Requirements brought together
          </h3>
          <p class="mt-2 max-w-3xl leading-relaxed text-brown-dark/70">
            Through discussions with nurses and the project team, the monitoring
            requirements covered several connected areas. My role was to help
            organize these needs and communicate them clearly across the
            project—not to design or program the final monitoring interface.
          </p>

          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            <article class="border border-brown-dark/15 bg-ivory p-6">
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-green-dark">
                Room environment
              </p>
              <h4 class="mt-2 text-xl text-brown-dark">
                Conditions and room locations
              </h4>
              <p class="mt-2 text-sm leading-relaxed text-brown-dark/70">
                Temperature, humidity, pressure, and the relationship between
                readings and the ante room, isolation room, and doffing room.
              </p>
            </article>
            <article class="border border-brown-dark/15 bg-ivory p-6">
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-green-dark">
                System information
              </p>
              <h4 class="mt-2 text-xl text-brown-dark">
                Equipment and operating state
              </h4>
              <p class="mt-2 text-sm leading-relaxed text-brown-dark/70">
                Equipment status, air-change information, filter information,
                and whether the system was in AUTO, OFF, or MANUAL mode.
              </p>
            </article>
          </div>
        </section>

        <!-- 07 / REFLECTION -->
        <section
          id="reflection"
          class="scroll-mt-8 border-t border-brown-dark/15 pt-12"
        >
          <header class="max-w-4xl">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-green-dark">
              07 · Reflection
            </p>
            <h2 class="mt-4 text-4xl text-brown-dark sm:text-6xl">
              Good design connects people, information, and delivery
            </h2>
            <p class="mt-6 max-w-3xl text-lg leading-relaxed text-brown-dark/75">
              This project strengthened the way I approach design: start by
              understanding the people and context, make complex relationships
              visible, and keep decisions clear for everyone involved. It also
              shaped how I think about UX/UI design—not only as the design of
              screens, but as the design of information, workflows, and the
              experience around a system.
            </p>
          </header>

          <div class="mt-10 grid gap-4 md:grid-cols-3">
            <article class="border border-brown-dark/15 bg-ivory p-6">
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-green-dark">
                UX/UI design
              </p>
              <h3 class="mt-3 text-xl text-brown-dark">
                Design around user needs
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-brown-dark/70">
                Prioritize what people need to know, do, and understand.
              </p>
            </article>
            <article class="border border-brown-dark/15 bg-ivory p-6">
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-green-dark">
                Project design
              </p>
              <h3 class="mt-3 text-xl text-brown-dark">
                Connect the whole system
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-brown-dark/70">
                Bring spaces, workflows, requirements, and technical elements
                into one view.
              </p>
            </article>
            <article class="border border-brown-dark/15 bg-ivory p-6">
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-green-dark">
                Project management
              </p>
              <h3 class="mt-3 text-xl text-brown-dark">
                Create shared understanding
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-brown-dark/70">
                Use clear communication and documentation to help teams stay
                aligned.
              </p>
            </article>
          </div>

          <div class="mt-10 flex flex-col items-start justify-between gap-7 bg-brown-dark px-6 py-10 text-white sm:px-10 md:flex-row md:items-center">
            <div>
              <p class="text-sm font-semibold uppercase tracking-[0.18em] text-green-light">
                Project takeaway
              </p>
              <h3 class="mt-3 text-3xl !text-white">
                Make complexity clear—for the people who use it and the people
                who deliver it.
              </h3>
            </div>
            <a
              href="/projects/"
              class="inline-flex shrink-0 border-b border-white pb-1 font-semibold text-white"
            >
              Explore more projects ➹
            </a>
          </div>
        </section>
      </div>
    </section>
  </main>
</ProjectDetailLayout>

