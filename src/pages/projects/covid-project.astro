---
import ProjectDetailLayout from "../../layouts/ProjectDetailLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ProjectDetailHero from "../../components/ProjectDetailHero.astro";
import ProjectOverview from "../../components/ProjectOverview.astro";

import IcuCover from "../../assets/hero/icu-cover.svg";
import ContextImage from "../../assets/covid/context-overview.svg";
import ContributionImage from "../../assets/covid/contribution.svg";
import RequirementsImage from "../../assets/covid/requirements.svg";
import SystemImage from "../../assets/covid/system-relationship.svg";
import ModeImage from "../../assets/covid/mode-workflow.svg";
import AutoImage from "../../assets/covid/auto-cycle.svg";
import ManualImage from "../../assets/covid/manual-fallback.svg";
import ProcessImage from "../../assets/covid/design-journey.svg";
import OutcomeImage from "../../assets/covid/outcome-interface.svg";

const navItems = [
  { number: "01", label: "The story behind it", href: "#story" },
  { number: "02", label: "Project context", href: "#context" },
  { number: "03", label: "My contribution", href: "#contribution" },
  { number: "04", label: "Understanding needs", href: "#needs" },
  { number: "05", label: "Making sense of the system", href: "#system" },
  { number: "06", label: "How it works", href: "#workflows" },
  { number: "07", label: "My approach", href: "#approach" },
  { number: "08", label: "Challenges", href: "#challenges" },
  { number: "09", label: "Outcome", href: "#outcome" },
];

const challengeCards = [
  {
    number: "01",
    title: "Connecting information across the project",
    detail:
      "The room, environmental conditions, equipment, and staff operation could easily become separate lists. I grouped them into a requirements framework first, then showed how they connect in the system overview.",
  },
  {
    number: "02",
    title: "Explaining different operating states",
    detail:
      "AUTO, OFF, and MANUAL have different meanings. I used a mode-selection view to show the three outcomes, followed by separate workflows for normal operation and the documented manual path.",
  },
  {
    number: "03",
    title: "Keeping the staff perspective visible",
    detail:
      "Rather than presenting the system only as equipment, I organized the diagrams around what staff need to review and monitor, and how the operating information relates to the room.",
  },
];

---

<ProjectDetailLayout title="COVID-19 ICU Monitoring — Joy" active="projects">
  <main class="w-full">
    <div class="py-5 sm:py-7">
      <Breadcrumb
        items={[
          { label: "Projects", href: "/projects/" },
          { label: "COVID-19 ICU Monitoring", href: "/projects/covid-project/" },
        ]}
      />
    </div>

    <ProjectDetailHero
      eyebrow="Project design case study"
      title="COVID-19 ICU Monitoring"
      description="A project-design case study for an isolation room at King Chulalongkorn Memorial Hospital: turning project requirements into clear workflows and documentation for the staff who use the room."
      imageSrc={IcuCover.src}
      imageScale="scale-100"
      imageAlt="Illustrated cutaway of an isolation room with a monitoring interface and environmental system elements"
      categories={["Project Management"]}
      role="Project Design Manager"
    />

    <div id="overview" class="scroll-mt-8">
      <ProjectOverview
        durationLabel="Project"
        duration="75 days (including construction)"
        role="Project Design Manager"
        responsibilities={[
          "Structuring room and system requirements",
          "Mapping staff-facing and system workflows",
          "Preparing diagrams and project documentation for coordination",
        ]}
        challenges={[
          "Connect the room, equipment, monitoring, and staff needs in one clear project view",
          "Explain the different operating states without combining unlike workflows",
          "Keep the documentation understandable without losing important distinctions",
        ]}
        solutions={[
          "Grouped the brief into four reviewable requirement themes",
          "Mapped the relationship between staff, monitoring, equipment, and room conditions",
          "Created separate explanatory views for mode selection, AUTO, and MANUAL",
        ]}
      />
    </div>

    <section class="grid gap-10 py-14 sm:py-20 lg:grid-cols-[240px_1fr] lg:gap-16">
      <aside class="hidden lg:block">
        <div class="sticky top-28">
          <h3 class="mb-4 text-sm font-semibold uppercase tracking-[0.18em] text-green-dark">
            Project design process
          </h3>
          <nav aria-label="COVID-19 project case study sections">
            <ol class="border-y border-brown-dark/15">
              {navItems.map((item, index) => (
                <li>
                  <a
                    href={item.href}
                    data-covid-nav
                    data-section={item.href.slice(1)}
                    aria-current={index === 0 ? "location" : undefined}
                    class="group grid grid-cols-[32px_1fr] gap-3 border-b border-brown-dark/15 px-3 py-4 text-sm text-brown-dark/65 transition hover:bg-brown-medium/45 hover:text-brown-dark aria-[current=location]:bg-brown-dark aria-[current=location]:font-semibold aria-[current=location]:text-white"
                  >
                    <span class="font-semibold text-green-dark group-aria-[current=location]:text-green-light">{item.number}</span>
                    <span>{item.label}</span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        </div>
      </aside>

      <div class="min-w-0 space-y-20 sm:space-y-28">
        <!-- 01 / STORY -->
        <section id="story" class="scroll-mt-8">
          <header class="max-w-4xl">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-green-dark">01 · The story behind the project</p>
            <h2 class="mt-4 text-4xl text-brown-dark sm:text-6xl">Where my move into digital design began</h2>
            <p class="mt-6 max-w-2xl text-lg leading-relaxed text-brown-dark/75">
              During COVID-19, I helped prepare hospital spaces for patients and improve workflows for doctors and nurses. It showed me how much thoughtful design affects people, and this project inspired my move into digital design.
            </p>
          </header>

          <div class="mt-10 grid gap-4 md:grid-cols-3">
            <article class="border border-brown-dark/15 bg-ivory p-6">
              <p class="text-xs font-semibold uppercase tracking-[0.15em] text-green-dark">The context</p>
              <h3 class="mt-3 text-xl text-brown-dark">A hospital adapting to a pandemic</h3>
              <p class="mt-2 text-sm leading-relaxed text-brown-dark/70">Spaces prepared for patients, and better workflows for doctors and nurses.</p>
            </article>
            <article class="border border-brown-dark/15 bg-ivory p-6">
              <p class="text-xs font-semibold uppercase tracking-[0.15em] text-green-dark">What I brought</p>
              <h3 class="mt-3 text-xl text-brown-dark">Architecture and project design</h3>
              <p class="mt-2 text-sm leading-relaxed text-brown-dark/70">Thinking in space, requirements and the needs of the people using the room.</p>
            </article>
            <article class="border border-brown-dark/15 bg-ivory p-6">
              <p class="text-xs font-semibold uppercase tracking-[0.15em] text-green-dark">What it changed</p>
              <h3 class="mt-3 text-xl text-brown-dark">From physical spaces to digital experiences</h3>
              <p class="mt-2 text-sm leading-relaxed text-brown-dark/70">Design could improve digital experiences, not only physical spaces.</p>
            </article>
          </div>

          <div class="mt-8 border-l-2 border-green-dark bg-green-light/35 px-5 py-4">
            <h3 class="font-semibold text-brown-dark">My role in this project</h3>
            <p class="mt-2 leading-relaxed text-brown-dark/70">
              My part was project design: requirements, workflows and documentation. The system itself was delivered with engineers and the wider project team.
            </p>
          </div>
        </section>

        <!-- 02 / CONTEXT -->
        <section id="context" class="scroll-mt-8">
          <header class="max-w-4xl">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-green-dark">02 · Project context</p>
            <h2 class="mt-4 text-4xl text-brown-dark sm:text-6xl">A room is more than the space around it</h2>
            <p class="mt-6 max-w-3xl text-lg leading-relaxed text-brown-dark/75">
              The project brought together the physical room, environmental conditions, supporting equipment, and the information staff needed to monitor. Before focusing on individual components, I looked at how these parts related to one another. This gave the project a clear starting point for organizing requirements and explaining the system from the staff perspective.
            </p>
          </header>

          <figure class="mt-10 overflow-hidden border border-brown-dark/15 bg-ivory">
            <img src={ContextImage.src} alt="Conceptual room plan and project design considerations" class="h-auto w-full" loading="lazy" />
            <figcaption class="flex flex-col gap-1 border-t border-brown-dark/10 px-5 py-4 text-sm text-brown-dark/60 sm:flex-row sm:items-center sm:justify-between">
              <span>Project context · the room as a connected environment</span>
              <span>Conceptual illustration created for this case study</span>
            </figcaption>
          </figure>

          <div class="mt-8 grid gap-px border border-brown-dark/15 bg-brown-dark/15 sm:grid-cols-3">
            <article class="bg-ivory p-6">
              <p class="text-xs font-semibold uppercase tracking-[0.15em] text-green-dark">Project setting</p>
              <h3 class="mt-3 text-xl text-brown-dark">Hospital facility</h3>
              <p class="mt-2 text-sm leading-relaxed text-brown-dark/65">King Chulalongkorn Memorial Hospital (KCMH), Bangkok, Thailand</p>
            </article>
            <article class="bg-cream p-6">
              <p class="text-xs font-semibold uppercase tracking-[0.15em] text-green-dark">Project area</p>
              <h3 class="mt-3 text-xl text-brown-dark">Room 208</h3>
              <p class="mt-2 text-sm leading-relaxed text-brown-dark/65">Chongkolnee Wattanawong Building</p>
            </article>
            <article class="bg-ivory p-6">
              <p class="text-xs font-semibold uppercase tracking-[0.15em] text-green-dark">My focus</p>
              <h3 class="mt-3 text-xl text-brown-dark">Project design</h3>
              <p class="mt-2 text-sm leading-relaxed text-brown-dark/65">Requirements · workflows · coordination</p>
            </article>
          </div>
        </section>

        <!-- 03 / CONTRIBUTION -->
        <section id="contribution" class="scroll-mt-8 border-t border-brown-dark/15 pt-12">
          <header class="grid gap-6 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
            <div>
              <p class="text-sm font-semibold uppercase tracking-[0.18em] text-green-dark">03 · My contribution</p>
              <h2 class="mt-4 text-4xl text-brown-dark sm:text-6xl">My role was to connect the brief, the people, and the project team</h2>
            </div>
            <p class="max-w-xl text-lg leading-relaxed text-brown-dark/75">
              My contribution sat between the project brief and the technical work that followed. I organized the requirements, mapped the main user and system workflows, and prepared design documentation to make the project easier to understand, review, and coordinate.
            </p>
          </header>

          <figure class="mt-10 overflow-hidden border border-brown-dark/15 bg-ivory">
            <img src={ContributionImage.src} alt="Three-part diagram showing my contribution across requirements, workflows, and coordination" class="h-auto w-full" loading="lazy" />
            <figcaption class="border-t border-brown-dark/10 px-5 py-3 text-sm text-brown-dark/60">My contribution · requirements  workflows  coordination</figcaption>
          </figure>

          <div class="mt-8 grid gap-4 md:grid-cols-3">
            <article class="border border-brown-dark/15 bg-ivory p-6">
              <span class="text-sm font-semibold text-green-dark">01 / Understand</span>
              <h3 class="mt-4 text-2xl text-brown-dark">Gather the needs</h3>
              <p class="mt-3 text-sm leading-relaxed text-brown-dark/70">Review the project brief and bring the room, environmental, and operational needs into one structured view.</p>
            </article>
            <article class="border border-brown-dark/15 bg-ivory p-6">
              <span class="text-sm font-semibold text-brown-light">02 / Translate</span>
              <h3 class="mt-4 text-2xl text-brown-dark">Map the experience</h3>
              <p class="mt-3 text-sm leading-relaxed text-brown-dark/70">Translate the documented operating modes into clear paths, with the staff interaction and system response shown separately.</p>
            </article>
            <article class="border border-brown-dark/15 bg-ivory p-6">
              <span class="text-sm font-semibold text-pink">03 / Align</span>
              <h3 class="mt-4 text-2xl text-brown-dark">Support coordination</h3>
              <p class="mt-3 text-sm leading-relaxed text-brown-dark/70">Prepare diagrams and structured documentation that give the project team a shared reference for discussion and coordination.</p>
            </article>
          </div>
        </section>

        <!-- 04 / NEEDS -->
        <section id="needs" class="scroll-mt-8 border-t border-brown-dark/15 pt-12">
          <header class="max-w-4xl">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-green-dark">04 · Understanding the needs</p>
            <h2 class="mt-4 text-4xl text-brown-dark sm:text-6xl">Four themes helped me make sense of the brief</h2>
            <p class="mt-6 max-w-3xl text-lg leading-relaxed text-brown-dark/75">
              The brief covered several connected areas, so presenting every item as one long checklist would make the overall picture difficult to scan. I grouped the requirements into four themes: room conditions, supporting air and filtration systems, staff operation, and operational continuity. This structure made each area easier to review while keeping the wider purpose of the system in view.
            </p>
          </header>

          <figure class="mt-10 overflow-hidden border border-brown-dark/15 bg-ivory">
            <img src={RequirementsImage.src} alt="Four-part requirements framework for room conditions, air quality and filtration, staff operation, and operational continuity" class="h-auto w-full" loading="lazy" />
            <figcaption class="border-t border-brown-dark/10 px-5 py-3 text-sm text-brown-dark/60">Requirements framework · grouped around the needs of the project</figcaption>
          </figure>

          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            <article class="border border-brown-dark/15 bg-green-light/40 p-6 sm:p-8">
              <span class="text-sm font-semibold text-green-dark">01 / Environment</span>
              <h3 class="mt-5 text-2xl text-brown-dark">Room conditions</h3>
              <p class="mt-3 leading-relaxed text-brown-dark/75">Understand the environmental conditions that need to be monitored, including temperature, humidity, and pressure.</p>
            </article>
            <article class="border border-brown-dark/15 bg-accent-blue/10 p-6 sm:p-8">
              <span class="text-sm font-semibold text-brown-light">02 / Support systems</span>
              <h3 class="mt-5 text-2xl text-brown-dark">Air quality and filtration</h3>
              <p class="mt-3 leading-relaxed text-brown-dark/75">Consider the ventilation and filtration equipment that supports the room environment.</p>
            </article>
            <article class="border border-brown-dark/15 bg-pink/10 p-6 sm:p-8">
              <span class="text-sm font-semibold text-pink">03 / People</span>
              <h3 class="mt-5 text-2xl text-brown-dark">Staff operation</h3>
              <p class="mt-3 leading-relaxed text-brown-dark/75">Make system status, operating modes, and the available controls understandable to the people using them.</p>
            </article>
            <article class="border border-brown-dark/15 bg-cream/70 p-6 sm:p-8">
              <span class="text-sm font-semibold text-green-dark">04 / Continuity</span>
              <h3 class="mt-5 text-2xl text-brown-dark">Operational continuity</h3>
              <p class="mt-3 leading-relaxed text-brown-dark/75">Account for the documented manual operating option and communicate that it is not identical to normal automatic operation.</p>
            </article>
          </div>
        </section>

        <!-- 05 / SYSTEM -->
        <section id="system" class="scroll-mt-8 border-t border-brown-dark/15 pt-12">
          <header class="max-w-4xl">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-green-dark">05 · Making sense of the system</p>
            <h2 class="mt-4 text-4xl text-brown-dark sm:text-6xl">I started with the people, not just the equipment</h2>
            <p class="mt-6 max-w-3xl text-lg leading-relaxed text-brown-dark/75">
              I wanted the system view to explain the relationships before introducing component-level detail. I organized it around a simple reading order: the staff who need the information, the monitoring and control layer, the connected equipment, and the room conditions being monitored. This helped shift the diagram from a list of equipment to a view of how the parts fit together.
            </p>
          </header>

          <figure class="mt-10 overflow-hidden border border-brown-dark/15 bg-ivory">
            <img src={SystemImage.src} alt="High-level relationship map connecting hospital staff, monitoring, control layer, equipment, and room conditions" class="h-auto w-full" loading="lazy" />
            <figcaption class="border-t border-brown-dark/10 px-5 py-3 text-sm text-brown-dark/60">System relationship · a simplified view for project communication</figcaption>
          </figure>

          <div class="mt-8 grid gap-4 md:grid-cols-3">
            <article class="bg-green-light/50 p-6">
              <p class="text-xs font-semibold uppercase tracking-wider text-green-dark">People</p>
              <h3 class="mt-3 text-2xl text-brown-dark">Hospital staff</h3>
              <p class="mt-3 text-sm leading-relaxed text-brown-dark/70">The people who need to understand the room status and use the documented controls.</p>
            </article>
            <article class="bg-accent-blue/10 p-6">
              <p class="text-xs font-semibold uppercase tracking-wider text-brown-light">Information and control</p>
              <h3 class="mt-3 text-2xl text-brown-dark">Monitoring and control layer</h3>
              <p class="mt-3 text-sm leading-relaxed text-brown-dark/70">The interface presents system information while the controller manages programmed operation.</p>
            </article>
            <article class="bg-pink/10 p-6">
              <p class="text-xs font-semibold uppercase tracking-wider text-pink">Environment</p>
              <h3 class="mt-3 text-2xl text-brown-dark">Connected equipment</h3>
              <p class="mt-3 text-sm leading-relaxed text-brown-dark/70">Ventilation, filtration, and related equipment support the monitored room environment.</p>
            </article>
          </div>
        </section>

        <!-- 06 / WORKFLOWS -->
        <section id="workflows" class="scroll-mt-8 border-t border-brown-dark/15 pt-12">
          <header class="max-w-4xl">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-green-dark">06 · How it works</p>
            <h2 class="mt-4 text-4xl text-brown-dark sm:text-6xl">Making the operating modes easier to follow</h2>
            <p class="mt-6 max-w-3xl text-lg leading-relaxed text-brown-dark/75">
              The operating modes were not interchangeable, so I avoided combining them into one generic flow. I first showed the selector and its three possible states, then gave AUTO and MANUAL their own explanations. This makes the normal operating cycle easier to follow while keeping the documented fallback path distinct. The diagrams summarize the project documentation; they are not instructions for operating hospital equipment.
            </p>
          </header>

          <div class="mt-10 space-y-12">
            <article>
              <div class="mb-4">
                <p class="text-xs font-semibold uppercase tracking-[0.16em] text-green-dark">Flow 01 · Mode selection</p>
                <h3 class="mt-2 text-2xl text-brown-dark">One selector, three different outcomes</h3>
                <p class="mt-2 max-w-3xl text-sm leading-relaxed text-brown-dark/65">I showed AUTO, OFF, and MANUAL as three separate outcomes from the selector. This makes the state change clear at the point where someone needs to understand which operating path is selected.</p>
              </div>
              <figure class="overflow-hidden border border-brown-dark/15 bg-ivory">
                <img src={ModeImage.src} alt="Mode selection diagram branching into AUTO, OFF, and MANUAL" class="h-auto w-full" loading="lazy" />
                <figcaption class="border-t border-brown-dark/10 px-5 py-3 text-sm text-brown-dark/60">Mode selection · based on the operating modes described in the project manual</figcaption>
              </figure>
            </article>

            <article>
              <div class="mb-4">
                <p class="text-xs font-semibold uppercase tracking-[0.16em] text-green-dark">Flow 02 · Normal operation</p>
                <h3 class="mt-2 text-2xl text-brown-dark">AUTO: a cycle of operation and monitoring</h3>
                <p class="mt-2 max-w-3xl text-sm leading-relaxed text-brown-dark/65">I presented AUTO as a repeating sequence rather than a one-way checklist: select the mode, review the status, allow the programmed operation to run, and continue monitoring. The return path communicates that monitoring is ongoing, not a final step.</p>
              </div>
              <figure class="overflow-hidden border border-brown-dark/15 bg-ivory">
                <img src={AutoImage.src} alt="AUTO mode cycle showing mode selection, status review, programmed system operation, monitoring, and continued operation" class="h-auto w-full" loading="lazy" />
                <figcaption class="border-t border-brown-dark/10 px-5 py-3 text-sm text-brown-dark/60">AUTO operation · a simplified explanatory workflow</figcaption>
              </figure>
            </article>

            <article>
              <div class="mb-4">
                <p class="text-xs font-semibold uppercase tracking-[0.16em] text-green-dark">Flow 03 · Fallback operation</p>
                <h3 class="mt-2 text-2xl text-brown-dark">MANUAL: a separate path with clear limitations</h3>
                <p class="mt-2 max-w-3xl text-sm leading-relaxed text-brown-dark/65">The project documentation describes a local manual option for situations when automatic control is unavailable. I kept this path separate and highlighted its limitations so the visual explanation would not imply that MANUAL provides the same functions as AUTO.</p>
              </div>
              <figure class="overflow-hidden border border-brown-dark/15 bg-ivory">
                <img src={ManualImage.src} alt="MANUAL fallback flow with local selector, documented switches, room observation, and a note about limitations" class="h-auto w-full" loading="lazy" />
                <figcaption class="border-t border-brown-dark/10 px-5 py-3 text-sm text-brown-dark/60">MANUAL fallback · simplified from the supplied operating documentation</figcaption>
              </figure>
            </article>
          </div>

          <p class="mt-8 border-l-2 border-pink bg-pink/10 p-5 text-sm leading-relaxed text-brown-dark/70">
            These portfolio diagrams are explanatory summaries, not approved hospital operating instructions. Staff must follow the hospital's current procedures and direction from the responsible technical team.
          </p>
        </section>

        <!-- 07 / APPROACH -->
        <section id="approach" class="scroll-mt-8 border-t border-brown-dark/15 pt-12">
          <header class="max-w-4xl">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-green-dark">07 · My approach</p>
            <h2 class="mt-4 text-4xl text-brown-dark sm:text-6xl">A structured process, with clarity at every step</h2>
            <p class="mt-6 max-w-3xl text-lg leading-relaxed text-brown-dark/75">
              I worked from the broad context toward the details: first understanding the room and its purpose, then grouping the requirements, mapping the staff and system workflows, and organizing the information into documentation. This sequence helped me move from a complex brief to a set of clear, connected views.
            </p>
          </header>

          <figure class="mt-10 overflow-hidden border border-brown-dark/15 bg-ivory">
            <img src={ProcessImage.src} alt="Four-step project design process: understand, structure, map, and coordinate" class="h-auto w-full" loading="lazy" />
            <figcaption class="border-t border-brown-dark/10 px-5 py-3 text-sm text-brown-dark/60">My project design approach · from understanding to coordination</figcaption>
          </figure>

          <div class="mt-8 grid gap-4 md:grid-cols-3">
            <article class="border border-brown-dark/15 bg-ivory p-6">
              <span class="text-sm font-semibold text-green-dark">Design decision 01</span>
              <h3 class="mt-3 text-xl text-brown-dark">Use hierarchy before detail</h3>
              <p class="mt-2 text-sm leading-relaxed text-brown-dark/70">I started with the room and system context, moved into requirement groups, and then explained individual workflows. The sequence gives readers the overall picture before introducing detail.</p>
            </article>
            <article class="border border-brown-dark/15 bg-ivory p-6">
              <span class="text-sm font-semibold text-green-dark">Design decision 02</span>
              <h3 class="mt-3 text-xl text-brown-dark">Separate different states</h3>
              <p class="mt-2 text-sm leading-relaxed text-brown-dark/70">I showed AUTO, OFF, and MANUAL as distinct states, then gave the normal and fallback paths their own explanations. This avoids suggesting that the modes work in the same way.</p>
            </article>
            <article class="border border-brown-dark/15 bg-ivory p-6">
              <span class="text-sm font-semibold text-green-dark">Design decision 03</span>
              <h3 class="mt-3 text-xl text-brown-dark">Keep language consistent</h3>
              <p class="mt-2 text-sm leading-relaxed text-brown-dark/70">I used concise labels and consistent terms across the diagrams. I also separated actions, system states, and supporting explanations to make each workflow easier to scan.</p>
            </article>
          </div>
        </section>

        <!-- 08 / CHALLENGES -->
        <section id="challenges" class="scroll-mt-8 border-t border-brown-dark/15 pt-12">
          <header class="max-w-4xl">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-green-dark">08 · Challenges and decisions</p>
            <h2 class="mt-4 text-4xl text-brown-dark sm:text-6xl">Clarity was the design challenge</h2>
            <p class="mt-6 max-w-3xl text-lg leading-relaxed text-brown-dark/75">
              The main design challenge was making a connected, technical system understandable without flattening it into an oversimplified diagram. I needed to preserve the important relationships while giving each part enough space to be understood on its own.
            </p>
          </header>

          <div class="mt-10 space-y-4">
            {challengeCards.map((item) => (
              <article class="grid gap-4 border border-brown-dark/15 bg-ivory p-6 sm:grid-cols-[56px_0.85fr_1.15fr] sm:gap-6 sm:p-8">
