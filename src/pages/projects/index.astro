---
import Button from "../../components/Button.astro";
import ContentLayout from "../../layouts/ContentLayout.astro";

import Image1 from "../../assets/hero/7van.png";
import Image2 from "../../assets/hero/ippon.png";
import Image4 from "../../assets/hero/matchday.png";

import Tag from "../../components/Tag.astro";
import Filter from "../../components/Filter.astro";
import ProjectCard from "../../components/ProjectCard.astro";

const { title = "Projects — Joy" } = Astro.props;
---

<ContentLayout title={title}>

  <!-- ================================= -->
  <!-- FEATURED PROJECT -->
  <!-- ================================= -->

  <section id="awarded-project" class="w-full">
    <div
      class="
        max-w-6xl
        mx-auto
        px-6
        py-16
        md:py-20
        grid
        grid-cols-1
        lg:grid-cols-2
        items-center
        gap-12
        lg:gap-20
      "
    >
      <!-- LEFT -->
      <div class="flex flex-col items-start gap-5">
        <span class="bg-black text-white px-3 py-1 text-lg font-medium rounded-sm">Awarded Project</span>
        
        <h1 class="text-4xl md:text-5xl font-medium">
          7VAN
        </h1>
        <Tag category="UX/UI Design" />

        <p
          class="
            max-w-md
            text-gray-dark
            font-mono
            text-sm
            leading-relaxed
          "
        >
          A responsive website for 7VAN, a Brazilian Jiu-Jitsu academy,
          designed to attract new members and encourage sign-ups.
        </p>

        <Button
          href="/projects/7-van"
          variant="primary"
          size="md"
        >
          Explore my Projects
        </Button>
      </div>

      <!-- RIGHT -->
      <div
        class="
          w-full
          flex
          items-center
          justify-center
        "
      >
        <img
          src={Image1.src}
          alt="7VAN project"
          class="
            w-full
            max-w-[560px]
            h-auto
            object-contain
          "
        />
      </div>
    </div>
  </section>


  <!-- ================================= -->
  <!-- PROJECTS INTRO -->
  <!-- ================================= -->

  <section class="w-full">
    <div
      class="
        max-w-6xl
        mx-auto
        px-6
        py-14
        md:py-16
        grid
        grid-cols-1
        md:grid-cols-2
        gap-8
        md:gap-12
        items-center
        bg-brown
      "
    >
      <h2
        class="
          text-4xl
          md:text-5xl
          font-normal
        "
      >
        Projects
      </h2>

      <p
        class="
          max-w-md
          text-gray-dark
          font-mono
          text-sm
          leading-relaxed
        "
      >
        A cross-disciplinary body of work spanning UI/UX design,
        web development, and architectural project design — unified
        by a commitment to clarity and craft.
      </p>
    </div>
  </section>


  <!-- ================================= -->
  <!-- ALL PROJECTS -->
  <!-- ================================= -->

  <section id="all-projects" class="w-full">
    <div
      class="
        max-w-6xl
        mx-auto
        px-6
        py-14
        md:py-16
        flex
        flex-col
        gap-10
      "
    >

      <!-- ================================= -->
      <!-- FILTER ROW -->
      <!-- ================================= -->

      <div
        class="
          flex
          flex-col
          md:flex-row
          md:items-center
          md:justify-between
          gap-5
        "
      >
        <!-- LEFT FILTER -->
        <Filter selectedCategory="all" />

        <!-- RIGHT CONTROLS -->
        <div class="flex items-center gap-3">

          <!-- Grid Icon -->
          <button
            type="button"
            aria-label="Grid view"
            class="
              grid
              grid-cols-2
              gap-[3px]
              w-7
              h-7
              p-1
            "
          >
            <span class="bg-black"></span>
            <span class="bg-black"></span>
            <span class="bg-black"></span>
            <span class="bg-black"></span>
          </button>

          <!-- Sort -->
          <button
            type="button"
            class="
              rounded-full
              bg-[#1F1F1F]
              text-white
              px-5
              py-2.5
              text-sm
              font-medium
              transition
              hover:opacity-80
            "
          >
            Sort by Date
          </button>
        </div>
      </div>


      <!-- ================================= -->
      <!-- PROJECT CARD GRID -->
      <!-- ================================= -->

      <div
        class="
          grid
          grid-cols-1
          sm:grid-cols-2
          lg:grid-cols-3
          gap-x-6
          gap-y-8
          items-stretch
          w-full
        "
      >
        <ProjectCard
          title="7Van"
          description="A responsive website for a Brazilian Jiu-Jitsu academy, designed to attract new members and encourage sign-ups."
          imageSrc={Image1.src}
          imageAlt="7VAN"
          category="UX/UI Design"
          projectLink="/projects/7-van"
        />

        <ProjectCard
          title="Ippon App"
          description="A social media application for karate practitioners, featuring karate-focused content and community."
          imageSrc={Image2.src}
          imageAlt="Ippon"
          category="UX/UI Design"
          projectLink="/projects/ippon"
        />

        <ProjectCard
          title="Match Day"
          description="A sports analytics platform for football enthusiasts."
          imageSrc={Image4.src}
          imageAlt="Match Day"
          category="Web Development"
          projectLink="/projects/match-day"
        />
      </div>

    </div>
  </section>
  <section id="about-me" class="w-full">

    
  </section>

</ContentLayout>