---

<ContentLayout title={title} active="projects">
  <main
    class="flex
      w-full
      flex-col
      items-start
      justify-start
      gap-4
      py-4
      md:py-6
      lg:flex-row
      lg:gap-12"
  >
    <!-- Left side: heading and filter -->
    <aside
      id="projects-header"
      class="z-10
        flex
        w-full
        flex-col
        items-start
        gap-4
        lg:sticky
        lg:top-[calc(50px+4rem)]
        lg:h-[calc(100dvh-50px-5rem)]
        lg:w-64
        lg:shrink-0
        mt-0
        lg:mt-0"
    >
      <h2
        class="text-4xl
          tracking-tight
          text-brown-dark
          md:text-5xl
          lg:text-6xl
          lg:[@media(max-height:860px)]:text-5xl"
      >
        My Projects
      </h2>

      <Filter />
      <AvatarSection />
    </aside>

    <!-- Right side: project content -->
    <div class="flex flex-col w-full min-w-0 gap-4 px-4 md:px-0">
      <!-- Only visible when All is selected -->
      <div
        id="award-section"
        data-award-section
        class="flex flex-col w-full justify-center gap-4"
      >
        <AwardSection />
      </div>

      <!-- Selected work -->
      <section
        class="flex w-full flex-col gap-4 pt-4"
        data-project-group
        aria-labelledby="more-projects-heading"
      >
        <h2
          id="more-projects-heading"
          class="text-2xl
            font-normal
            tracking-tight
            text-brown-dark
            md:text-4xl"
        >
          Selected Work
        </h2>
        <p class="text-lg font-normal text-brown-dark/75">
          From a real hospital project to an award-winning client website, see
          how I design from research to delivery.
        </p>

        <div
          id="projects"
          class="grid
          w-full
          grid-cols-1
          gap-4
          md:grid-cols-2
          lg:grid-cols-3"
        >
          <!-- 7VAN is also featured in the Award section above -->
          <ProjectCard
            title="7VAN"
            eyebrow="Award-Winning · Real client"
            description="Developed a responsive website for a Brazilian Jiu-Jitsu academy to encourage membership applications."
            imageSrc={Image7Van.src}
            imageAlt="7VAN Brazilian Jiu-Jitsu academy website"
            categories={["UX/UI Design"]}
            projectLink="/projects/7van"
     
          />

          {projects.map((project) => (
            <ProjectCard
              title={project.title}
              eyebrow={project.eyebrow}
              description={project.description}
              imageSrc={project.imageSrc}
              imageAlt={project.imageAlt}
              categories={project.categories}
              projectLink={project.projectLink}
              warmupLink={project.warmupLink}
              modalId={project.modalId}
            />
          ))}
        </div>
      </section>

      <!-- Industry work under NDA: heading sits in the first grid cell -->
      <section
        class="mt-8 w-full border-t border-brown-dark/10 pt-4"
        data-project-group
        aria-labelledby="professional-projects-heading"
      >
        <div
          class="grid
            w-full
            grid-cols-1
            gap-4
            md:grid-cols-2
            lg:grid-cols-3"
        >
          <div class="flex flex-col gap-4 md:col-span-2 lg:col-span-1 lg:pr-4">
            <h2
              id="professional-projects-heading"
              class="text-2xl
                font-normal
                tracking-tight
                text-brown-dark
                md:text-4xl"
            >
              Industry Work
              <span class="mt-2 block text-sm font-semibold uppercase tracking-[0.16em] text-brown-dark/55">
                Under NDA
              </span>
            </h2>
            <p class="text-lg font-normal text-brown-dark/75">
              Product design at {" "}
              <a
                href="https://iterinov.com/Portfolio"
                target="_blank"
                rel="noopener noreferrer"
                class="underline decoration-brown-dark/30 underline-offset-4 transition-colors hover:decoration-brown-dark"
              >
                Iter Innovandi
              </a>
              . Details available on request.
            </p>
          </div>

          {professionalProjects.map((project) => (
            <ProjectCard
              title={project.title}
              description={project.description}
              imageSrc={project.imageSrc}
              imageAlt={project.imageAlt}
              categories={project.categories}
              projectLink={project.projectLink}
              modalId={project.modalId}
              nda={project.nda}
            />
          ))}
        </div>
      </section>

      <!-- Creative side projects -->
      <section
        class="flex w-full flex-col gap-4 pt-4 border-t border-brown-dark/10 mt-8"
        data-project-group
        aria-labelledby="playground-heading"
      >
        <h2
          id="playground-heading"
          class="text-2xl
            font-normal
            tracking-tight
            text-brown-dark
            md:text-4xl"
        >
          Creative Playground
        </h2>
        <p class="text-lg font-normal text-brown-dark/75">
          Side projects where I experiment with illustration, motion, and
          interaction.
        </p>

        <div
          class="grid
            w-full
            grid-cols-1
            gap-4
            md:grid-cols-2
            lg:grid-cols-3"
        >
          {playgroundProjects.map((project) => (
            <ProjectCard
              title={project.title}
              description={project.description}
              imageSrc={project.imageSrc}
              imageAlt={project.imageAlt}
              categories={project.categories}
              projectLink={project.projectLink}
              warmupLink={project.warmupLink}
              modalId={project.modalId}
              tech={project.tech}
            />
          ))}
        </div>
      </section>
    </div>
  </main>

  <Footer />
  <Modal
    id="contact-project-modal"
    eyebrow="Private project"
    title="Please contact me for more information"
    description="Some project details cannot be shared publicly. Email me and I’ll be happy to discuss my role, process, and outcomes."
    contactEmail="joy.is.happii@gmail.com"
  />

  <!-- <ModalWD
  id="carla"
  duration="5 days"
  role="Web Developer"
  responsibilities="Working on every pages, except the homepage, using HTML, CSS, SCSS, JavaScript"
  projectLink="https://springprojectjpp.netlify.app/"
  /> -->
</ContentLayout>
