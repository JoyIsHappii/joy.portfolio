              Industry Work
              <span class="mt-2 block text-sm font-semibold uppercase tracking-[0.16em] text-brown-dark/55">
                Under NDA
              </span>
            </h2>
            <p class="text-lg font-normal text-brown-dark/75">
              Product design for AI and construction-tech startups at{" "}
              <a
                href="https://iterinov.com/Portfolio"
                target="_blank"
                rel="noopener noreferrer"
                class="underline decoration-brown-dark/30 underline-offset-4 transition-colors hover:decoration-brown-dark"
              >
                Iter Innovandi
              </a>
              . Details available on request.
            </p>
          </div>

          {professionalProjects.map((project) => (
            <ProjectCard
              title={project.title}
              description={project.description}
              imageSrc={project.imageSrc}
              imageAlt={project.imageAlt}
              categories={project.categories}
              projectLink={project.projectLink}
              modalId={project.modalId}
              tech={project.tech}
              blurTitle={project.blurTitle}
            />
          ))}
        </div>
      </section>

      <!-- Creative side projects -->
      <section
        class="flex w-full flex-col gap-4 pt-4 border-t border-brown-dark/10 mt-8"
        data-project-group
        aria-labelledby="playground-heading"
      >
        <h2
          id="playground-heading"
          class="text-2xl
            font-normal
            tracking-tight
            text-brown-dark
            md:text-4xl"
        >
          Creative Playground
        </h2>
        <p class="text-lg font-normal text-brown-dark/75">
          Side projects where I experiment with illustration, motion, and
          interaction.
        </p>

        <div
          class="grid
            w-full
            grid-cols-1
            gap-4
            md:grid-cols-2
            lg:grid-cols-3"
        >
          {playgroundProjects.map((project) => (
            <ProjectCard
              title={project.title}
              description={project.description}
              imageSrc={project.imageSrc}
              imageAlt={project.imageAlt}
              categories={project.categories}
              projectLink={project.projectLink}
              warmupLink={project.warmupLink}
              modalId={project.modalId}
              tech={project.tech}
            />
          ))}
        </div>
      </section>
    </div>
  </main>

  <Footer />
  <Modal
    id="contact-project-modal"
    eyebrow="Private project"
    title="Please contact me for more information"
    description="Some project details cannot be shared publicly. Email me and I’ll be happy to discuss my role, process, and outcomes."
    contactEmail="joy.is.happii@gmail.com"
  />

  <!-- <ModalWD
  id="carla"
  duration="5 days"
  role="Web Developer"
  responsibilities="Working on every pages, except the homepage, using HTML, CSS, SCSS, JavaScript"
  projectLink="https://springprojectjpp.netlify.app/"
  /> -->
</ContentLayout>

<style>
  /* Pixel avatar on the Interactive Resume card. steps() keeps the motion choppy like a pixel game. */
  .resume-avatar {
    image-rendering: pixelated;
    animation: avatar-bob 1s steps(1, end) infinite;
  }

  .resume-shadow {
    animation: shadow-bob 1s steps(1, end) infinite;
  }

  .resume-bubble {
    animation: bubble-float 2s steps(2, jump-none) infinite alternate;
  }

  .resume-heart {
    left: 58%;
    top: 40%;
    opacity: 0;
  }

  :global(.group:hover) .resume-avatar {
    animation: avatar-hop 0.5s steps(1, end) infinite;
  }

  :global(.group:hover) .resume-heart {
    animation: heart-rise 1s steps(5, end) infinite;
  }

  @keyframes avatar-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-3px);
    }
  }

  @keyframes shadow-bob {
    0%,
    100% {
      transform: scaleX(1);
    }
    50% {
      transform: scaleX(0.85);
    }
  }

  @keyframes avatar-hop {
    0%,
    100% {
      transform: translateY(0);
    }
    25% {
      transform: translateY(-8px);
    }
    50% {
      transform: translateY(-12px);
    }
    75% {
      transform: translateY(-6px);
    }
  }

  @keyframes bubble-float {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-3px);
    }
  }

  @keyframes heart-rise {
    from {
      opacity: 1;
      transform: translateY(0);
    }
    to {
      opacity: 0;
      transform: translateY(-36px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .resume-avatar,
    .resume-shadow,
    .resume-bubble,
    :global(.group:hover) .resume-avatar,
    :global(.group:hover) .resume-heart {
      animation: none;
    }
  }
</style>
