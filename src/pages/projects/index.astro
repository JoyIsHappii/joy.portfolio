---
import ContentLayout from "../../layouts/ContentLayout.astro";
import Filter from "../../components/Filter.astro";
import ProjectCard from "../../components/ProjectCard.astro";

import Image7Van from "../../assets/hero/7van-cover.svg";
import ImageIppon from "../../assets/hero/ippon-cover.svg";
import ImageGrounds from "../../assets/hero/grounds-cover.svg";
import ImageBunny from "../../assets/hero/bunny-cover.svg";
import ImageIcu from "../../assets/hero/icu-cover.svg";
import ImagePawfectDay from "../../assets/hero/pawfect-cover.svg";
import ImageCiccc from "../../assets/hero/ciccc-cover.webp";
import ImageWeather from "../../assets/hero/weather-cover.svg";
import ImageMatch from "../../assets/hero/match-cover.webp";
// import ImageCarlaBeauty from "../../assets/hero/carla-cover.webp";
import ImageResume from "../../assets/resume.webp";

import AwardSection from "../../sections/AwardSection.astro";

import Button from "../../components/Button.astro";
import PortraitImage from "../../assets/joy.png";

import Modal from "../../components/Modal.astro";
import ModalWD from "../../components/ModalWD.astro";

type ProjectCategory =
  "UX/UI Design" | "Web Development" | "Project Management";

interface Project {
  title: string;
  description: string;
  imageSrc: string;
  imageAlt: string;
  categories: ProjectCategory[];
  projectLink?: string;
  warmupLink?: string;
  modalId?: string;
  tech?: string[];
}

const { title = "Joy's Projects" } = Astro.props;

const projects: Project[] = [
  {
    title: "Ippon",
    description:
      "A social media app for karate practitioners to share content and connect with the community.",
    imageSrc: ImageIppon.src,
    imageAlt: "Ippon App",
    categories: ["UX/UI Design"],
    tech: ["Figma"],
    projectLink: "/projects/ippon",
  },
  {
    title: "CICCC LMS",
    description: "A learning management system (LMS) for CICCC's tech campus.",
    imageSrc: ImageCiccc.src,
    imageAlt: "CICCC LMS",
    categories: ["UX/UI Design"],
    tech: ["Figma"],
    projectLink: "/projects/ciccc-lms",
  },
  {
    title: "Bunny World",
    description:
      "An accessible learning tool for children with learning disabilities.",
    imageSrc: ImageBunny.src,
    imageAlt: "Bunny World App",
    categories: ["UX/UI Design"],
    tech: ["Figma"],
    projectLink: "/projects/bunny-world",
  },
  {
    title: "Weather Fore-CAT",
    description:
      "A cat-themed weather dashboard with forecasts, favorites, and air-quality data.",
    imageSrc: ImageWeather.src,
    imageAlt: "Weather ForeCAT weather dashboard",
    categories: ["UX/UI Design", "Web Development"],
    tech: [
      "Figma",
      "Astro",
      "TypeScript",
      "Tailwind CSS",
      "jQuery",
      "Open-Meteo API",
      "PlaceKit API",
      "Netlify",
    ],
    projectLink: "https://weather-fore-cat.netlify.app",
  },
  {
    title: "FIFA Performance Stats",
    description:
      "A full-stack app for exploring player performances, matches, and tournament rankings.",
    imageSrc: ImageMatch.src,
    imageAlt: "FIFA Performance Stats",
    categories: ["Web Development"],
    tech: [
      "Astro",
      "Tailwind CSS",
      "Node.js",
      "Express",
      "PostgreSQL",
      "REST API",
      "Render",
    ],
    projectLink: "https://fifa-player-stats.onrender.com/",
    warmupLink: "https://player-stats-2uxq.onrender.com",
  },
  {
    title: "Pawfect Day",
    description:
      "A full-stack pet grooming app with online booking and staff management.",
    imageSrc: ImagePawfectDay.src,
    imageAlt: "Pawfect Day pet grooming platform",
    categories: ["Web Development", "Project Management"],
    tech: [
      "Next.js",
      "React",
      "TypeScript",
      "Tailwind CSS",
      "Prisma",
      "PostgreSQL",
      "Vercel",
    ],
    projectLink: "/projects/pawfect-day",
  },
  {
    title: "Grounds Cafe",
    description:
      "A responsive cafe ordering app with menu browsing, favorites, cart, and checkout.",
    imageSrc: ImageGrounds.src,
    imageAlt: "Grounds Cafe App",
    categories: ["Web Development"],
    tech: ["React", "TypeScript", "Vite", "Tailwind CSS", "Netlify"],
    projectLink: "/projects/grounds-cafe",
  },
  {
    title: "COVID-19 ICU Monitoring",
    description:
      "A monitoring system designed to improve safety in negative-pressure ICU rooms.",
    imageSrc: ImageIcu.src,
    imageAlt: "Negative Pressure Monitor",
    categories: ["Project Management"],
    modalId: "contact-project-modal",
  },
  // {
  //   title: "Carla Beauty",
  //   description:
  //     "A website for a Vancouver-based makeup and hairstyle studio with a Brazilian twist.",
  //   imageSrc: ImageCarlaBeauty.src,
  //   imageAlt: "Carla Beauty website",
  //   categories: ["Web Development"],
  //   tech: ["HTML", "CSS", "SCSS", "JavaScript","Netlify"],
  //   modalId: "carla",
  // },
];
---

<ContentLayout title={title} active="projects">
  <main
    class="flex
      w-full
      flex-col
      items-start
      justify-start
      gap-4
      py-4
      md:py-6
      lg:flex-row
      lg:gap-4"
  >
    <!-- Left side: heading and filter -->
    <aside
      id="projects-header"
      class="z-10
        flex
        w-full
        flex-col
        items-start
        gap-4
        lg:sticky
        lg:top-[calc(50px+4rem)]
        lg:w-64
        lg:shrink-0
        mt-0
        lg:mt-0"
    >
      <h2
        class="text-4xl
          tracking-tight
          text-brown-dark
          md:text-5xl
          lg:text-6xl"
      >
        My Projects
      </h2>

      <Filter />
    </aside>

    <!-- Right side: project content -->
    <div class="flex w-full min-w-0 flex-col gap-4 px-4 md:px-0">
      <!-- Only visible when All is selected -->
      <div
        id="award-section"
        data-award-section
        class="flex w-full justify-center"
      >
        <AwardSection />
      </div>

      <div
        id="projects"
        class="grid
          w-full
          grid-cols-1
          gap-4
          md:grid-cols-2
          lg:grid-cols-3"
      >
        <!--
          7VAN replaces the Award section when a category is selected.
          It starts hidden because All is selected initially.
        -->
        <div data-sevenvan-card hidden>
          <ProjectCard
            title="7VAN"
            description="Developed a responsive website for a Brazilian Jiu-Jitsu academy to encourage membership applications."
            imageSrc={Image7Van.src}
            imageAlt="7VAN Brazilian Jiu-Jitsu academy website"
            categories={["UX/UI Design"]}
            projectLink="/projects/7van"
            tech={["Figma"]}
          />
        </div>

        {
          projects.map((project) => (
            <ProjectCard
              title={project.title}
              description={project.description}
              imageSrc={project.imageSrc}
              imageAlt={project.imageAlt}
              categories={project.categories}
              projectLink={project.projectLink}
              warmupLink={project.warmupLink}
              modalId={project.modalId}
              tech={project.tech}
            />
          ))
        }
      </div>
    </div>
  </main>
 <section
  id="about-me"
  class="w-full border-y border-brown-dark/10 bg-brown-light/10 px-4 py-14 sm:py-16 md:px-8 md:py-20"
>
  <div
    class="mx-auto flex max-w-6xl flex-col items-center gap-10
           md:flex-row md:items-center md:gap-14 lg:gap-20"
  >
    <!-- Resume Preview -->
    <div class="w-full md:w-[55%]">
      <div class="mx-auto w-full max-w-[560px] overflow-hidden rounded-xl">
        <img
          src={ImageResume.src}
          alt="Preview of Joy's interactive resume"
          class="block h-auto w-full"
        />
      </div>
    </div>

    <!-- Content -->
    <div
      class="flex w-full max-w-md flex-col items-center text-center
             md:w-[45%] md:items-start md:text-left"
    >
      <!-- Label -->
      <div class="flex items-center gap-3">
        <img
          src={PortraitImage.src}
          alt="Portrait of Joy"
          class="h-11 w-11 rounded-full object-cover"
        />

        <p
          class="text-sm font-semibold uppercase tracking-[0.18em]
                 text-dark-brown sm:text-base"
        >
          About Me
        </p>
      </div>

      <!-- Heading -->
      <h2
        class="mt-5 text-3xl leading-tight text-dark-brown
               sm:text-4xl md:text-[2.6rem]"
      >
        More than a resume
      </h2>

      <!-- Description -->
      <p
        class="mt-4 max-w-sm text-sm leading-7 text-brown-dark/75
               sm:text-base"
      >
        I started in architecture, moved into UX/UI design, and am now
        exploring the world of web development. Take a look at my
        interactive resume to see the journey.
      </p>

      <!-- CTA -->
      <Button
        href="https://interactive-resume-joy.vercel.app"
        target="_blank"
        rel="noopener noreferrer"
        variant="primary"
        size="md"
        class="mt-7"
      >
        Explore My Story →
      </Button>
    </div>
  </div>
</section>

<footer class="w-full border-t border-brown-dark/10 px-4 py-10 md:px-8">
  <div
    class="mx-auto flex max-w-6xl flex-col items-center gap-6
           md:flex-row md:justify-between"
  >
    <div class="text-center md:text-left">
      <p class="text-lg font-medium text-dark-brown">
        Thanks for stopping by ♡
      </p>
      <p class="mt-1 text-sm text-brown-dark/60">
        Let's make something thoughtful together.
      </p>
    </div>

    <nav class="flex items-center gap-6 text-sm text-brown-dark/70">
      <a href="mailto:joy.is.happii@gmail.com" class="transition-opacity hover:opacity-60">
        Email
      </a>
      <a
        href="https://www.linkedin.com/in/joykosol/"
        target="_blank"
        rel="noopener noreferrer"
        class="transition-opacity hover:opacity-60"
      >
        LinkedIn
      </a>
      <a
        href="https://github.com/JoyIsHappii"
        target="_blank"
        rel="noopener noreferrer"
        class="transition-opacity hover:opacity-60"
      >
        GitHub
      </a>
    </nav>
  </div>

  <div
    class="mx-auto mt-8 flex max-w-6xl flex-col items-center
           gap-2 border-t border-brown-dark/10 pt-5
           text-xs text-brown-dark/50 sm:flex-row sm:justify-between"
  >
    <p>© 2026 Joy Kosol</p>

    <button
      onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
      class="transition-opacity hover:opacity-60"
    >
      Back to top ↑
    </button>
  </div>
</footer>
  <Modal
    id="contact-project-modal"
    eyebrow="Private project"
    title="Please contact me for more information"
    description="Some project details cannot be shared publicly. Email me and I’ll be happy to discuss my role, process, and outcomes."
    contactEmail="joy.is.happii@gmail.com"
  />

  <!-- <ModalWD
  id="carla"
  duration="5 days"
  role="Web Developer"
  responsibilities="Working on every pages, except the homepage, using HTML, CSS, SCSS, JavaScript"
  projectLink="https://springprojectjpp.netlify.app/"
  /> -->
</ContentLayout>
