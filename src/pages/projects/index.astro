---

<ContentLayout title={title} active="projects">
  <main
    class="flex
      w-full
      flex-col
      items-start
      justify-start
      gap-4
      py-4
      md:py-6
      lg:flex-row
      lg:gap-12"
  >
    <!-- Left side: heading and filter -->
    <aside
      id="projects-header"
      class="z-10
        flex
        w-full
        flex-col
        items-start
        gap-4
        lg:sticky
        lg:top-[calc(50px+4rem)]
        lg:w-64
        lg:shrink-0
        mt-0
        lg:mt-0"
    >
      <h2
        class="text-4xl
          tracking-tight
          text-brown-dark
          md:text-5xl
          lg:text-6xl
          lg:[@media(max-height:860px)]:text-5xl"
      >
        My Projects
      </h2>

      <Filter />

      <!-- Interactive resume: stays in view with the sticky filter on large screens -->
      <a
        href="https://interactive-resume-joy.vercel.app"
        target="_blank"
        rel="noopener noreferrer"
        class="group mt-4 hidden w-full flex-col border border-brown-dark/20 text-brown-dark transition-colors duration-200 hover:bg-brown-medium/50 lg:flex"
      >
        <!-- Pixel avatar scene: compact on short screens so the sticky column always fits -->
        <span class="resume-scene relative flex items-end justify-center overflow-hidden bg-brown-medium/30 px-4 pb-4 pt-12 [@media(max-height:860px)]:pt-4">
          <span class="resume-bubble absolute left-3 top-3 [@media(max-height:860px)]:hidden border border-brown-dark/25 bg-white px-2.5 py-1 text-xs font-medium text-brown-dark">
            Psst… my story's this way!
          </span>
          <span class="resume-heart absolute text-pink" aria-hidden="true">
            ♥
          </span>
          <img
            src={PixelAvatar.src}
            alt=""
            width="500"
            height="500"
            class="resume-avatar relative z-10 h-36 w-36 [@media(max-height:860px)]:h-28 [@media(max-height:860px)]:w-28"
          />
          <span
            class="resume-shadow absolute inset-x-0 bottom-5 mx-auto h-2 w-16 rounded-[50%] bg-brown-dark/20"
            aria-hidden="true"
          ></span>
        </span>
        <span class="flex flex-col gap-1 p-4">
          <span class="text-xs font-semibold uppercase tracking-[0.16em] text-brown-dark/60">
            Interactive Resume
          </span>
          <span class="text-lg leading-snug [@media(max-height:860px)]:hidden">
            My journey, skills, and story in one place.
          </span>
          <span class="mt-2 text-sm font-semibold underline decoration-brown-dark/30 underline-offset-4 group-hover:decoration-brown-dark">
            Explore it ↗
          </span>
        </span>
      </a>
    </aside>

    <!-- Right side: project content -->
