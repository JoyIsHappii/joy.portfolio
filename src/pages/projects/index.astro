---

<ContentLayout title={title} active="projects">
  <main
    class="flex
      w-full
      flex-col
      items-start
      justify-start
      gap-4
      py-4
      md:py-6
      lg:flex-row
      lg:gap-4"
  >
    <!-- Left side: heading and filter -->
    <aside
      id="projects-header"
      class="z-10
        flex
        w-full
        flex-col
        items-start
        gap-4
        lg:sticky
        lg:top-[calc(50px+4rem)]
        lg:w-64
        lg:shrink-0
        mt-0
        lg:mt-0"
    >
      <h2
        class="text-4xl
          tracking-tight
          text-brown-dark
          md:text-5xl
          lg:text-6xl"
      >
        My Projects
      </h2>

      <Filter />
    </aside>

    <!-- Right side: project content -->
    <div class="flex flex-col w-full min-w-0 gap-4 px-4 md:px-0">
      <!-- Only visible when All is selected -->
      <div
        id="award-section"
        data-award-section
        class="flex flex-col w-full justify-center gap-4"
      >
        <AwardSection />
        <!-- <ResumeSection /> -->
        <!-- <iframe
        src="https://interactive-resume-joy.vercel.app"
        title="Joy's Interactive Resume"
        class="h-[min(700px,calc(100dvh-8rem))] w-full border border-brown-dark/10 shadow-lg transition-all duration-300 ease-in-out"
      ></iframe> -->
      </div>

      <!-- Professional projects -->
      <section
        class="flex w-full flex-col gap-4 pt-4"
        data-project-group
        aria-labelledby="professional-projects-heading"
      >
        <div class="flex flex-col gap-1">
          <h2
            id="professional-projects-heading"
            class="text-2xl
              font-normal
              tracking-tight
              text-brown-dark
              md:text-4xl"
          >
            Professional Projects
          </h2>
          <p class="text-lg font-normal text-brown-dark/75">
            Work from my roles at King Chulalongkorn Memorial Hospital and{" "}
            <a
              href="https://iterinov.com/Portfolio"
              target="_blank"
              rel="noopener noreferrer"
              class="underline decoration-brown-dark/30 underline-offset-4 transition-colors hover:decoration-brown-dark"
            >
              Iter Innovandi
            </a>
            . Some projects are under NDA.
          </p>
        </div>

        <div
          class="grid
            w-full
            grid-cols-1
            gap-4
            md:grid-cols-2
            lg:grid-cols-3"
        >
          {professionalProjects.map((project) => (
            <ProjectCard
              title={project.title}
              description={project.description}
              imageSrc={project.imageSrc}
              imageAlt={project.imageAlt}
              categories={project.categories}
              projectLink={project.projectLink}
              modalId={project.modalId}
              tech={project.tech}
              blurTitle={project.blurTitle}
            />
          ))}
        </div>
      </section>

      <!-- Other projects -->
      <section
        class="flex w-full flex-col gap-4 pt-4 border-t border-brown-dark/10 mt-8"
        data-project-group
        aria-labelledby="more-projects-heading"
      >
        <h2
          id="more-projects-heading"
          class="text-2xl
            font-normal
            tracking-tight
            text-brown-dark
            md:text-4xl"
        >
          More Projects
        </h2>
        <p class="text-lg font-normal text-brown-dark/75">
          The projects that showcase my skills in UX/UI design, web development,
          and project management.
        </p>

        <div
          id="projects"
          class="grid
          w-full
          grid-cols-1
          gap-4
          md:grid-cols-2
          lg:grid-cols-3"
        >
          <!-- 7VAN is also featured in the Award section above -->
          <ProjectCard
            title="7VAN"
            description="Developed a responsive website for a Brazilian Jiu-Jitsu academy to encourage membership applications."
            imageSrc={Image7Van.src}
            imageAlt="7VAN Brazilian Jiu-Jitsu academy website"
            categories={["UX/UI Design"]}
            projectLink="/projects/7van"
            tech={[
              "Figma",
              "User Research",
              "Wireframing",
              "Prototyping",
              "Usability Testing",
              "User Flows",
              "Information Architecture",
            ]}
          />

          {projects.map((project) => (
            <ProjectCard
              title={project.title}
              description={project.description}
              imageSrc={project.imageSrc}
              imageAlt={project.imageAlt}
              categories={project.categories}
              projectLink={project.projectLink}
              warmupLink={project.warmupLink}
              modalId={project.modalId}
              tech={project.tech}
            />
          ))}
        </div>
      </section>

      <!-- Creative side projects -->
      <section
        class="flex w-full flex-col gap-4 pt-4 border-t border-brown-dark/10 mt-8"
        data-project-group
        aria-labelledby="playground-heading"
      >
        <h2
          id="playground-heading"
          class="text-2xl
            font-normal
            tracking-tight
            text-brown-dark
            md:text-4xl"
        >
          Creative Playground
        </h2>
        <p class="text-lg font-normal text-brown-dark/75">
          Side projects where I experiment with illustration, motion, and
          interaction.
        </p>

        <div
          class="grid
            w-full
            grid-cols-1
            gap-4
            md:grid-cols-2
            lg:grid-cols-3"
        >
          {playgroundProjects.map((project) => (
            <ProjectCard
              title={project.title}
              description={project.description}
              imageSrc={project.imageSrc}
              imageAlt={project.imageAlt}
              categories={project.categories}
              projectLink={project.projectLink}
              warmupLink={project.warmupLink}
              modalId={project.modalId}
              tech={project.tech}
            />
          ))}
        </div>
      </section>
    </div>
  </main>

  <!-- <ResumeSection /> -->
  <!-- <iframe
        src="https://interactive-resume-joy.vercel.app"
        title="Joy's Interactive Resume"
        class="h-[min(700px,calc(100dvh-8rem))] w-full "
      ></iframe> -->

  <section
    id="about-me"
    class="w-full border-y border-brown-dark/10 bg-brown-light/10 px-4 py-14 sm:py-16 md:px-8 md:py-20"
  >
    <div
      class="mx-auto flex max-w-6xl flex-col items-center gap-10
           md:flex-row md:items-center md:gap-14 lg:gap-20"
    >
      <div class="w-full md:w-[55%]">
        <div class="mx-auto w-full max-w-[560px] overflow-hidden rounded-xl">
          <img
            src={ImageResume.src}
            alt="Preview of Joy's interactive resume"
            class="block h-auto w-full"
          />
        </div>
      </div>

      <div
        class="flex w-full max-w-md flex-col items-center text-center
             md:w-[45%] md:items-start md:text-left"
      >
        <div class="flex items-center gap-3">
          <img
            src={PortraitImage.src}
            alt="Portrait of Joy"
            class="h-11 w-11 rounded-full object-cover"
          />

          <p
            class="text-sm font-semibold uppercase tracking-[0.18em]
                 text-dark-brown sm:text-base"
          >
            About Me
          </p>
        </div>

        <h2
          class="mt-5 text-3xl leading-tight text-dark-brown
               sm:text-4xl md:text-[2.6rem]"
        >
          More than a resume
        </h2>

        <p
          class="mt-4 max-w-sm text-sm leading-7 text-brown-dark/75
               sm:text-base"
        >
          I started in architecture, moved into UX/UI design, and am now
          exploring the world of web development. Take a look at my interactive
          resume to see the journey.
        </p>

        <div class="flex flex-col gap-2 sm:flex-row sm:gap-4">
          <Button href="/about" variant="primary" size="md" class="mt-7">
            Explore My Story
          </Button>

          <Button
            href="https://interactive-resume-joy.vercel.app"
            target="_blank"
            rel="noopener noreferrer"
            variant="secondary"
            size="md"
            class="mt-7"
          >
            View Interactive Resume
          </Button>
        </div>
      </div>
    </div>
  </section>

  <Footer />
  <Modal
    id="contact-project-modal"
    eyebrow="Private project"
    title="Please contact me for more information"
    description="Some project details cannot be shared publicly. Email me and I’ll be happy to discuss my role, process, and outcomes."
    contactEmail="joy.is.happii@gmail.com"
  />

  <!-- <ModalWD
  id="carla"
  duration="5 days"
  role="Web Developer"
  responsibilities="Working on every pages, except the homepage, using HTML, CSS, SCSS, JavaScript"
  projectLink="https://springprojectjpp.netlify.app/"
  /> -->
</ContentLayout>

<script>
  // Handle View Resume button click -> scroll to the About Me section
  const resumeButton = document.getElementById("resume-button");
  const aboutMeSection = document.getElementById("about-me");

  resumeButton?.addEventListener("click", () => {
    aboutMeSection?.scrollIntoView({ behavior: "smooth" });
  });
</script>

