---
import ContentLayout from "../../layouts/ContentLayout.astro";
import Filter from "../../components/Filter.astro";
import ProjectCard from "../../components/ProjectCard.astro";

import Image7Van from "../../assets/hero/7van-cover.svg";
import ImageIppon from "../../assets/hero/ippon-cover.svg";
import ImageGrounds from "../../assets/hero/grounds-cover.svg";
import ImageBunny from "../../assets/hero/bunny-cover.svg";
import ImageIcu from "../../assets/hero/icu-cover.svg";
import ImagePawfectDay from "../../assets/hero/pawfect-cover.svg";
import ImageCiccc from "../../assets/hero/ciccc-cover.webp";

import AwardSection from "../../sections/AwardSection.astro";

import Button from "../../components/Button.astro";
import PortraitImage from "../../assets/room-elements/portrait.svg";

import Modal from "../../components/Modal.astro";

type ProjectCategory =
  "UX/UI Design" | "Web Development" | "Project Management";

interface Project {
  title: string;
  description: string;
  imageSrc: string;
  imageAlt: string;
  categories: ProjectCategory[];
  projectLink?: string;
  modalId?: string;
}

const { title = "Joy's Projects" } = Astro.props;

const projects: Project[] = [
  {
    title: "Ippon",
    description:
      "A social media application for karate practitioners, containing content and a community focused on karate.",
    imageSrc: ImageIppon.src,
    imageAlt: "Ippon App",
    categories: ["UX/UI Design"],
    projectLink: "/projects/ippon",
  },
  {
    title: "CICCC LMS",
    description:
      "Redesigned the Learning Management System for the tech campus at Cornerstone International Community College of Canada (CICCC).",
    imageSrc: ImageCiccc.src,
    imageAlt: "CICCC LMS",
    categories: ["UX/UI Design"],
    projectLink: "/projects/ciccc-lms",
  },
  {
    title: "Bunny World",
    description:
      "Created an educational tool for children with learning disabilities.",
    imageSrc: ImageBunny.src,
    imageAlt: "Bunny World App",
    categories: ["UX/UI Design"],
    projectLink: "/projects/bunny-world",
  },
  {
    title: "Grounds Cafe",
    description:
      "A responsive Unsplash landing page replica built with Next.js, featuring reusable components, smooth navigation, and email subscription.",
    imageSrc: ImageGrounds.src,
    imageAlt: "Grounds Cafe App",
    categories: ["Web Development"],
    projectLink: "https://grounds-cafe.netlify.app",
  },
{
  title: "Pawfect Day",
  description:
    "A responsive full-stack pet grooming application that connects online customer bookings with a staff management dashboard.",
  imageSrc: ImagePawfectDay.src,
  imageAlt: "Pawfect Day pet grooming booking application",
  categories: [ "Web Development", "Project Management"],
  projectLink: "/projects/pawfect-day",
},
{
  title: "Negative Pressure Monitor",
  description:
    "Designed a negative-pressure room monitoring system to improve COVID-19 safety.",
  imageSrc: ImageIcu.src,
  imageAlt: "Negative Pressure Monitor",
  categories: ["Project Management"],
  modalId: "contact-project-modal",
},
];
---

<ContentLayout title={title} active="projects">
  <main
    class="flex
      w-full
      flex-col
      items-start
      justify-start
      gap-8
      py-8
      md:py-12
      lg:flex-row
      lg:gap-12"
  >
    <!-- Left side: heading and filter -->
    <aside
      id="projects-header"
      class="z-10
        flex
        w-full
        flex-col
        items-start
        gap-4
        lg:sticky
        lg:top-[calc(50px+4rem)]
        lg:w-64
        lg:shrink-0
        mt-20
        lg:mt-0"
    >
      <h2
        class="text-4xl
          tracking-tight
          text-brown-dark
          md:text-5xl
          lg:text-6xl"
      >
        My Projects
      </h2>

      <Filter />
    </aside>

    <!-- Right side: project content -->
    <div class="flex w-full min-w-0 flex-col gap-4 px-4 md:px-0">
      <!-- Only visible when All is selected -->
      <div
        id="award-section"
        data-award-section
        class="flex w-full justify-center"
      >
        <AwardSection />
      </div>

      <div
        id="projects"
        class="grid
          w-full
          grid-cols-1
          gap-4
          md:grid-cols-2
          lg:grid-cols-3"
      >
        <!--
          7VAN replaces the Award section when a category is selected.
          It starts hidden because All is selected initially.
        -->
        <div data-sevenvan-card hidden>
          <ProjectCard
            title="7VAN"
            description="Developed a responsive website for a Brazilian Jiu-Jitsu academy to encourage membership applications."
            imageSrc={Image7Van.src}
            imageAlt="7VAN Brazilian Jiu-Jitsu academy website"
            categories={["UX/UI Design"]}
            projectLink="/projects/7van"
          />
        </div>

        {
          projects.map((project) => (
            <ProjectCard
              title={project.title}
              description={project.description}
              imageSrc={project.imageSrc}
              imageAlt={project.imageAlt}
              categories={project.categories}
              projectLink={project.projectLink}
              modalId={project.modalId}
            />
          ))
        }
      </div>

      <section
        class="brown-bg w-full
   flex flex-row items-center
   justify-center gap-4 py-12 px-4 md:px-0"
      >
        <!-- Left -->
        <div class="flex flex-col items-center justify-center gap-4">
         
        </div>
        <!-- Right -->
        <div class="flex flex-col items-center justify-center gap-4">
          <img
            src={PortraitImage.src}
            alt="Portrait"
            class="w-full max-w-[120px] h-auto object-contain"
          />
          <Button href="/about" variant="primary" size="md" class="mt-4"
            >About Me →</Button
          >
        </div>
      </section>


    </div>
  </main>

  <Modal
    id="contact-project-modal"
    eyebrow="Private project"
    title="Please contact me for more information"
    description="Some project details cannot be shared publicly. Email me and I’ll be happy to discuss my role, process, and outcomes."
    contactEmail="chayaninkosol@gmail.com"
  />
</ContentLayout>
