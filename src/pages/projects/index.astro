---
import ContentLayout from "../../layouts/ContentLayout.astro";
import Filter from "../../components/Filter.astro";
import ProjectCard from "../../components/ProjectCard.astro";

import Image7Van from "../../assets/hero/7van-cover.svg";
import ImageIppon from "../../assets/hero/ippon-cover.svg";
import ImageGrounds from "../../assets/hero/grounds-cover.svg";
import ImageBunny from "../../assets/hero/bunny-cover.svg";
import ImageIcu from "../../assets/hero/icu-cover.svg";
import ImageMatchDay from "../../assets/hero/matchday-cover.svg";

import AwardSection from "../../sections/AwardSection.astro";
import AboutFooter from "../../sections/AboutFooter.astro";

import Portrait from "../../assets/room-elements/portrait.svg";

import Backpack from "../../assets/room-elements/backpack.svg";
import Camera from "../../assets/room-elements/camera.svg";

import Button from "../../components/Button.astro";

import HeroImage from "../../assets/hero/ippon.png";

const { title = "Projects — Joy" } = Astro.props;

const projects = [
  {
    title: "7Van",
    description:
      "Developed a responsive website for a Brazilian Jiu-Jitsu academy, to encourage membership applications.",
    imageSrc: Image7Van.src,
    imageAlt: "7Van App",
    category: "UX/UI Design",
    projectLink: "/projects/7van/",
  },
  {
    title: "Ippon",
    description:
      "A social media application for karate practitioners, to contain content and community about karate.",
    imageSrc: ImageIppon.src,
    imageAlt: "Ippon App",
    category: "UX/UI Design",
    projectLink: "/projects/ippon",
  },
  {
    title: "Bunny World",
    description:
      "Created an educational tool for children with learning disabilities.",
    imageSrc: ImageBunny.src,
    imageAlt: "Bunny World App",
    category: "UX/UI Design",
    projectLink: "/projects/bunny-world",
  },
  {
    title: "Grounds Cafe",
    description:
      "A platform that connects coffee enthusiasts with local coffee shops and roasters.",
    imageSrc: ImageGrounds.src,
    imageAlt: "Grounds App",
    category: "Web Development",
    projectLink: "https://grounds-cafe.netlify.app",
  },
  {
    title: "Match Day",
    description:
      "A native chat application for football fans to connect and discuss matches in real-time.",
    imageSrc: ImageMatchDay.src,
    imageAlt: "Match Day App",
    category: "Web Development",
    projectLink: "",
  },
  {
    title: "Negative Pressure Monitor",
    description:
      "Designed a negative-pressure room monitoring system to improve COVID-19 safety.",
    imageSrc: ImageIcu.src,
    imageAlt: "Negative Pressure Monitor",
    category: "Project Design",
    projectLink: "https://grounds-cafe.netlify.app",
  },
];
---

<ContentLayout title={title} active="projects">
  <main>
    <div
      class="flex flex-row w-full max-w-[1280px]
       gap-4 items-start justify-start py-8 px-4 md:px-0"
    >
      <div
        id="hero"
        class="w-full flex flex-col
         items-start justify-center gap-8 py-8 px-2 md:px-4"
      >
        <p
          class="text-sm md:text-sm lg:text-md
        font-normal
        text-white
        bg-black
        px-4
        py-2
        rounded-lg"
          data-aos="fade-down"
          data-aos-duration="2000"
          data-aos-delay="0"
        >
          🎒 Take a look inside my backpack!
        </p>

        <blockquote
          class="text-xl italic
          
          font-semibold tracking-tight text-heading"
        >
          <h1
            class="text-4xl md:text5xl lg:text-6xl
        leading-none
        font-normal
        tracking-tight
        text-black/80
        ibm-plex-serif-medium-italic
        text-start
        w-full"
            data-aos="fade-up"
            data-aos-duration="2000"
            data-aos-delay="1000"
          >
            "Packed with ideas, experiments, and stories."
          </h1>
          <p
            class="mt-4 text-sm md:text-lg lg:text-xl
        font-normal
        text-black
        text-start
        w-full"
            data-aos="fade-up"
            data-aos-duration="2000"
            data-aos-delay="1500"
          >
            — JoyisHappii
          </p>
        </blockquote>
        <span
          class="flex flex-row gap-4"
          data-aos="fade-up"
          data-aos-duration="2000"
          data-aos-delay="1500"
        >
          <Button
            variant="primary"
            href="/projects/#projects-header"
            class="w-fit mt-2"
            data-aos="fade-up"
            data-aos-duration="2000"
            data-aos-delay="1500"
            >Explore my projects
          </Button>
          <Button
            variant="secondary"
            href="/projects/#award-section"
            class="w-fit mt-2"
            data-aos="fade-up"
            data-aos-duration="2000"
            data-aos-delay="1500"
            >View Awarded Projects
          </Button>
        </span>
      </div>
      <div
        class="flex flex-col w-full
      md:flex-row items-center
      justify-center gap-4"
        data-aos="fade-left"
        data-aos-duration="1500"
        data-aos-delay="1000"
      >
        <img
          src={HeroImage.src}
          alt="Hero Image"
          class="w-full items-center justify-center"
        />
      </div>
    </div>
    <div id="award-section" class="w-full flex justify-center">
      <AwardSection />
    </div>
    <div
      id="projects-header"
      class="w-full flex flex-row justify-between
      items-center gap-4 py-8 px-4 md:px-0"
    >
      <span class="flex flex-col gap-2 w-full">
        <h2
          class="text-4xl md:text-5xl lg:text-6xl
        ibm-plex-serif-medium-italic
        tracking-tight
        text-black
        w-full"
        >
          All Projects
        </h2>
        <p>
          Hopefully you find 'JOY' during explore my portfolio, where I showcase
          my passion and pride in every project.
        </p>
      </span>
            <span class="flex flex-col gap-2 w-full ">

      <Filter />
      <p class="text-sm md:text-lg lg:text-xl
        font-normal
        text-black
        ">
        Showing {projects.length} of {projects.length} projects
      </p>
            </span>

    </div>
    <div
      id="projects"
      class="w-full grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-4 px-4 md:px-0"
    >
      {projects.map((project) => (
        <ProjectCard
          title={project.title}
          description={project.description}
          imageSrc={project.imageSrc}
          imageAlt={project.imageAlt}
          category={project.category}
          projectLink={project.projectLink}
        />
      ))}
    </div>
    <div class="w-full flex justify-center py-12">
      <AboutFooter />
    </div>
    <footer
      class="w-full flex flex-col items-center justify-center gap-4 py-8 px-4 md:px-0"
    >
      <p
        class="text-sm md:text-lg lg:text-xl
        font-normal
        text-black"
      >
        © 2024 JoyisHappii. All rights reserved.
      </p>
    </footer>
  </main>
</ContentLayout>
