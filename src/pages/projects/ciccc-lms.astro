---
import ProjectDetailLayout from "../../layouts/ProjectDetailLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Sidebar from "../../components/ProjectSideBar.astro";
import ProjectDetailHero from "../../components/ProjectDetailHero.astro";
import ProjectOverview from "../../components/ProjectOverview.astro";


import CoverImage from "../../assets/ciccc-lms/evidence/cover.svg";
import UserAccessImage from "../../assets/ciccc-lms/evidence/user-access.svg";
import NavigationResearchImage from "../../assets/ciccc-lms/evidence/research-navigation.svg";
import CommunicationResearchImage from "../../assets/ciccc-lms/evidence/research-communication.svg";
import InformationResearchImage from "../../assets/ciccc-lms/evidence/research-information.svg";
import ProblemImage from "../../assets/ciccc-lms/evidence/problem.svg";
import CoreSolutionsImage from "../../assets/ciccc-lms/evidence/core-solutions.svg";
import DashboardImage from "../../assets/ciccc-lms/evidence/dashboard-customization.svg";
import NotificationsImage from "../../assets/ciccc-lms/evidence/notifications.svg";
import AttendanceImage from "../../assets/ciccc-lms/evidence/attendance-data.svg";
import CoursesImage from "../../assets/ciccc-lms/evidence/courses-grades.svg";
import ReportsImage from "../../assets/ciccc-lms/evidence/reports.svg";
import UserFeedbackImage from "../../assets/ciccc-lms/evidence/user-feedback.svg";
import ConclusionImage from "../../assets/ciccc-lms/evidence/conclusion.svg";

const userGroups = [
  {
    title: "Students",
    needs: ["See grades", "Review invoices", "Check schedules"],
  },
  {
    title: "Instructors",
    needs: ["Record attendance", "Manage grades", "Access live classes"],
  },
  {
    title: "Program managers",
    needs: ["Track student activity", "Review attendance", "Monitor grades"],
  },
];

const researchFindings = [
  {
    number: "01",
    title: "Complicated navigation",
    summary:
      "Students and instructors struggled to find frequently used pages and felt that common tasks required too many steps.",
    evidence:
      "Students described feeling lost during their first use, while an instructor said it was hard to find what they needed.",
    image: NavigationResearchImage,
    imageAlt:
      "Survey and interview findings about complicated navigation in the existing CICCC platform",
  },
  {
    number: "02",
    title: "Lack of communication",
    summary:
      "Important platform changes were easy to miss because the system did not provide clear notifications.",
    evidence:
      "A program manager specifically identified the lack of update notifications as a weakness in the current platform.",
    image: CommunicationResearchImage,
    imageAlt:
      "Program-manager interview finding about the lack of update notifications",
  },
  {
    number: "03",
    title: "Unnecessary information",
    summary:
      "The dashboard presented too much information, including content that was not relevant to a user’s immediate goals.",
    evidence:
      "Students questioned why payment details and other unrelated information appeared prominently on their dashboards.",
    image: InformationResearchImage,
    imageAlt:
      "Student survey and interview findings about unnecessary dashboard information",
  },
];

const solutionPillars = [
  {
    number: "01",
    title: "Customizable dashboard",
    problem:
      "A single fixed dashboard forced every audience to process the same information, even when their priorities were different.",
    decision:
      "Let users organize their dashboard around courses, assignments, grades, attendance, fees, and other relevant routines.",
    value:
      "A friendlier dashboard creates direct access to daily activities and reduces unnecessary searching.",
    image: DashboardImage,
    imageAlt:
      "CICCC LMS customizable dashboard with academic activities, calendar, grades, attendance, co-op, and fees",
  },
  {
    number: "02",
    title: "Centralized notifications",
    problem:
      "Users lacked a reliable way to notice updates, review outstanding tasks, and follow changes across classes.",
    decision:
      "Create a notification centre for course updates, attendance status, grade status, documents, and program activity.",
    value:
      "Straightforward communication improves system awareness, task review, and follow-up.",
    image: NotificationsImage,
    imageAlt:
      "CICCC LMS notification centre and manager dashboard for student and class updates",
  },
  {
    number: "03",
    title: "Useful data visualization",
    problem:
      "Attendance, grades, enrolment, and administrative information required too much time to interpret and manage.",
    decision:
      "Use calendars, status summaries, charts, tables, and reports to make academic information easier to scan.",
    value:
      "Clear visual summaries support faster management and better decisions across the platform.",
    image: ReportsImage,
    imageAlt:
      "CICCC LMS reporting dashboard with charts, statements, tables, and student information",
  },
];

const feedback = [
  {
    quote:
      "Easy and simple. Very clean aesthetic. I liked it, and it was intuitive.",
    person: "Manuel Aguirre",
    context: "Web Development student",
  },
  {
    quote:
      "It is simple with a friendly design. It’s easy to take a look at my grades and attendance.",
    person: "Aika Ueno",
    context: "Digital Marketing student",
  },
  {
    quote: "Easy, simple, and intuitive. I liked the very clean aesthetic.",
    person: "Alana Martins",
    context: "User feedback participant",
  },
  {
    quote: "It’s easy to take a look at my grades and attendance.",
    person: "Daniel Rosales",
    context: "UI/UX Design student",
  },
];
---

<ProjectDetailLayout title="CICCC LMS Case Study — Joy" active="projects">
  <main class="w-full">
    <div class="py-5 sm:py-7">
      <Breadcrumb
        items={[
          { label: "Projects", href: "/projects" },
          { label: "CICCC LMS", href: "/projects/ciccc-lms" },
        ]}
      />
    </div>

    <ProjectDetailHero
      eyebrow="Learning platform redesign"
      title="CICCC LMS"
      description="A redesigned Learning Management System that simplifies navigation, improves communication, and helps students, instructors, and program managers reach important academic information faster."
      imageSrc={CoverImage.src}
      imageAlt="CICCC Learning Management System dashboard and interface screens"
      categories={["UX/UI Design"]}
      role="UX Leader · Team project"
    />

    <div id="overview" class="scroll-mt-8">
      <ProjectOverview
        duration="Team project"
        role="UX Leader"
        responsibilities={[
          "User surveys and stakeholder interviews",
          "Problem definition and information prioritization",
          "Dashboard, notification, and data-visualization concepts",
        ]}
        challenges={[
          "Simplify complex navigation and frequent academic tasks",
          "Improve communication between students, instructors, and managers",
          "Reduce irrelevant information without hiding essential data",
        ]}
        solutions={[
          "Role-relevant, customizable dashboards",
          "A centralized notification system",
          "Clear academic charts, calendars, and reports",
        ]}
      />
    </div>

    <section
      class="grid gap-10 py-14 sm:py-20 lg:grid-cols-[240px_1fr] lg:gap-16"
    >
      <div class="hidden lg:block"><Sidebar /></div>

      <div class="min-w-0 space-y-20 sm:space-y-28">
        <!-- EMPATHIZE -->
        <section id="empathize" class="scroll-mt-8">
          <header class="max-w-4xl">
            <p
              class="text-sm font-semibold uppercase tracking-[0.18em] text-green-dark"
            >
              01 · Empathize
            </p>
            <h2 class="mt-4 text-4xl text-brown-dark sm:text-6xl">
              Different roles, different priorities
            </h2>
            <p class="mt-6 max-w-3xl text-lg leading-relaxed">
              The existing platform served students, instructors, and program
              managers, but each group used it for different reasons. We first
              identified their most important activities, then gathered survey
              and interview feedback about navigation, communication, and the
              information shown on the dashboard.
            </p>
          </header>

          <div class="mt-10 grid gap-5 md:grid-cols-3">
            {
              userGroups.map((group, index) => (
                <article class="border border-brown-dark/15 bg-ivory p-6 sm:p-8">
                  <span class="text-sm font-semibold text-green-dark">
                    0{index + 1}
                  </span>
                  <h3 class="mt-4 text-2xl">{group.title}</h3>
                  <ul class="mt-4 space-y-2 text-sm text-brown-dark/75">
                    {group.needs.map((need) => (
                      <li>• {need}</li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </div>

          <figure class="mt-10 border border-brown-dark/15 bg-ivory p-4 sm:p-6">
            <img
              src={UserAccessImage.src}
              alt="Priority LMS activities for students, instructors, and program managers"
              class="h-auto w-full"
            />
            <figcaption class="mt-4 text-sm leading-relaxed text-brown-dark/75">
              Mapping each role’s priorities provided a foundation for deciding
              which information should be prominent and which could be removed.
            </figcaption>
          </figure>

          <div class="mt-12 space-y-6">
            {
              researchFindings.map((finding) => (
                <article class="grid overflow-hidden border border-brown-dark/15 bg-ivory lg:grid-cols-[0.9fr_1.1fr]">
                  <div class="flex flex-col justify-center p-6 sm:p-8 lg:p-10">
                    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-green-dark">
                      Research finding {finding.number}
                    </p>
                    <h3 class="mt-3 text-2xl sm:text-3xl">{finding.title}</h3>
                    <div class="mt-6 space-y-5 text-sm leading-relaxed sm:text-base">
                      <div>
                        <h4 class="font-semibold text-brown-dark">
                          What users experienced
                        </h4>
                        <p class="mt-1 text-brown-dark/75">{finding.summary}</p>
                      </div>
                      <div class="border-l-4 border-green-dark pl-4">
                        <h4 class="font-semibold text-green-dark">
                          Research evidence
                        </h4>
                        <p class="mt-1 text-brown-dark/75">
                          {finding.evidence}
                        </p>
                      </div>
                    </div>
                  </div>
                  <figure class="flex items-center bg-cream p-4 sm:p-6">
                    <img
                      src={finding.image.src}
                      alt={finding.imageAlt}
                      class="h-auto w-full object-contain"
                      loading="lazy"
                    />
                  </figure>
                </article>
              ))
            }
          </div>
        </section>

        <!-- DEFINE -->
        <section
          id="define"
          class="scroll-mt-8 border-t border-brown-dark/15 pt-12"
        >
          <p
            class="text-sm font-semibold uppercase tracking-[0.18em] text-green-dark"
          >
            02 · Define
          </p>
          <h2 class="mt-4 max-w-4xl text-4xl sm:text-6xl">
            The platform made common academic work harder than necessary
          </h2>
          <p class="mt-6 max-w-3xl text-lg leading-relaxed">
            CICCC students, instructors, and managers faced complex navigation
            and time-consuming task completion. Unnecessary information and weak
            communication increased frustration and affected student
            performance, instructor productivity, and administrative management.
          </p>

          <div
            class="mt-10 grid gap-6 md:grid-cols-[0.9fr_1.1fr] md:items-center"
          >
            <div
              class="border-l-4 border-green-dark bg-green-light/40 p-6 sm:p-8"
            >
              <p
                class="text-xs font-semibold uppercase tracking-[0.18em] text-green-dark"
              >
                Problem statement
              </p>
              <p class="mt-3 text-xl leading-relaxed sm:text-2xl">
                How might we simplify the CICCC LMS so every role can reach
                relevant information, understand updates, and complete routine
                academic tasks with fewer steps?
              </p>
            </div>
            <figure class="border border-brown-dark/15 bg-ivory p-4">
              <img
                src={ProblemImage.src}
                alt="CICCC LMS problem statement and overlapping user pain points"
                class="h-auto w-full"
                loading="lazy"
              />
            </figure>
          </div>
        </section>

        <!-- IDEATE -->
        <section
          id="ideate"
          class="scroll-mt-8 border-t border-brown-dark/15 pt-12"
        >
          <p
            class="text-sm font-semibold uppercase tracking-[0.18em] text-green-dark"
          >
            03 · Ideate
          </p>
          <h2 class="mt-4 text-4xl sm:text-6xl">
            Three connected solution pillars
          </h2>
          <p class="mt-6 max-w-3xl text-lg leading-relaxed">
            The solution aligned each core pain point with one system-level
            improvement: customized information for students, clear
            notifications for instructors, and data visualization for program
            managers—all supported by simplified navigation.
          </p>

          <div class="mt-10 grid gap-5 md:grid-cols-3">
            {
              solutionPillars.map((solution) => (
                <article class="border border-brown-dark/15 bg-ivory p-6 sm:p-8">
                  <span class="text-sm font-semibold text-green-dark">
                    {solution.number}
                  </span>
                  <h3 class="mt-4 text-2xl">{solution.title}</h3>
                  <p class="mt-3 text-sm leading-relaxed text-brown-dark/75">
                    {solution.value}
                  </p>
                </article>
              ))
            }
          </div>

          <figure class="mt-10 border border-brown-dark/15 bg-ivory p-4 sm:p-6">
            <img
              src={CoreSolutionsImage.src}
              alt="Core CICCC LMS solutions mapped across students, instructors, and managers"
              class="h-auto w-full"
              loading="lazy"
            />
          </figure>
        </section>

        <!-- PROTOTYPE -->
        <section
          id="prototype"
          class="scroll-mt-8 border-t border-brown-dark/15 pt-12"
        >
          <p
            class="text-sm font-semibold uppercase tracking-[0.18em] text-green-dark"
          >
            04 · Prototype
          </p>
          <h2 class="mt-4 text-4xl sm:text-6xl">
            Turning the strategy into daily workflows
          </h2>

          <div class="mt-12 space-y-6">
            {
              solutionPillars.map((solution) => (
                <article class="grid overflow-hidden border border-brown-dark/15 bg-ivory lg:grid-cols-[0.85fr_1.15fr]">
                  <div class="flex flex-col justify-center p-6 sm:p-8 lg:p-10">
                    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-green-dark">
                      Solution {solution.number}
                    </p>
                    <h3 class="mt-3 text-2xl sm:text-3xl">{solution.title}</h3>
                    <div class="mt-6 space-y-5 text-sm leading-relaxed sm:text-base">
                      <div>
                        <h4 class="font-semibold text-brown-dark">
                          Problem addressed
                        </h4>
                        <p class="mt-1 text-brown-dark/75">
                          {solution.problem}
                        </p>
                      </div>
                      <div class="border-l-4 border-green-dark pl-4">
                        <h4 class="font-semibold text-green-dark">
                          Design decision
                        </h4>
                        <p class="mt-1 text-brown-dark/75">
                          {solution.decision}
                        </p>
                      </div>
                    </div>
                  </div>
                  <figure class="flex items-center bg-cream p-4 sm:p-6">
                    <img
                      src={solution.image.src}
                      alt={solution.imageAlt}
                      class="h-auto w-full object-contain"
                      loading="lazy"
                    />
                  </figure>
                </article>
              ))
            }
          </div>

          <div class="mt-8 grid gap-5 md:grid-cols-2">
            <figure class="border border-brown-dark/15 bg-ivory p-4 sm:p-6">
              <img
                src={AttendanceImage.src}
                alt="CICCC LMS attendance calendars and attendance report"
                class="h-auto w-full"
                loading="lazy"
              />
              <figcaption class="mt-4 text-sm font-semibold">
                Attendance overview and reporting
              </figcaption>
            </figure>
            <figure class="border border-brown-dark/15 bg-ivory p-4 sm:p-6">
              <img
                src={CoursesImage.src}
                alt="CICCC LMS course, enrolment, grade, and student-detail screens"
                class="h-auto w-full"
                loading="lazy"
              />
              <figcaption class="mt-4 text-sm font-semibold">
                Courses, grades, and student details
              </figcaption>
            </figure>
          </div>
        </section>

        <!-- TEST -->
        <section
          id="test"
          class="scroll-mt-8 border-t border-brown-dark/15 pt-12"
        >
          <p
            class="text-sm font-semibold uppercase tracking-[0.18em] text-green-dark"
          >
            05 · Test
          </p>
          <div
            class="mt-5 grid gap-10 md:grid-cols-[0.8fr_1.2fr] md:items-start"
          >
            <div>
              <strong class="text-8xl text-brown-dark">4</strong>
              <h2 class="mt-3 text-4xl sm:text-5xl">
                users shared feedback on the redesign
              </h2>
              <p class="mt-6">
                Students and other participants responded positively to the
                cleaner interface, simpler navigation, and easier access to
                grades and attendance.
              </p>
            </div>
            <figure class="border border-brown-dark/15 bg-ivory p-4 sm:p-6">
              <img
                src={UserFeedbackImage.src}
                alt="Four user quotations about the CICCC LMS redesign"
                class="h-auto w-full"
                loading="lazy"
              />
            </figure>
          </div>

          <div class="mt-10 grid gap-5 md:grid-cols-2">
            {
              feedback.map((item, index) => (
                <blockquote class="border border-brown-dark/15 bg-ivory p-6 sm:p-8">
                  <span class="text-sm font-semibold text-green-dark">
                    0{index + 1}
                  </span>
                  <p class="mt-4 text-xl leading-relaxed">“{item.quote}”</p>
                  <footer class="mt-5 text-sm text-brown-dark/65">
                    <>
                      <strong class="text-brown-dark">{item.person}</strong>
                      <br />
                    </>
                    {item.context}
                  </footer>
                </blockquote>
              ))
            }
          </div>

          <div
            class="mt-10 grid gap-6 md:grid-cols-[1.1fr_0.9fr] md:items-center"
          >
            <div
              class="border-l-4 border-green-dark bg-green-light/30 p-6 sm:p-8"
            >
              <h3 class="text-2xl">What the feedback validated</h3>
              <p class="mt-3 leading-relaxed text-brown-dark/75">
                Participants consistently described the redesign as simple,
                intuitive, clean, and friendly. They also confirmed that grades
                and attendance were easier to review—directly supporting the
                project’s navigation and information-priority goals.
              </p>
            </div>
            <figure class="border border-brown-dark/15 bg-ivory p-4">
              <img
                src={ConclusionImage.src}
                alt="CICCC LMS pain points, solutions, and positive user feedback summary"
                class="h-auto w-full"
                loading="lazy"
              />
            </figure>
          </div>
        </section>

        <!-- OUTCOME -->
        <section
          id="final-design"
          class="scroll-mt-8 border-t border-brown-dark/15 pt-12"
        >
          <!-- Introduction -->
          <div
            class="grid
      gap-8
      md:grid-cols-[0.85fr_1.15fr]
      md:items-end"
          >
            <div>
              <p
                class="text-sm
          font-semibold
          uppercase
          tracking-[0.18em]
          text-green-dark"
              >
                06 · Final Design
              </p>

              <h2 class="mt-4 text-4xl sm:text-6xl">
                A clearer academic experience for every role
              </h2>
            </div>

            <p class="text-lg leading-relaxed text-brown-dark/75">
              The proposed LMS reduces navigation effort, prioritizes relevant
              information, improves communication, and turns complex academic
              data into useful dashboards and reports.
            </p>
          </div>

          <!-- Role-based prototypes -->
          <div class="mt-12">
            <div class="max-w-3xl">
              <p
                class="text-xs
          font-semibold
          uppercase
          tracking-[0.18em]
          text-green-dark"
              >
                Interactive prototypes
              </p>

              <h3 class="mt-2 text-3xl text-brown-dark">
                Explore the experience for each user role
              </h3>

              <p class="mt-3 leading-relaxed text-brown-dark/70">
                Each prototype prioritizes the information and daily activities
                most relevant to students, instructors, and program managers.
              </p>
            </div>

            <div class="mt-7 grid gap-5 lg:grid-cols-3">
              <!-- Student prototype -->
              <article
                class="flex
          flex-col
          border
          border-brown-dark/15
          bg-ivory
          p-4"
              >
                <div class="mb-4">
                  <p
                    class="text-xs
              font-semibold
              uppercase
              tracking-[0.16em]
              text-green-dark"
                  >
                    Role 01
                  </p>

                  <h4 class="mt-1 text-2xl text-brown-dark">Student</h4>

                  <p class="mt-2 text-sm leading-relaxed text-brown-dark/65">
                    Review courses, assignments, schedules, attendance, and
                    grades.
                  </p>
                </div>

                <div
                  class="relative
            mt-auto
            aspect-[4/3]
            w-full
            overflow-hidden
            bg-cream"
                >
                  <iframe
                    src="https://embed.figma.com/proto/KhZTQkjd8SPhKDvAddvhal/UI-UX-Final-Project?node-id=1034-49540&p=f&viewport=247%2C-160%2C0.04&scaling=scale-down&content-scaling=fixed&starting-point-node-id=1034%3A49540&page-id=1034%3A48139&embed-host=share"
                    title="CICCC LMS student prototype"
                    class="absolute inset-0 h-full w-full border-0"
                    loading="lazy"
                    allowfullscreen></iframe>
                </div>
              </article>

              <!-- Instructor prototype -->
              <article
                class="flex
          flex-col
          border
          border-brown-dark/15
          bg-ivory
          p-4"
              >
                <div class="mb-4">
                  <p
                    class="text-xs
              font-semibold
              uppercase
              tracking-[0.16em]
              text-green-dark"
                  >
                    Role 02
                  </p>

                  <h4 class="mt-1 text-2xl text-brown-dark">Instructor</h4>

                  <p class="mt-2 text-sm leading-relaxed text-brown-dark/65">
                    Manage classes, attendance, grades, materials, and student
                    activity.
                  </p>
                </div>

                <div
                  class="relative
            mt-auto
            aspect-[4/3]
            w-full
            overflow-hidden
            bg-cream"
                >
                  <iframe
                    src="https://embed.figma.com/proto/KhZTQkjd8SPhKDvAddvhal/UI-UX-Final-Project?node-id=1034-37695&p=f&viewport=287%2C22%2C0.03&scaling=min-zoom&content-scaling=fixed&starting-point-node-id=1034%3A37695&page-id=1034%3A35724&embed-host=share"
                    title="CICCC LMS instructor prototype"
                    class="absolute inset-0 h-full w-full border-0"
                    loading="lazy"
                    allowfullscreen></iframe>
                </div>
              </article>

              <!-- Program manager prototype -->
              <article
                class="flex
          flex-col
          border
          border-brown-dark/15
          bg-ivory
          p-4"
              >
                <div class="mb-4">
                  <p
                    class="text-xs
              font-semibold
              uppercase
              tracking-[0.16em]
              text-green-dark"
                  >
                    Role 03
                  </p>

                  <h4 class="mt-1 text-2xl text-brown-dark">Program manager</h4>

                  <p class="mt-2 text-sm leading-relaxed text-brown-dark/65">
                    Monitor student activity, attendance, academic progress, and
                    reports.
                  </p>
                </div>

                <div
                  class="relative
            mt-auto
            aspect-[4/3]
            w-full
            overflow-hidden
            bg-cream"
                >
                  <iframe
                    src="https://embed.figma.com/proto/KhZTQkjd8SPhKDvAddvhal/UI-UX-Final-Project?node-id=1034-58712&p=f&viewport=187%2C-307%2C0.03&scaling=min-zoom&content-scaling=fixed&starting-point-node-id=1034%3A58712&page-id=1034%3A58623&embed-host=share"
                    title="CICCC LMS program manager prototype"
                    class="absolute inset-0 h-full w-full border-0"
                    loading="lazy"
                    allowfullscreen></iframe>
                </div>
              </article>
            </div>
          </div>

          <!-- Next steps -->
          <div
            class="mt-10
      flex
      flex-col
      items-start
      justify-between
      gap-7
      bg-brown-dark
      px-6
      py-10
      text-white
      sm:px-10
      md:flex-row
      md:items-center"
          >
            <div>
              <p
                class="text-sm
          font-semibold
          uppercase
          tracking-[0.18em]
          text-green-light"
              >
                Next steps
              </p>

              <h3 class="mt-3 text-3xl !text-white">
                Test, measure, and expand
              </h3>

              <p class="mt-3 max-w-2xl text-white/70">
                Future work includes beta and A/B testing, collecting user
                feedback and metrics, refining the product, planning for a wider
                audience, and prioritizing future features.
              </p>
            </div>

            <a
              href="/projects"
