---
import ProjectDetailLayout from "../../layouts/ProjectDetailLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ProjectDetailHero from "../../components/ProjectDetailHero.astro";
import ProjectOverview from "../../components/ProjectOverview.astro";

import HeroImage from "../../assets/hero/weather-cover.svg";
import SunnyCat from "../../assets/weather-fore-cat/cats/sunny.png";
import CloudyCat from "../../assets/weather-fore-cat/cats/cloudy.png";
import RainyCat from "../../assets/weather-fore-cat/cats/rainy.png";
import SnowyCat from "../../assets/weather-fore-cat/cats/snowy.png";

const navItems = [
  { number: "01", label: "Project brief", href: "#brief" },
  { number: "02", label: "Experience design", href: "#experience" },
  { number: "03", label: "Visual system", href: "#visual-system" },
  { number: "04", label: "Development", href: "#development" },
  { number: "05", label: "Responsive design", href: "#responsive" },
  { number: "06", label: "Outcome", href: "#outcome" },
];

const coreFeatures = [
  {
    number: "01",
    title: "City search",
    text: "Find locations with autocomplete suggestions and view local weather information.",
  },
  {
    number: "02",
    title: "Current conditions",
    text: "See the current temperature and weather conditions at a glance.",
  },
  {
    number: "03",
    title: "Forecasts",
    text: "Explore a five-day forecast and a more detailed three-hour breakdown.",
  },
  {
    number: "04",
    title: "Favorite cities",
    text: "Save frequently checked locations and return to them from the favorites menu.",
  },
  {
    number: "05",
    title: "Weather details",
    text: "Check additional information such as humidity, wind, UV, sunrise, and sunset.",
  },
  {
    number: "06",
    title: "Dynamic cat mascots",
    text: "Weather conditions are paired with playful cat illustrations and matching visual states.",
  },
];

const designPrinciples = [
  {
    title: "Make information scannable",
    text: "Organize current conditions, daily forecasts, and hourly details into clear sections so users can find the information they need quickly.",
  },
  {
    title: "Give the interface personality",
    text: "Use friendly cat mascots, soft colours, and weather-based backgrounds to make a functional dashboard feel warm and memorable.",
  },
  {
    title: "Keep the experience responsive",
    text: "Adapt the dashboard layout for smaller screens, changing from a multi-column desktop view to a vertically stacked mobile experience.",
  },
];

const developmentSteps = [
  {
    number: "01",
    title: "Fetch weather data",
    text: "Connect to Open-Meteo to retrieve current conditions, daily forecasts, hourly forecasts, and supporting weather details.",
  },
  {
    number: "02",
    title: "Find locations",
    text: "Use PlaceKit autocomplete to help users search for cities and retrieve the coordinates needed for weather requests.",
  },
  {
    number: "03",
    title: "Map the data",
    text: "Convert API responses into structured weather data and map weather codes to the appropriate display and cat state.",
  },
  {
    number: "04",
    title: "Manage saved places",
    text: "Use localStorage to keep favorite cities available between visits, alongside location and recent-search functionality.",
  },
];

const technologies = [
  "Astro",
  "TypeScript",
  "Tailwind CSS",
  "jQuery",
  "Figma",
  "Open-Meteo API",
  "PlaceKit API",
];
---

<ProjectDetailLayout title="Weather Fore-Cat Case Study — Joy" active="projects">
  <main class="w-full">
    <div class="py-5 sm:py-7">
      <Breadcrumb
        items={[
          { label: "Projects", href: "/projects/" },
          { label: "Weather Fore-Cat", href: "/projects/weather-fore-cat/" },
        ]}
      />
    </div>

    <ProjectDetailHero
      eyebrow="UX/UI design & web development case study"
      title="Weather Fore-Cat"
      description="A cat-themed weather dashboard that helps users check current conditions, explore forecasts, and save favorite cities through a friendly, responsive interface."
      imageSrc={HeroImage.src}
      imageAlt="Weather Fore-Cat case study cover showing a playful weather dashboard with cat mascots"
      categories={["UX/UI Design", "Web Development"]}
      duration="Team project · 5-person team"
      role="UX/UI Designer · Web Developer"
      websiteLink="https://weather-forecats.netlify.app/"
    />

    <div id="overview" class="scroll-mt-8">
      <ProjectOverview
        duration="Team project · 5-person team"
        role="UX/UI Designer · Web Developer"
        responsibilities={[
          "Contributed to the user experience and visual design of a weather dashboard",
          "Worked on the frontend implementation using Astro, TypeScript, and Tailwind CSS",
          "Connected interface components with weather data and location-search functionality",
        ]}
        challenges={[
          "Present several types of weather information without overwhelming the user",
          "Make city search, forecasts, and saved locations work together as one experience",
          "Create a distinctive visual identity while keeping the interface practical and responsive",
        ]}
        solutions={[
          "Organized the dashboard into clear sections for current, daily, and hourly weather",
          "Integrated Open-Meteo and PlaceKit to support weather data and city search",
          "Used weather-responsive backgrounds and cat mascots to add personality to the interface",
        ]}
      />
    </div>

    <section class="grid gap-10 py-14 sm:py-20 lg:grid-cols-[220px_1fr] lg:gap-16">
      <aside class="hidden lg:block">
        <div class="sticky top-28">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-sky-700">
            Case study
          </p>
          <nav aria-label="Weather Fore-Cat case-study sections" class="mt-5">
            <ol class="border-y border-slate-300/70">
              {navItems.map((item) => (
                <li class="border-b border-slate-300/70 last:border-b-0">
                  <a
                    href={item.href}
                    class="grid grid-cols-[32px_1fr] gap-3 py-3 text-sm text-slate-600 transition hover:text-sky-700"
                  >
                    <span class="font-semibold text-sky-700">{item.number}</span>
                    <span>{item.label}</span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        </div>
      </aside>

      <div class="min-w-0 space-y-20">
        <section id="brief" class="scroll-mt-8">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-sky-700">
            01 · Project brief
          </p>
          <h2 class="mt-4 text-4xl text-slate-900 sm:text-6xl">
            A forecast with a little more personality.
          </h2>
          <p class="mt-6 max-w-3xl text-lg leading-relaxed text-slate-600">
            Weather Fore-Cat brings everyday weather information into a playful
            dashboard. Instead of presenting data as a plain utility, the
            experience pairs useful forecasts with cat characters that respond
            to different weather conditions.
          </p>

          <div class="mt-10 grid gap-4 sm:grid-cols-2">
            <div class="rounded-3xl bg-sky-50 p-6">
              <p class="text-sm font-semibold uppercase tracking-wide text-sky-800">
                The goal
              </p>
              <h3 class="mt-3 text-2xl font-semibold text-slate-900">
                Useful at a glance
              </h3>
              <p class="mt-3 leading-relaxed text-slate-600">
                Help users check the weather quickly, understand upcoming
                conditions, and revisit the cities they care about.
              </p>
            </div>
            <div class="rounded-3xl bg-orange-50 p-6">
              <p class="text-sm font-semibold uppercase tracking-wide text-orange-800">
                The design direction
              </p>
              <h3 class="mt-3 text-2xl font-semibold text-slate-900">
                Functional, friendly, and fun
              </h3>
              <p class="mt-3 leading-relaxed text-slate-600">
                Combine a clear information hierarchy with soft colours,
                approachable illustrations, and weather-inspired visual states.
              </p>
            </div>
          </div>

          <h3 class="mt-12 text-2xl font-semibold text-slate-900">
            Core experience
          </h3>
          <div class="mt-5 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
            {coreFeatures.map((feature) => (
              <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <p class="text-sm font-semibold text-sky-700">{feature.number}</p>
                <h4 class="mt-3 text-xl font-semibold text-slate-900">{feature.title}</h4>
                <p class="mt-2 leading-relaxed text-slate-600">{feature.text}</p>
              </article>
            ))}
          </div>
        </section>

        <section id="experience" class="scroll-mt-8">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-sky-700">
            02 · Experience design
          </p>
          <h2 class="mt-4 text-4xl text-slate-900 sm:text-6xl">
            Weather information, made easier to explore.
          </h2>
          <p class="mt-6 max-w-3xl text-lg leading-relaxed text-slate-600">
            The dashboard brings the most immediate information forward, then
            lets users explore more detail as needed. Search and favorites make
            changing locations straightforward, while forecast cards connect
            the daily and hourly views.
          </p>

          <div class="mt-10 grid gap-5 md:grid-cols-3">
            {designPrinciples.map((item, index) => (
              <article class="rounded-3xl bg-slate-50 p-6">
                <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-sky-100 font-semibold text-sky-800">
                  0{index + 1}
                </span>
                <h3 class="mt-5 text-xl font-semibold text-slate-900">{item.title}</h3>
                <p class="mt-3 leading-relaxed text-slate-600">{item.text}</p>
              </article>
            ))}
          </div>
        </section>

        <section id="visual-system" class="scroll-mt-8">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-sky-700">
            03 · Visual system
          </p>
          <h2 class="mt-4 text-4xl text-slate-900 sm:text-6xl">
            Four cats. Four kinds of weather.
          </h2>
          <p class="mt-6 max-w-3xl text-lg leading-relaxed text-slate-600">
            The cat mascots are part of the product experience, not just
            decoration. Each character gives the dashboard a recognizable
            weather state and helps make changing conditions feel more
            expressive.
          </p>

          <div class="mt-10 grid grid-cols-2 gap-4 lg:grid-cols-4">
            <figure class="rounded-3xl bg-amber-50 p-4 text-center">
              <img src={SunnyCat.src} alt="Sunny cat mascot" class="mx-auto aspect-square w-full object-contain" loading="lazy" />
              <figcaption class="mt-3 font-semibold text-slate-800">Sunny</figcaption>
              <p class="mt-1 text-sm text-slate-600">Clear skies</p>
            </figure>
            <figure class="rounded-3xl bg-slate-100 p-4 text-center">
              <img src={CloudyCat.src} alt="Cloudy cat mascot" class="mx-auto aspect-square w-full object-contain" loading="lazy" />
              <figcaption class="mt-3 font-semibold text-slate-800">Cloudy</figcaption>
              <p class="mt-1 text-sm text-slate-600">Overcast days</p>
            </figure>
            <figure class="rounded-3xl bg-blue-50 p-4 text-center">
              <img src={RainyCat.src} alt="Rainy cat mascot" class="mx-auto aspect-square w-full object-contain" loading="lazy" />
              <figcaption class="mt-3 font-semibold text-slate-800">Rainy</figcaption>
              <p class="mt-1 text-sm text-slate-600">Rainy weather</p>
            </figure>
            <figure class="rounded-3xl bg-indigo-50 p-4 text-center">
              <img src={SnowyCat.src} alt="Snowy cat mascot" class="mx-auto aspect-square w-full object-contain" loading="lazy" />
              <figcaption class="mt-3 font-semibold text-slate-800">Snowy</figcaption>
              <p class="mt-1 text-sm text-slate-600">Snow conditions</p>
            </figure>
          </div>

          <div class="mt-8 rounded-3xl bg-sky-50 p-6 sm:p-8">
            <h3 class="text-2xl font-semibold text-slate-900">
              A visual language that changes with the forecast
            </h3>
            <p class="mt-3 max-w-3xl leading-relaxed text-slate-600">
              Weather illustrations, background variations, and supporting
              icons work together to make the current condition recognizable
              while keeping the information cards readable.
            </p>
          </div>
        </section>

        <section id="development" class="scroll-mt-8">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-sky-700">
            04 · Development
          </p>
          <h2 class="mt-4 text-4xl text-slate-900 sm:text-6xl">
            Turning the interface into a working weather app.
          </h2>
          <p class="mt-6 max-w-3xl text-lg leading-relaxed text-slate-600">
            The application uses Astro for its component structure, TypeScript
            for typed data, and Tailwind CSS for styling. API and browser
            functionality connect the interface to live weather information
            and location search.
          </p>

          <div class="mt-10 space-y-4">
            {developmentSteps.map((step) => (
              <article class="grid gap-3 rounded-2xl border border-slate-200 p-5 sm:grid-cols-[64px_1fr] sm:gap-6">
                <span class="text-2xl font-semibold text-sky-700">{step.number}</span>
                <div>
                  <h3 class="text-xl font-semibold text-slate-900">{step.title}</h3>
                  <p class="mt-2 leading-relaxed text-slate-600">{step.text}</p>
                </div>
              </article>
            ))}
          </div>

          <div class="mt-10 rounded-3xl bg-slate-900 p-6 text-white sm:p-8">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-sky-300">
              Technology stack
            </p>
            <div class="mt-5 flex flex-wrap gap-2">
              {technologies.map((technology) => (
                <span class="rounded-full border border-white/20 bg-white/10 px-4 py-2 text-sm text-white">
                  {technology}
                </span>
              ))}
            </div>
          </div>
        </section>

        <section id="responsive" class="scroll-mt-8">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-sky-700">
            05 · Responsive design
          </p>
          <h2 class="mt-4 text-4xl text-slate-900 sm:text-6xl">
            Designed to work across screen sizes.
          </h2>
          <p class="mt-6 max-w-3xl text-lg leading-relaxed text-slate-600">
            The desktop dashboard uses a multi-column layout to keep several
            weather modules visible together. On smaller screens, the content
            shifts into a vertical flow, with forecast cards and hourly details
            adapted to fit the available space.
          </p>
          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            <div class="rounded-3xl border border-slate-200 p-6">
              <h3 class="text-xl font-semibold text-slate-900">Desktop</h3>
              <p class="mt-2 leading-relaxed text-slate-600">
                A multi-column dashboard for viewing current conditions,
                forecasts, saved cities, and hourly details together.
              </p>
            </div>
            <div class="rounded-3xl border border-slate-200 p-6">
              <h3 class="text-xl font-semibold text-slate-900">Mobile</h3>
              <p class="mt-2 leading-relaxed text-slate-600">
                A stacked layout with compact spacing and horizontally
                scrollable forecast content for smaller screens.
              </p>
            </div>
          </div>
        </section>

        <section id="outcome" class="scroll-mt-8">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-sky-700">
            06 · Outcome
          </p>
          <div class="overflow-hidden rounded-[2rem] bg-sky-700 p-7 text-white sm:p-12">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-sky-100">
              The result
            </p>
            <h2 class="mt-4 max-w-3xl text-4xl sm:text-5xl">
              A weather dashboard that feels as friendly as it is useful.
            </h2>
            <p class="mt-6 max-w-3xl text-lg leading-relaxed text-sky-50">
              Weather Fore-Cat brings weather data, location search, saved
              cities, and forecast details into one responsive experience.
              Combining UX/UI design with frontend development helped turn the
              visual concept into a functional web application.
            </p>
            <a
              href="https://weather-forecats.netlify.app/"
              target="_blank"
              rel="noreferrer"
              class="mt-8 inline-flex items-center rounded-full bg-white px-6 py-3 font-semibold text-sky-800 transition hover:bg-sky-50"
            >
              Visit live website <span class="ml-2" aria-hidden="true">↗</span>
            </a>
          </div>
        </section>
      </div>
    </section>
  </main>
</ProjectDetailLayout>
